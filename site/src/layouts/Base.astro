---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  keywords?: string[];
  image?: string;
  imageAlt?: string;
  section?: string;
  progress?: boolean;
}
const { progress = false, section, ...seo } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Index' },
  { href: '/projects/', label: 'Projects' },
  { href: '/news/', label: 'Archive' },
  { href: '/about/', label: 'About' },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <SEO {...seo} />
    <script is:inline>
      // Set the theme before first paint so there is no flash.
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {progress && <div id="reading-progress"></div>}

    <div class="shell">
      <aside class="rail fade-up">
        <a class="rail__home" href="/" aria-label="Back to index">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
        </a>
        <span class="vertical">Wabi Sabi</span>
        <span class="vertical vertical--foot">{section ?? 'Applied AI'}</span>
      </aside>

      <main id="main">
        <nav class="topnav fade-up d1" aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href="/rss.xml" class="topnav__spacer">RSS</a>
          <button class="themetoggle" id="themetoggle" type="button" aria-label="Switch theme">
            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </nav>

        <slot />

        <footer>
          <span>&copy; {year} Janmejai Singh Minhas</span>
          <span>
            <a href="https://github.com/janmejai2002" rel="me noopener">GitHub</a>
            &nbsp;·&nbsp;
            <a href="https://linkedin.com/in/janmejai" rel="me noopener">LinkedIn</a>
            &nbsp;·&nbsp;
            <a href="/rss.xml">RSS</a>
          </span>
        </footer>
      </main>
    </div>

    <script>
      const bar = document.getElementById('reading-progress');
      if (bar) {
        const onScroll = () => {
          const el = document.documentElement;
          const max = el.scrollHeight - el.clientHeight;
          bar.style.width = max > 0 ? `${(el.scrollTop / max) * 100}%` : '0%';
        };
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // The nav grows taller on mobile (bigger touch targets), so anything
      // sticky below it must track the real height, not a hardcoded rem value.
      const navEl = document.querySelector('.topnav');
      if (navEl) {
        const setNavH = () => {
          document.documentElement.style.setProperty(
            '--nav-h',
            `${Math.round(navEl.getBoundingClientRect().height)}px`
          );
        };
        setNavH();
        if ('ResizeObserver' in window) new ResizeObserver(setNavH).observe(navEl);
        addEventListener('resize', setNavH, { passive: true });
      }

      const toggle = document.getElementById('themetoggle');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const current = root.dataset.theme ?? (systemDark ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });

      const targets = document.querySelectorAll('.scroll-reveal');
      if (targets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('revealed');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15 }
        );
        targets.forEach((t) => io.observe(t));
      }
    </script>
  </body>
</html>
