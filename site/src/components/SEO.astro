---
import { GOOGLE_SITE_VERIFICATION, BING_SITE_VERIFICATION, UMAMI_WEBSITE_ID } from '../seo';

export interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  keywords?: string[];
  /** Path or already-absolute URL of the social card. Falls back site-wide. */
  image?: string;
  imageAlt?: string;
  /** The article's own title, without the site suffix that <title> may carry. */
  headline?: string;
  articleSection?: string;
  wordCount?: number;
  alternativeHeadline?: string;
  breadcrumbs?: { name: string; path?: string }[];
  noindex?: boolean;
  pageType?: string;
  /** Extra schema.org properties merged into the page's WebPage node. */
  schema?: Record<string, unknown>;
}
const {
  title,
  description,
  type = 'website',
  pubDate,
  updatedDate,
  keywords = [],
  image,
  imageAlt,
  headline,
  articleSection,
  wordCount,
  alternativeHeadline,
  breadcrumbs,
  noindex = false,
  pageType = 'WebPage',
  schema: pageSchema = {},
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Crawlers will not resolve a relative og:image, so everything is absolutised
// against `site`. The default card exists so `summary_large_image` is never a
// promise the page cannot keep.
const ogImage = new URL(image ?? '/og-default.png', Astro.site).href;
const ogImageAlt = imageAlt ?? 'wAIbi-sabi — applied AI notes by Janmejai Singh Minhas';
const siteName = 'wAIbi-sabi';
const personId = new URL('/#person', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const isHome = Astro.url.pathname === '/';
const socialTitle = headline ?? title;

const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Janmejai Singh Minhas',
  url: new URL('/about/', Astro.site).href,
  description:
    'Applied AI practitioner working on computer vision, frontier-model red teaming and credit risk modelling.',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Panjab University' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'XLRI' },
  knowsAbout: [
    'Machine Learning',
    'Computer Vision',
    'Deep Learning',
    'Applied AI',
    'MLOps',
    'AI Red Teaming',
    'Credit Risk Modelling',
  ],
  sameAs: ['https://linkedin.com/in/janmejai', 'https://github.com/janmejai2002'],
};

const breadcrumbNode = breadcrumbs?.length
  ? [
      {
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          ...(b.path ? { item: new URL(b.path, Astro.site).href } : {}),
        })),
      },
    ]
  : [];

const graph =
  type === 'article'
    ? [
        person,
        ...breadcrumbNode,
        {
          '@type': 'BlogPosting',
          headline: socialTitle,
          ...(alternativeHeadline ? { alternativeHeadline } : {}),
          ...(articleSection ? { articleSection } : {}),
          ...(wordCount ? { wordCount } : {}),
          inLanguage: 'en-IN',
          isPartOf: { '@id': websiteId },
          url: canonical,
          description,
          datePublished: pubDate?.toISOString(),
          dateModified: (updatedDate ?? pubDate)?.toISOString(),
          author: { '@id': personId },
          publisher: { '@id': personId },
          image: ogImage,
          mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
          ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
        },
      ]
    : isHome
      ? [
          person,
          {
            '@type': 'WebSite',
            '@id': websiteId,
            name: siteName,
            url: Astro.site?.href,
            inLanguage: 'en-IN',
            author: { '@id': personId },
            publisher: { '@id': personId },
          },
        ]
      : [
          person,
          ...breadcrumbNode,
          {
            '@type': pageType,
            '@id': canonical,
            url: canonical,
            name: socialTitle,
            description,
            isPartOf: { '@id': websiteId },
            ...pageSchema,
          },
        ];

const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content="Janmejai Singh Minhas" />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

{/* Search-engine ownership verification. Set the token in site/src/seo.ts.
    A github.io subdomain cannot use a Search Console *domain* property — that
    needs DNS records nobody here controls — so it is verified as a URL-prefix
    property, and the meta-tag method is the one that survives a rebuild. */}
{GOOGLE_SITE_VERIFICATION && (
  <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
)}
{BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />}

<meta property="og:type" content={type} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_IN" />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{/* ?v=2: the kintsugi mark replaced the ensō on 2026-08-26, and browsers
    cache favicons far past normal asset rules — the query forces the refetch.
    Bump it only when the mark itself changes. */}
<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
<link rel="alternate icon" href="/favicon.ico?v=2" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={siteName} href={new URL('rss.xml', Astro.site)} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{/* Newsreader carries exactly one glyph per article — the drop cap — plus
    nothing else yet, so only the 500 weight ships. */}
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,500&display=swap"
  rel="stylesheet"
/>

{/* Umami Cloud: cookieless page counts and referrers, nothing personal, and a
    read API the topic feedback loop can query. Production only, and only once
    a website ID exists — see src/seo.ts for the fill-in steps. */}
{import.meta.env.PROD && UMAMI_WEBSITE_ID && (
  <script defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_WEBSITE_ID} />
)}

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
