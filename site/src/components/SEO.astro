---
import { GOOGLE_SITE_VERIFICATION, BING_SITE_VERIFICATION, UMAMI_WEBSITE_ID, CLARITY_PROJECT_ID } from '../seo';
import { cardFor, findCard } from '../data/share';

export interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  keywords?: string[];
  /** Path or already-absolute URL of the social card. Falls back site-wide. */
  image?: string;
  /** Key of a page card in src/data/share.ts; its headline becomes the social title. */
  card?: string;
  imageAlt?: string;
  /** The article's own title, without the site suffix that <title> may carry. */
  headline?: string;
  articleSection?: string;
  /** "9 min read" — shown as a label in Slack, Discord and other unfurls. */
  readingTime?: string;
  wordCount?: number;
  alternativeHeadline?: string;
  breadcrumbs?: { name: string; path?: string }[];
  noindex?: boolean;
  pageType?: string;
  /** Extra schema.org properties merged into the page's WebPage node. */
  schema?: Record<string, unknown>;
  faq?: { question: string; answer: string }[];
}
const {
  title,
  description,
  type = 'website',
  pubDate,
  updatedDate,
  keywords = [],
  image: imageProp,
  imageAlt: imageAltProp,
  card,
  headline,
  articleSection,
  readingTime,
  wordCount,
  alternativeHeadline,
  breadcrumbs,
  noindex = false,
  pageType = 'WebPage',
  schema: pageSchema = {},
  faq = [],
} = Astro.props;

const shareCard = card ? await findCard(card) : undefined;
if (card && !shareCard) throw new Error(`SEO: no share card "${card}" in src/data/share.ts`);
const image = imageProp ?? (card ? cardFor(card) : undefined);
const imageAlt = imageAltProp ?? (shareCard ? [shareCard.title, shareCard.hook].filter(Boolean).join(' — ') : undefined);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Crawlers will not resolve a relative og:image, so everything is absolutised
// against `site`. The default card exists so `summary_large_image` is never a
// promise the page cannot keep. Cards are generated (src/data/share.ts).
const ogImage = new URL(image ?? cardFor('default'), Astro.site).href;
const ogImagePath = new URL(ogImage).pathname.toLowerCase();
const ogImageType = ogImagePath.endsWith('.webp')
  ? 'image/webp'
  : ogImagePath.endsWith('.jpg') || ogImagePath.endsWith('.jpeg')
    ? 'image/jpeg'
    : 'image/png';
const siteName = 'wAIbi-sabi';
const origin = Astro.site ? new URL(Astro.site).origin : 'https://janmejai2002.github.io';
const personId = `${origin}/#person`;
const orgId = `${origin}/#org`;
const websiteId = `${origin}/#website`;
const isHome = Astro.url.pathname === '/';
const isNewsRoute = Astro.url.pathname === '/news' || Astro.url.pathname.startsWith('/news/');
const inLanguage = isNewsRoute ? 'en-IN' : 'en';
const ogLocale = isNewsRoute ? 'en_IN' : 'en_US';
// og:site_name already says wAIbi-sabi under every card, so the suffix <title>
// carries for search results is noise in a feed.
const socialTitle = headline ?? shareCard?.title ?? (title.replace(/\s+[—|–-]\s+wAIbi-sabi$/, '') || title);
const ogImageAlt =
  imageAlt ?? (image ? socialTitle : 'wAIbi-sabi: applied AI, written while it is still wrong. By Janmejai Singh Minhas.');

const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Janmejai Singh Minhas',
  url: new URL('/about/', Astro.site).href,
  description:
    'Applied AI practitioner working on computer vision, frontier-model red teaming and credit risk modelling.',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Panjab University' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'XLRI' },
  knowsAbout: [
    'Machine Learning',
    'Computer Vision',
    'Deep Learning',
    'Applied AI',
    'MLOps',
    'AI Red Teaming',
    'Credit Risk Modelling',
  ],
  sameAs: ['https://linkedin.com/in/janmejai', 'https://github.com/janmejai2002'],
};

const organization = {
  '@type': 'Organization',
  '@id': orgId,
  name: siteName,
  url: origin,
  founder: { '@id': personId },
  logo: {
    '@type': 'ImageObject',
    url: new URL('/apple-touch-icon.png', Astro.site).href,
    width: 180,
    height: 180,
  },
};

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: siteName,
  url: Astro.site?.href ?? origin,
  inLanguage,
  author: { '@id': personId },
  publisher: { '@id': orgId },
};

const breadcrumbNode = breadcrumbs?.length
  ? [
      {
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          ...(b.path ? { item: new URL(b.path, Astro.site).href } : {}),
        })),
      },
    ]
  : [];

const faqNode = faq.length
  ? [
      {
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: f.answer,
          },
        })),
      },
    ]
  : [];

const graph =
  type === 'article'
    ? [
        person,
        organization,
        website,
        ...breadcrumbNode,
        ...faqNode,
        {
          '@type': 'BlogPosting',
          headline: socialTitle,
          ...(alternativeHeadline ? { alternativeHeadline } : {}),
          ...(articleSection ? { articleSection } : {}),
          ...(wordCount ? { wordCount } : {}),
          inLanguage,
          isPartOf: { '@id': websiteId },
          url: canonical,
          description,
          datePublished: pubDate?.toISOString(),
          dateModified: (updatedDate ?? pubDate)?.toISOString(),
          author: { '@id': personId },
          publisher: { '@id': orgId },
          image: ogImage,
          mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
          ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
        },
      ]
    : isHome
      ? [person, organization, website]
      : [
          person,
          organization,
          website,
          ...breadcrumbNode,
          ...faqNode,
          {
            '@type': pageType,
            '@id': canonical,
            url: canonical,
            name: socialTitle,
            description,
            inLanguage,
            isPartOf: { '@id': websiteId },
            ...pageSchema,
          },
        ];

const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content="Janmejai Singh Minhas" />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

{/* Search-engine ownership verification. Set the token in site/src/seo.ts.
    A github.io subdomain cannot use a Search Console *domain* property — that
    needs DNS records nobody here controls — so it is verified as a URL-prefix
    property, and the meta-tag method is the one that survives a rebuild. */}
{GOOGLE_SITE_VERIFICATION && (
  <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
)}
{BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />}

<meta property="og:type" content={type} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{type === 'article' && <meta property="article:author" content={new URL('/about/', Astro.site).href} />}
{type === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
{type === 'article' && keywords.slice(0, 6).map((k) => <meta property="article:tag" content={k} />)}

<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
{/* Slack, Discord and a few others print these two pairs under the unfurl. */}
{readingTime && <meta name="twitter:label1" content="Reading time" />}
{readingTime && <meta name="twitter:data1" content={readingTime} />}
{type === 'article' && articleSection && <meta name="twitter:label2" content="Filed under" />}
{type === 'article' && articleSection && <meta name="twitter:data2" content={articleSection} />}

{/* ?v=2: the kintsugi mark replaced the ensō on 2026-08-26, and browsers
    cache favicons far past normal asset rules — the query forces the refetch.
    Bump it only when the mark itself changes. */}
<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
<link rel="alternate icon" href="/favicon.ico?v=2" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={siteName} href={new URL('rss.xml', Astro.site)} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{/* Newsreader sets all article prose, so it needs its italic and the range of
    weights from body text up to bold. */}
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&display=swap"
  rel="stylesheet"
/>

{/* Umami Cloud: cookieless page counts and referrers, nothing personal, and a
    read API the topic feedback loop can query. Production only, and only once
    a website ID exists — see src/seo.ts for the fill-in steps. */}
{import.meta.env.PROD && UMAMI_WEBSITE_ID && (
  <script defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_WEBSITE_ID} />
)}

{/* Microsoft Clarity tracking (session recording & heatmaps) via Bing Webmaster Tools */}
{import.meta.env.PROD && CLARITY_PROJECT_ID && (
  <script is:inline define:vars={{ clarityId: CLARITY_PROJECT_ID }}>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", clarityId);
  </script>
)}

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
