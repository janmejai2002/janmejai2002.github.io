---
import Crew from './Crew.astro';
import DomainMark from './DomainMark.astro';

export type NewsItem = {
  headline: string;
  date: string;
  category: string;
  summary: string;
  angle: string;
  source: string | null;
};

interface Props {
  items: NewsItem[];
  totalCount?: number;
  isLeadDay?: boolean;
  initialCat?: string;
}

const { items, totalCount, isLeadDay = true, initialCat = 'all' } = Astro.props;

const CATEGORY_META: Record<string, { accent: string; blurb: string }> = {
  Consulting: { accent: 'hanko', blurb: 'Frameworks and client problems' },
  Finance: { accent: 'ochre', blurb: 'Markets, deals and numbers' },
  Marketing: { accent: 'mizu', blurb: 'Brands, pricing and consumers' },
  Operations: { accent: 'moss', blurb: 'Supply chains and unit economics' },
  'Product Management': { accent: 'plum', blurb: 'Users, metrics and trade-offs' },
};

const categories = Object.keys(CATEGORY_META);
const counts = Object.fromEntries(
  categories.map((c) => [c, items.filter((i) => i.category === c).length])
);

const byDate = items.reduce<Record<string, NewsItem[]>>((acc, i) => {
  (acc[i.date] ??= []).push(i);
  return acc;
}, {});
const dates = Object.keys(byDate).sort((a, b) => b.localeCompare(a));

const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-IN', {
    day: 'numeric',
    month: 'short',
    timeZone: 'UTC',
  });

const fmtDay = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-IN', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
  });

const host = (url: string | null) => {
  if (!url) return null;
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return null;
  }
};
---

<div class="news-browser" data-browser data-initial-cat={initialCat}>
  {/* 1. Function Doors matching Homepage segmented panel */}
  <div class="doors" role="group" aria-label="Filter by functional domain">
    <button
      type="button"
      class="door door--all"
      data-door="all"
      data-label="All Tracks"
      data-blurb="Everything, newest first"
      aria-pressed={initialCat === 'all' ? 'true' : 'false'}
      style="--accent:var(--ink);--tint:var(--paper-2)"
    >
      <span class="door__mark"><DomainMark domain="all" /></span>
      <span class="door__label">All Tracks<span class="door__n">{totalCount ?? items.length}</span></span>
      <span class="door__ask">Everything, chronological stream</span>
    </button>

    {
      categories.map((c) => {
        const meta = CATEGORY_META[c];
        const isSelected = initialCat === c;
        return (
          <button
            type="button"
            class="door"
            data-door={c}
            data-label={c}
            data-blurb={meta.blurb}
            aria-pressed={isSelected ? 'true' : 'false'}
            style={`--accent:var(--${meta.accent});--tint:var(--wash-${meta.accent})`}
          >
            <span class="door__mark"><DomainMark domain={c as any} /></span>
            <span class="door__label">{c}<span class="door__n">{counts[c] ?? 0}</span></span>
            <span class="door__ask">{meta.blurb}</span>
          </button>
        );
      })
    }
  </div>

  {/* 2. Modern Sticky Toolbar with 3D Flip All & Practice Mode */}
  <div class="toolbar" role="region" aria-label="Filter and search briefings">
    <div class="toolbar__row">
      <div class="toolbar__search">
        <label for="news-q" class="sr-only">Search stories</label>
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" />
        </svg>
        <input
          type="search"
          id="news-q"
          placeholder="Search 618+ briefings by company, metric, or question…"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="search-kbd" aria-hidden="true">/</kbd>
      </div>

      <div class="toolbar__sort">
        <label for="news-sort" class="sr-only">Sort by</label>
        <select id="news-sort">
          <option value="new">Newest first</option>
          <option value="old">Oldest first</option>
          <option value="az">Headline A–Z</option>
        </select>
      </div>

      <div class="toolbar__actions">
        <button type="button" class="test-toggle" id="flip-all-btn" title="Shatter cards into interview hot seat mode">
          <span class="test-toggle__dot" aria-hidden="true"></span>
          <span class="test-toggle__text">Shatter all: Hot Seat mode</span>
        </button>
        <span class="practised-tally" id="practised-tally" hidden></span>
      </div>
    </div>
  </div>

  {/* 3. Balanced Editorial Days & 3D Interactive Card Grid */}
  <div class="days-stream" id="news-archive">
    {
      dates.map((d, dayIdx) => (
        <section class="day-section" data-date={d}>
          {/* Natural Editorial Dateline Header */}
          <header class="day-head">
            <div class="day-head__dateline">
              <span class="day-head__dot" aria-hidden="true"></span>
              <h2 class="day-head__title">
                <time datetime={d}>{fmtDay(d)}</time>
              </h2>
              <span class="day-head__count">{byDate[d].length} {byDate[d].length === 1 ? 'briefing' : 'briefings'}</span>
            </div>
            <div class="day-head__seam" aria-hidden="true"></div>
          </header>

          {/* Balanced 2-Column Responsive 3D Card Grid */}
          <div class="briefings-grid">
            {byDate[d].map((i, cardIdx) => {
              const isLead = isLeadDay && dayIdx === 0 && cardIdx === 0;
              const meta = CATEGORY_META[i.category] ?? { accent: 'ink', blurb: '' };
              const storyId = `${i.date}:${i.headline}`;
              return (
                <div
                  class:list={['card-scene', isLead && 'card-scene--lead']}
                  data-cat={i.category}
                  data-date={i.date}
                  data-headline={i.headline.toLowerCase()}
                  data-id={storyId}
                >
                  <article
                    class="card"
                    tabindex="0"
                    role="button"
                    aria-expanded="false"
                    aria-label={`${i.headline}. Click to shatter card and reveal the interviewer's cross-examination angle.`}
                    style={`--accent:var(--${meta.accent});--tint:var(--wash-${meta.accent})`}
                    itemscope
                    itemtype="https://schema.org/NewsArticle"
                  >
                    {/* The Pixel Shatter Glitch Matrix (16 Fracturing Kintsugi Shards) */}
                    <div class="card__shatter-matrix" aria-hidden="true">
                      {Array.from({ length: 16 }).map((_, idx) => {
                        const row = Math.floor(idx / 4);
                        const col = idx % 4;
                        return <span class="shatter-pixel" style={`--r:${row};--c:${col};--idx:${idx}`} />;
                      })}
                    </div>

                    <div class="card__stage">

                      {/* FRONT FACE: The Factual Grounding (Story Brief) */}
                      <div class="card__face card__face--front">
                        {/* Card Meta Row */}
                        <div class="card__meta">
                          <span class="card__cat" itemprop="articleSection">
                            <span class="card__dot" aria-hidden="true" />
                            {i.category}
                          </span>
                          <span class="card__sep" aria-hidden="true">·</span>
                          <time class="card__date" datetime={i.date} itemprop="datePublished">{fmtDate(i.date)}</time>
                          <span class="q__flag" data-flag hidden>
                            <svg class="flag-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M3 8.5l3.5 3.5 6.5-7" />
                            </svg>
                            Practised
                          </span>
                          {i.source && host(i.source) && (
                            <span class="card__host" title={`Reported via ${host(i.source)}`}>
                              {host(i.source)}
                            </span>
                          )}
                        </div>

                        {/* Headline */}
                        <h3 class="card__h" itemprop="headline">{i.headline}</h3>

                        {/* Complete Factual Development (No Truncation) */}
                        <div class="card__brief" itemprop="articleBody">
                          <p class="card__sum">{i.summary}</p>
                        </div>

                        {/* Front Footer: Source on left, Pixel Shatter Trigger on right */}
                        <footer class="card__front-foot">
                          {i.source ? (
                            <a class="card__src" href={i.source} target="_blank" rel="noopener noreferrer">
                              <span>{host(i.source)}</span>
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M7 17L17 7M17 7H8M17 7v9" />
                              </svg>
                            </a>
                          ) : <span />}

                          <button
                            type="button"
                            class="flip-btn flip-btn--to-back"
                            aria-label="Shatter card to reveal interviewer's angle"
                            title="Shatter card to reveal interviewer's angle"
                          >
                            <span class="flip-btn__pulse" aria-hidden="true" />
                            <span class="flip-btn__label">Reveal Hot Seat</span>
                            <svg class="flip-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                            </svg>
                          </button>
                        </footer>
                      </div>

                      {/* BACK FACE: The Interview Hot Seat (The Cross-Examination) */}
                      <div class="card__face card__face--back">
                        {/* Domain Mark Watermark */}
                        <div class="back__watermark" aria-hidden="true">
                          <DomainMark domain={i.category as any} />
                        </div>

                        {/* Gold Kintsugi Edge Seam */}
                        <div class="back__seam" aria-hidden="true">
                          <svg viewBox="0 0 320 8" preserveAspectRatio="none">
                            <polyline points="0,4 45,2 95,6 150,1 210,7 265,3 320,5" />
                          </svg>
                        </div>

                        {/* Back Header: Hot Seat Badge + Flip Back to Story */}
                        <div class="back__head">
                          <div class="back__badge">
                            <span class="back__dot" aria-hidden="true" />
                            <span class="back__badge-txt">THE INTERVIEW CHAIR · CROSS-EXAMINATION</span>
                          </div>
                          <button
                            type="button"
                            class="flip-btn flip-btn--to-front"
                            aria-label="Shatter back to story briefing"
                            title="Return to story"
                          >
                            <svg class="flip-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M11 22l10-12h-9l1-8-10 12h9l-1 8z" />
                            </svg>
                            <span class="flip-btn__label">Story</span>
                          </button>
                        </div>

                        {/* Context line */}
                        <div class="back__context">
                          <span class="back__domain-tag">{i.category} Panel</span>
                          <span class="back__sep" aria-hidden="true">·</span>
                          <span class="back__prompt">In WAT/GD/PI, they will push on:</span>
                        </div>

                        {/* The Angle in Newsreader Serif */}
                        <div class="back__body">
                          <p class="back__angle">{i.angle}</p>
                        </div>

                        {/* Back Footer Actions */}
                        <footer class="back__foot">
                          <div class="back__actions">
                            <button
                              type="button"
                              class="copy-angle-btn"
                              data-copy={i.angle}
                              title="Copy question for prep notes"
                              aria-label="Copy interview question"
                            >
                              <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                              </svg>
                              <span class="copy-label">Copy Angle</span>
                            </button>

                            <button
                              type="button"
                              class="practise-btn"
                              data-id={storyId}
                              title="Toggle practised status"
                              aria-label="Mark story as practised"
                            >
                              <svg class="practise-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 8.5l3.5 3.5 6.5-7" />
                              </svg>
                              <span class="practise-txt">Mark Practised</span>
                            </button>
                          </div>

                          {i.source && (
                            <a class="card__src" href={i.source} target="_blank" rel="noopener noreferrer">
                              <span>{host(i.source)}</span>
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M7 17L17 7M17 7H8M17 7v9" />
                              </svg>
                            </a>
                          )}
                        </footer>
                      </div>

                    </div>
                  </article>
                </div>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>

  {/* 4. Thoughtful Wabi-Sabi Empty State */}
  <div class="empty-news" id="noresults" hidden>
    <Crew who="oops" mood="shrug" class="empty-news__crew" />
    <div class="empty-news__text">
      <h3>No briefings match that search</h3>
      <p>Try searching for specific firms like <em>Tata</em>, <em>Blinkit</em>, <em>RBI</em>, or <button type="button" class="linkish" id="reset">clear the search</button>.</p>
    </div>
  </div>
</div>

<style>
  .news-browser {
    width: 100%;
    margin-bottom: 3.5rem;
  }

  /* ---------- 1. Function Doors (Segmented Panel Matching Homepage) ---------- */
  .doors {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-block: 1px solid var(--border);
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
    gap: 0;
  }

  .door {
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    background: none;
    border: 0;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: .1rem .75rem;
    align-items: center;
    padding: 1.1rem 1rem;
    position: relative;
    border-radius: 0;
    box-shadow: none;
    transform: none;
    transition: background-color var(--dur-fast) var(--ease);
  }

  .door + .door {
    box-shadow: inset 1px 0 0 var(--border);
  }

  .door:hover {
    background-color: var(--tint);
  }

  .door[aria-pressed='true'] {
    background-color: var(--tint);
  }

  .door[aria-pressed='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--accent);
  }

  .door__mark {
    grid-row: span 2;
    color: var(--accent);
    width: 2.5rem;
    height: 2.5rem;
    display: block;
    --mark-size: 2.5rem;
  }

  .door__mark svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    display: block;
  }

  .door__label {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.2;
    color: var(--ink);
  }

  .door__n {
    margin-left: .4rem;
    font-size: .8125rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink-soft);
  }

  .door__ask {
    font-size: .8125rem;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  @media (max-width: 68rem) {
    /* One swipeable row on tablet and mobile, exactly like the homepage */
    .doors {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      border-block: 1px solid var(--border);
      margin-top: 1rem;
      margin-bottom: 2rem;
    }
    .doors::-webkit-scrollbar {
      display: none;
    }
    .door {
      flex: 0 0 min(16.5rem, 72vw);
      scroll-snap-align: start;
      padding: .85rem .95rem;
    }
    .door + .door {
      box-shadow: inset 1px 0 0 var(--border);
    }
  }

  /* ---------- 2. Modern Sticky Toolbar ---------- */
  .toolbar {
    position: sticky;
    top: var(--nav-h, 3.35rem);
    z-index: 25;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: .75rem 1rem;
    margin-bottom: 2.75rem;
    box-shadow: 0 4px 20px var(--shadow);
  }
  .toolbar__row {
    display: flex;
    align-items: center;
    gap: .85rem;
    flex-wrap: wrap;
  }
  .toolbar__search {
    flex: 1 1 16rem;
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: .85rem;
    width: 15px;
    height: 15px;
    color: var(--ink-faint);
    pointer-events: none;
  }
  .toolbar__search input {
    font: inherit;
    font-size: .875rem;
    width: 100%;
    min-height: 2.5rem;
    padding: 0 2.25rem 0 2.35rem;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .toolbar__search input:focus-visible {
    outline: none;
    border-color: var(--ochre);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ochre) 18%, transparent);
  }
  .search-kbd {
    position: absolute;
    right: .85rem;
    font-size: .625rem;
    font-weight: 700;
    font-family: inherit;
    padding: .15rem .4rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--paper-2);
    color: var(--ink-faint);
    pointer-events: none;
    line-height: 1;
  }

  .toolbar__sort select {
    font: inherit;
    font-size: .8125rem;
    font-weight: 600;
    min-height: 2.5rem;
    padding: 0 1rem;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    cursor: pointer;
  }
  .toolbar__sort select:focus-visible {
    outline: none;
    border-color: var(--ochre);
  }

  .toolbar__actions {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-left: auto;
  }
  .test-toggle {
    font: inherit;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .04em;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .45rem .85rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease);
  }
  .test-toggle:hover {
    border-color: var(--ochre);
    background: color-mix(in srgb, var(--ochre) 8%, var(--card));
  }
  .test-toggle.is-active {
    background: var(--ochre);
    border-color: var(--ochre);
    color: var(--on-solid, var(--paper));
  }
  .test-toggle__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ochre);
  }
  .test-toggle.is-active .test-toggle__dot {
    background: currentColor;
  }
  .practised-tally {
    font-size: .75rem;
    font-weight: 700;
    color: var(--moss);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- 3. Day Section & Balanced Card Grid ---------- */
  .day-section {
    margin-bottom: 3.5rem;
  }
  .day-head {
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .day-head__dateline {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    flex-shrink: 0;
  }
  .day-head__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ochre);
  }
  .day-head__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -.02em;
    color: var(--ink);
  }
  .day-head__count {
    font-size: .75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--ink-faint);
    background: color-mix(in srgb, var(--paper-2) 80%, transparent);
    padding: .2rem .55rem;
    border-radius: 999px;
    border: 1px solid var(--border-soft);
  }
  .day-head__seam {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, var(--border), transparent 90%);
  }

  /* Balanced 2-Column Responsive Card Grid */
  .briefings-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }
  @media (max-width: 58rem) {
    .briefings-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  /* ---------- 4. Pixel-Glitch Shatter Mechanics ---------- */
  .card-scene {
    min-height: 25.5rem;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .card-scene--lead {
    grid-column: 1 / -1;
    min-height: 23rem;
  }

  .card {
    position: relative;
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    user-select: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    outline: none;
    text-align: left;
    font: inherit;
    color: inherit;
    border-radius: 14px;
    overflow: hidden;
    transition: transform var(--dur-fast) var(--ease),
                box-shadow var(--dur-fast) var(--ease);
  }

  .card:hover {
    box-shadow: 0 4px 16px var(--shadow);
  }

  .card:focus-visible {
    outline: 2px solid var(--ochre);
    outline-offset: 4px;
  }

  .card__stage {
    position: relative;
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    overflow: hidden;
  }

  /* Both Faces */
  .card__face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 8px 26px var(--shadow);
    transition: opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.32s ease;
  }

  /* FRONT FACE */
  .card__face--front {
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-left: 3.5px solid var(--accent);
    padding: 1.45rem 1.65rem 1.35rem;
    z-index: 2;
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }
  .card__face--front::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 0% 0%, var(--tint), transparent 60%);
    opacity: .65;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease);
  }
  .card:hover .card__face--front::before {
    opacity: 1;
  }

  /* BACK FACE */
  .card__face--back {
    background: color-mix(in srgb, var(--tint) 25%, var(--card));
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
    border-left: 3.5px solid var(--accent);
    padding: 1.45rem 1.65rem 1.35rem;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.97);
  }
  .card__face--back::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(130% 100% at 90% 10%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
                radial-gradient(100% 80% at 10% 90%, color-mix(in srgb, var(--ochre) 14%, transparent), transparent 70%);
    pointer-events: none;
  }

  /* Active Revealed State */
  .card.is-flipped .card__face--front {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.97);
    z-index: 1;
  }
  .card.is-flipped .card__face--back {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
    z-index: 2;
  }

  /* THE PIXEL SHATTER MATRIX (16 Fracturing Kintsugi Shards) */
  .card__shatter-matrix {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    border-radius: 14px;
    overflow: hidden;
    opacity: 0;
  }

  .shatter-pixel {
    position: relative;
    background: color-mix(in srgb, var(--accent) 30%, var(--card));
    opacity: 0;
    transform-origin: center;
  }

  /* Active during the shatter glitch transition */
  .card.is-shattering .card__shatter-matrix {
    opacity: 1;
  }

  .card.is-shattering .shatter-pixel {
    animation: pixel-shatter-burst 0.38s cubic-bezier(0.2, 0.9, 0.3, 1) calc((var(--r) * 0.035s) + (var(--c) * 0.025s)) both;
  }

  @keyframes pixel-shatter-burst {
    0% {
      opacity: 0.95;
      transform: scale(1) translate(0, 0);
      box-shadow: inset 0 0 0 1px var(--ochre);
      filter: brightness(1.2);
    }
    30% {
      opacity: 0.9;
      transform: scale(0.88) translate(calc((var(--c) - 1.5) * 8px), calc((var(--r) - 1.5) * 7px));
      box-shadow: inset 0 0 0 1.5px var(--accent), 0 0 10px var(--ochre);
      filter: hue-rotate(45deg) brightness(1.4);
    }
    60% {
      opacity: 0.6;
      transform: scale(0.7) translate(calc((var(--c) - 1.5) * 18px), calc((var(--r) - 1.5) * 15px));
      filter: drop-shadow(2px 0 var(--hanko)) drop-shadow(-2px 0 var(--mizu));
    }
    85% {
      opacity: 0.25;
      transform: scale(0.35) translate(calc((var(--c) - 1.5) * 26px), calc((var(--r) - 1.5) * 22px));
    }
    100% {
      opacity: 0;
      transform: scale(0) translate(calc((var(--c) - 1.5) * 32px), calc((var(--r) - 1.5) * 28px));
    }
  }

  /* Glitch Jitter on the Card Faces during Shatter */
  .card.is-shattering .card__face {
    animation: face-glitch-jitter 0.38s ease-out both;
  }

  @keyframes face-glitch-jitter {
    0% { transform: scale(1) translate(0, 0); filter: none; }
    20% { transform: scale(1.008) translate(-3px, 2px); filter: contrast(1.3) brightness(1.2); }
    40% { transform: scale(0.992) translate(3px, -1px); filter: drop-shadow(2px 0 var(--hanko)); }
    60% { transform: scale(1.004) translate(-2px, 0); filter: drop-shadow(-2px 0 var(--mizu)); }
    80% { transform: scale(0.998) translate(1px, 0); filter: none; }
    100% { transform: scale(1) translate(0, 0); filter: none; }
  }

  /* Front Content */
  .card__meta {
