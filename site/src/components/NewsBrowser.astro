---
import Crew from './Crew.astro';

export type NewsItem = {
  headline: string;
  date: string;
  category: string;
  summary: string;
  angle: string;
  source: string | null;
};

interface Props {
  items: NewsItem[];
  totalCount?: number;
  isLeadDay?: boolean;
}

const { items, totalCount, isLeadDay = true } = Astro.props;

const CATEGORY_META: Record<string, { accent: string; blurb: string }> = {
  Consulting: { accent: 'hanko', blurb: 'Frameworks and client problems' },
  Finance: { accent: 'ochre', blurb: 'Markets, deals and numbers' },
  Marketing: { accent: 'mizu', blurb: 'Brands, pricing and consumers' },
  Operations: { accent: 'moss', blurb: 'Supply chains and unit economics' },
  'Product Management': { accent: 'indigo', blurb: 'Users, metrics and trade-offs' },
};

const categories = Object.keys(CATEGORY_META);
const counts = Object.fromEntries(
  categories.map((c) => [c, items.filter((i) => i.category === c).length])
);

const byDate = items.reduce<Record<string, NewsItem[]>>((acc, i) => {
  (acc[i.date] ??= []).push(i);
  return acc;
}, {});
const dates = Object.keys(byDate).sort((a, b) => b.localeCompare(a));

const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-IN', {
    day: 'numeric',
    month: 'short',
    timeZone: 'UTC',
  });

const fmtDay = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-IN', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
  });

const host = (url: string | null) => {
  if (!url) return null;
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return null;
  }
};
---

<div class="news-browser" data-browser>
  <!-- 2. Function doors -->
  <div class="doors" role="group" aria-label="Filter by function">
    <button
      type="button"
      class="door door--all"
      data-door="all"
      aria-pressed="true"
      style="--accent:var(--ink);--tint:var(--paper-2)"
    >
      <span class="door__label">All<span class="door__n">{items.length}</span></span>
      <span class="door__ask">Everything, newest first</span>
    </button>
    {
      categories.map((c) => {
        const meta = CATEGORY_META[c];
        return (
          <button
            type="button"
            class="door"
            data-door={c}
            aria-pressed="false"
            style={`--accent:var(--${meta.accent});--tint:var(--wash-${meta.accent})`}
          >
            <span class="door__label">{c}<span class="door__n">{counts[c] ?? 0}</span></span>
            <span class="door__ask">{meta.blurb}</span>
          </button>
        );
      })
    }
  </div>

  <!-- 3. Toolbar -->
  <div class="toolbar" role="region" aria-label="Filter and sort stories">
    <div class="toolbar__row">
      <div class="toolbar__search">
        <label for="news-q" class="sr-only">Search stories</label>
        <input type="search" id="news-q" placeholder="Search headlines, summaries and angles…" autocomplete="off" />
      </div>
      <div class="toolbar__sort">
        <label for="news-sort" class="sr-only">Sort by</label>
        <select id="news-sort">
          <option value="new">Newest first</option>
          <option value="old">Oldest first</option>
          <option value="az">Headline A–Z</option>
        </select>
      </div>
      <div class="toolbar__actions">
        <button type="button" class="linkish test-toggle" id="test-toggle" hidden>Test me: hide the angles</button>
        <span class="practised-tally" id="practised-tally" hidden></span>
      </div>
    </div>
  </div>

  <!-- 4. Days & Cards -->
  <div class="days" id="news-archive">
    {
      dates.map((d, dayIdx) => (
        <section class="day" data-date={d}>
          <div class="day__side">
            <h2 class="day__label">
              <time datetime={d}>{fmtDay(d)}</time>
              <span class="day__count">{byDate[d].length} {byDate[d].length === 1 ? 'story' : 'stories'}</span>
            </h2>
          </div>
          <div class="day__cards">
            {byDate[d].map((i, cardIdx) => {
              const isLead = isLeadDay && dayIdx === 0 && cardIdx === 0;
              const meta = CATEGORY_META[i.category] ?? { accent: 'ink', blurb: '' };
              const storyId = `${i.date}:${i.headline}`;
              return (
                <article
                  class:list={['card', isLead && 'card--lead']}
                  data-cat={i.category}
                  data-date={i.date}
                  data-headline={i.headline.toLowerCase()}
                  data-id={storyId}
                  style={`--accent:var(--${meta.accent});--tint:var(--wash-${meta.accent})`}
                >
                  <div class="card__meta">
                    <span class="card__cat">
                      <span class="card__dot" aria-hidden="true" />
                      {i.category}
                    </span>
                    <span class="card__sep" aria-hidden="true">·</span>
                    <time class="card__date" datetime={i.date}>{fmtDate(i.date)}</time>
                    <span class="q__flag" data-flag hidden>Practised</span>
                  </div>

                  <h3 class="card__h">{i.headline}</h3>
                  <p class="card__sum">{i.summary}</p>

                  <div class="card__angle">
                    <div class="angle__content">
                      <span class="angle__label">They will push on</span>
                      <p class="angle__text">{i.angle}</p>
                    </div>
                    <div class="angle__test" hidden>
                      <p class="angle__prompt">What would they ask you about this?</p>
                      <button type="button" class="linkish angle__reveal">Show the angle</button>
                    </div>
                  </div>

                  {i.source && (
                    <a class="card__src linkish" href={i.source} target="_blank" rel="noopener noreferrer">
                      {host(i.source)} <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>

  <!-- 7. Empty search -->
  <div class="empty-news" id="noresults" hidden>
    <Crew who="oops" mood="shrug" class="empty-news__crew" />
    <p>Nothing matches that. Try a company name, or <button type="button" class="linkish" id="reset">clear the search</button>.</p>
  </div>
</div>

<style>
  .news-browser {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin-bottom: 3rem;
  }

  /* 2. Function doors */
  .doors {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    margin-bottom: 2rem; border-block: 1px solid var(--border);
  }
  .door {
    font: inherit; color: inherit; text-align: left; cursor: pointer; background: none; border: 0;
    display: flex; flex-direction: column; gap: .25rem;
    padding: 1.1rem 1rem; position: relative;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .door + .door { box-shadow: inset 1px 0 0 var(--border); }
  .door:hover, .door[aria-pressed='true'] { background: var(--tint); }
  .door[aria-pressed='true']::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--accent);
  }
  .door__label { font-size: 1.0625rem; font-weight: 800; letter-spacing: -.02em; line-height: 1.2; }
  .door__n { margin-left: .4rem; font-size: .8125rem; font-weight: 600; letter-spacing: 0; color: var(--ink-soft); }
  .door__ask { font-size: .8125rem; line-height: 1.35; color: var(--ink-soft); }

  @media (max-width: 68rem) {
    .doors { display: flex; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; }
    .doors::-webkit-scrollbar { display: none; }
    .door { flex: 0 0 min(15.5rem, 66vw); scroll-snap-align: start; padding: .85rem .9rem; }
  }

  /* 3. Toolbar */
  .toolbar {
    position: sticky; top: 0; z-index: 20;
    background: var(--paper); border-bottom: 1px solid var(--border);
    padding: .85rem 0; margin-bottom: 2.5rem;
  }
  .toolbar__row {
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
  }
  .toolbar__search { flex: 1 1 14rem; }
  .toolbar__search input {
    font: inherit; font-size: .9375rem; width: 100%; min-height: 2.75rem; padding: 0 1rem;
    color: var(--ink); background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .toolbar__search input::placeholder { color: var(--ink-soft); }
  .toolbar__search input:focus-visible { outline: 2px solid var(--mizu); outline-offset: 1px; }
  .toolbar__sort select {
    font: inherit; font-size: .875rem; min-height: 2.75rem; padding: 0 .9rem;
    color: var(--ink); background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    cursor: pointer;
  }
  .toolbar__sort select:focus-visible { outline: 2px solid var(--mizu); outline-offset: 1px; }
  .toolbar__actions { display: flex; align-items: center; gap: .75rem; margin-left: auto; }
  .practised-tally { font-size: .8125rem; font-weight: 600; color: var(--ink-soft); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* 4. Days */
  .day {
    display: grid; grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem; margin-bottom: 3.5rem;
  }
  .day__side {
    border-left: 2px solid var(--ochre); padding-left: 1rem;
  }
  .day__label {
    margin: 0; display: flex; flex-direction: column; gap: .25rem;
  }
  .day__label time {
    font-family: var(--font); font-size: 1.25rem; font-weight: 800; line-height: 1.2;
    letter-spacing: -.02em; color: var(--ink);
  }
  .day__count {
    font-size: .875rem; font-weight: 600; color: var(--ink-soft); font-variant-numeric: tabular-nums;
  }

  @media (min-width: 64rem) {
    .day {
      grid-template-columns: 13.5rem minmax(0, 1fr);
      gap: 2.5rem;
    }
    .day__side {
      position: sticky; top: calc(2.75rem + 2rem); align-self: start;
    }
  }

  .day__cards {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem;
  }
  @media (min-width: 48rem) {
    .day__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 84rem) {
    .day__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* 5. Card */
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px 14px 14px 3px;
    padding: 1.25rem 1.35rem 1.2rem;
    display: flex; flex-direction: column;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
    word-break: break-word;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card--lead {
    grid-column: 1 / -1;
  }
  .card__meta {
    display: flex; align-items: center; gap: .45rem; flex-wrap: wrap;
    font-size: .8125rem; font-weight: 600; color: var(--ink-soft);
    margin-bottom: .65rem;
  }
  .card__cat {
    display: inline-flex; align-items: center; gap: .4rem; color: var(--ink);
  }
  .card__dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--accent); flex-shrink: 0;
  }
  .card__sep { color: var(--ink-faint); }
  .card__date { font-variant-numeric: tabular-nums; }

  .card__h {
    margin: 0 0 .65rem; font-family: var(--font); font-size: 1.125rem; font-weight: 700;
    line-height: 1.25; color: var(--ink); letter-spacing: -.015em; text-wrap: pretty;
  }
  .card--lead .card__h {
    font-family: var(--serif); font-size: clamp(1.625rem, 3vw, 2.25rem); font-weight: 500;
    line-height: 1.2; letter-spacing: -.02em;
  }
  .card__sum {
    font-size: .9375rem; line-height: 1.55; color: var(--ink-soft); margin: 0 0 1.1rem;
  }
  .card__angle {
    margin-top: auto; padding: .9rem 1rem;
    background: var(--tint);
    border-left: 2px solid var(--ochre);
    border-radius: 0 10px 10px 0;
  }
  .angle__label {
    display: block; font-family: var(--font); font-size: .8125rem; font-weight: 700;
    color: var(--ink); margin-bottom: .35rem; letter-spacing: -.01em;
  }
  .angle__text {
    margin: 0; font-family: var(--serif); font-size: 1.0625rem; line-height: 1.45;
    color: var(--ink); text-wrap: pretty;
  }
  .angle__prompt {
    margin: 0 0 .5rem; font-family: var(--serif); font-size: 1.0625rem; font-style: italic;
    color: var(--ink);
  }
  .angle__reveal {
    font-size: .875rem; font-weight: 700;
  }
  .card__src {
    margin-top: .9rem; font-size: .875rem; align-self: flex-start;
    overflow-wrap: anywhere; word-break: break-word;
  }
  @media (max-width: 30rem) {
    .card { padding: 1.1rem 1rem; }
  }

  .q__flag { margin-left: .4rem; font-size: .8125rem; font-weight: 700; color: var(--ink); white-space: nowrap; }
  .q__flag::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: .35rem; background: var(--ochre); transform: rotate(45deg); vertical-align: 1px; }

  /* 7. Empty search */
  .empty-news {
    margin: 3rem 0; font-size: 1rem; color: var(--ink-soft);
    display: flex; align-items: center; gap: 1rem;
  }
  .empty-news__crew { width: 4.5rem; height: 4.5rem; flex-shrink: 0; }
  .empty-news p { margin: 0; }

  .linkish {
    font: inherit; font-size: .875rem; font-weight: 700; color: var(--ink); background: none; border: 0;
    border-bottom: 1px solid var(--border); padding: 0 0 1px; cursor: pointer; text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .linkish:hover { border-color: var(--ink); }

  [hidden] { display: none !important; }

  @media (prefers-reduced-motion: reduce) {
    .door, .card, .toolbar__search input { transition: none; }
  }
</style>

<script>
  const browserEl = document.querySelector<HTMLElement>('[data-browser]');
  const q = document.getElementById('news-q') as HTMLInputElement | null;
  const sort = document.getElementById('news-sort') as HTMLSelectElement | null;
  const testToggle = document.getElementById('test-toggle') as HTMLButtonElement | null;
  const tallyEl = document.getElementById('practised-tally');
  const noresults = document.getElementById('noresults');
  const resetBtn = document.getElementById('reset');
  const doors = [...document.querySelectorAll<HTMLButtonElement>('.door')];
  const archive = document.getElementById('news-archive');
  const days = [...document.querySelectorAll<HTMLElement>('.day')];
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];

  let currentCategory = 'all';
  let testMode = false;

  const store = {
    get<T>(key: string, fallback: T): T {
      try {
        return (JSON.parse(localStorage.getItem(key) ?? 'null') as T) ?? fallback;
      } catch {
        return fallback;
      }
    },
    set(key: string, value: unknown) {
      try {
        localStorage.setItem(key, JSON.stringify(value));
      } catch {
        // private mode
      }
    },
  };

  const getPractised = (): string[] => store.get<string[]>('waibi:news:practised', []);

  const updatePractisedUI = () => {
    const practised = getPractised();
    if (tallyEl) {
      if (practised.length > 0) {
        tallyEl.textContent = `${practised.length} practised`;
        tallyEl.hidden = false;
      } else {
        tallyEl.hidden = true;
      }
    }

    for (const card of cards) {
      const id = card.dataset.id ?? '';
      const isPractised = practised.includes(id);
      const flag = card.querySelector<HTMLElement>('[data-flag]');
      if (flag) flag.hidden = !isPractised;

      const angleContent = card.querySelector<HTMLElement>('.angle__content');
      const angleTest = card.querySelector<HTMLElement>('.angle__test');

      if (testMode) {
        if (isPractised) {
          if (angleContent) angleContent.hidden = false;
          if (angleTest) angleTest.hidden = true;
        } else {
          if (angleContent) angleContent.hidden = true;
          if (angleTest) angleTest.hidden = false;
        }
      } else {
        if (angleContent) angleContent.hidden = false;
        if (angleTest) angleTest.hidden = true;
      }
    }
  };

  const filterCards = () => {
    const term = (q?.value ?? '').trim().toLowerCase();
    let visibleCount = 0;

    for (const card of cards) {
      const catMatch = currentCategory === 'all' || card.dataset.cat === currentCategory;
      const termMatch = !term || (card.textContent ?? '').toLowerCase().includes(term);
      const isVisible = catMatch && termMatch;
      card.hidden = !isVisible;
      if (isVisible) visibleCount++;
    }

    for (const day of days) {
      const hasVisible = [...day.querySelectorAll<HTMLElement>('.card')].some((c) => !c.hidden);
      day.hidden = !hasVisible;
    }

    if (noresults) noresults.hidden = visibleCount > 0;
  };

  const reorderCards = () => {
    if (!sort || !archive) return;
    const mode = sort.value;

    if (mode === 'new' || mode === 'old') {
      for (const day of days) {
        const grid = day.querySelector('.day__cards')!;
        cards
          .filter((c) => c.dataset.date === day.dataset.date)
          .forEach((c) => grid.appendChild(c));
      }
      [...days]
        .sort((a, b) =>
          mode === 'new'
            ? b.dataset.date!.localeCompare(a.dataset.date!)
            : a.dataset.date!.localeCompare(b.dataset.date!)
        )
        .forEach((d) => archive.appendChild(d));
      return;
    }

    // flatten into first day's grid for A-Z
    const firstDay = days[0];
    if (firstDay) {
      const grid = firstDay.querySelector('.day__cards')!;
      [...cards]
        .sort((a, b) => (a.dataset.headline ?? '').localeCompare(b.dataset.headline ?? ''))
        .forEach((c) => grid.appendChild(c));
      archive.prepend(firstDay);
    }
  };

  doors.forEach((door) => {
    door.addEventListener('click', () => {
      currentCategory = door.dataset.door ?? 'all';
      doors.forEach((d) => d.setAttribute('aria-pressed', String(d === door)));
      filterCards();
    });
  });

  if (q) q.addEventListener('input', filterCards);

  if (sort) {
    sort.addEventListener('change', () => {
      reorderCards();
      filterCards();
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      if (q) q.value = '';
      const allDoor = doors.find((d) => d.dataset.door === 'all');
      allDoor?.click();
    });
  }

  if (testToggle) {
    testToggle.hidden = false;
    testToggle.addEventListener('click', () => {
      testMode = !testMode;
      testToggle.textContent = testMode ? 'Show the angles' : 'Test me: hide the angles';
      updatePractisedUI();
    });
  }

  // Handle reveal buttons
  cards.forEach((card) => {
    const revealBtn = card.querySelector<HTMLButtonElement>('.angle__reveal');
    revealBtn?.addEventListener('click', () => {
      const id = card.dataset.id ?? '';
      if (id) {
        const practised = getPractised();
        if (!practised.includes(id)) {
          store.set('waibi:news:practised', [...practised, id]);
        }
        updatePractisedUI();
      }
    });
  });

  updatePractisedUI();
  filterCards();
</script>
