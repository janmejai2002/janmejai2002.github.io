---
/**
 * The archive as one kintsugi bowl: one shard per published article, oldest at
 * the centre, each cut from that article's own artwork and joined in gold.
 *
 * Laid out as a sunflower spiral so the bowl grows outward as posts are added
 * without existing shards moving much. `capacity` is always ahead of the post
 * count, so there is always an unwritten outer ring. The geometry is computed
 * here at build time; the page ships plain SVG and no layout code.
 */
import { Delaunay } from 'd3-delaunay';
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { TRACKS } from '../data/tracks';

interface Props {
  /** Newest first, the order the index already sorts them in. */
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;

const SIZE = 1000;
const C = SIZE / 2;
const R = 476;
const GOLDEN = Math.PI * (3 - Math.sqrt(5));

const chrono = [...posts].reverse();
const n = chrono.length;
const capacity = Math.ceil((n + 12) / 20) * 20;

// A seeded generator, so the same posts always produce the same bowl.
const rng = (seed: number) => () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const rand = rng(2002);

const spacing = R * Math.sqrt(1 / capacity);
const points: [number, number][] = [];
for (let i = 0; i < capacity; i++) {
  const r = R * Math.sqrt((i + 0.55) / capacity);
  const a = i * GOLDEN + 0.7;
  points.push([
    C + r * Math.cos(a) + (rand() - 0.5) * spacing * 0.95,
    C + r * Math.sin(a) + (rand() - 0.5) * spacing * 0.95,
  ]);
}
// A ring of unrendered sites so the outermost real cells close near the rim.
const RING = 64;
for (let i = 0; i < RING; i++) {
  const a = (i / RING) * Math.PI * 2;
  points.push([C + (R + spacing * 0.95) * Math.cos(a), C + (R + spacing * 0.95) * Math.sin(a)]);
}

const voronoi = Delaunay.from(points).voronoi([-200, -200, SIZE + 200, SIZE + 200]);

// Every edge is roughened once, keyed on its two ends, so both neighbours get
// exactly the same broken line and no gaps open along a join.
const edges = new Map<string, [number, number][]>();
const key = (p: readonly number[]) => `${p[0].toFixed(2)},${p[1].toFixed(2)}`;
const roughen = (a: readonly number[], b: readonly number[]) => {
  const ka = key(a);
  const kb = key(b);
  const forward = ka < kb;
  const id = forward ? `${ka}|${kb}` : `${kb}|${ka}`;
  if (!edges.has(id)) {
    const [p, q] = forward ? [a, b] : [b, a];
    let line: [number, number][] = [[p[0], p[1]], [q[0], q[1]]];
    const local = rng([...id].reduce((s, ch) => (Math.imul(s, 31) + ch.charCodeAt(0)) | 0, 7));
    for (let depth = 0, amp = 0.14; depth < 3; depth++, amp *= 0.56) {
      const next: [number, number][] = [line[0]];
      for (let i = 0; i < line.length - 1; i++) {
        const [x0, y0] = line[i];
        const [x1, y1] = line[i + 1];
        const off = (local() - 0.5) * amp;
        next.push([(x0 + x1) / 2 - (y1 - y0) * off, (y0 + y1) / 2 + (x1 - x0) * off]);
        next.push(line[i + 1]);
      }
      line = next;
    }
    edges.set(id, line);
  }
  const line = edges.get(id)!;
  return forward ? line : [...line].reverse();
};

const cell = (i: number) => {
  const poly = voronoi.cellPolygon(i);
  const out: [number, number][] = [];
  for (let k = 0; k < poly.length - 1; k++) out.push(...roughen(poly[k], poly[k + 1]).slice(0, -1));
  return out;
};
const toPath = (pts: [number, number][]) =>
  `M${pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L')}Z`;

const accentOf = Object.fromEntries(TRACKS.map((t) => [t.id, t.accent]));
const slugOf = (p: (typeof posts)[number]) => p.id.replace(/\.md$/, '');

const shards = await Promise.all(
  chrono.map(async (post, i) => {
    const pts = cell(i);
    const xs = pts.map((p) => p[0]);
    const ys = pts.map((p) => p[1]);
    const x0 = Math.min(...xs);
    const y0 = Math.min(...ys);
    const w = Math.max(...xs) - x0;
    const h = Math.max(...ys) - y0;
    const thumb = async (src?: ImageMetadata) =>
      src ? (await getImage({ src, width: 280, format: 'webp', quality: 62 })).src : '';
    return {
      i,
      slug: slugOf(post),
      accent: accentOf[post.data.track],
      track: post.data.track,
      d: toPath(pts),
      // Oversized, because the motif sits mid-frame and shards are small.
      box: { x: x0 - w * 0.18, y: y0 - h * 0.18, w: w * 1.36, h: h * 1.36 },
      light: await thumb(post.data.heroImage),
      dark: await thumb(post.data.heroImageDark ?? post.data.heroImage),
      tone: 0.72 + rand() * 0.28,
    };
  })
);
const ghosts = Array.from({ length: capacity - n }, (_, k) => toPath(cell(n + k)));
---

<figure class="bowl" data-bowl aria-hidden="true">
  <svg viewBox={`0 0 ${SIZE} ${SIZE}`} data-bowl-svg>
    <defs>
      <clipPath id="bowl-disc"><circle cx={C} cy={C} r={R} /></clipPath>
      {shards.map((s) => <clipPath id={`shard-${s.i}`}><path d={s.d} /></clipPath>)}
      <linearGradient id="bowl-gold" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={SIZE} y2={SIZE} data-bowl-gold>
        <stop offset="0" style="stop-color:color-mix(in srgb, var(--ochre) 80%, black)" />
        <stop offset=".4" style="stop-color:var(--ochre)" />
        <stop offset=".5" style="stop-color:color-mix(in srgb, var(--ochre) 30%, white)" />
        <stop offset=".6" style="stop-color:var(--ochre)" />
        <stop offset="1" style="stop-color:color-mix(in srgb, var(--ochre) 80%, black)" />
      </linearGradient>
      <radialGradient id="bowl-well" cx=".5" cy=".46" r=".54">
        <stop offset=".35" style="stop-color:var(--ink);stop-opacity:0" />
        <stop offset=".86" style="stop-color:var(--ink);stop-opacity:.1" />
        <stop offset="1" style="stop-color:var(--ink);stop-opacity:.3" />
      </radialGradient>
      <radialGradient id="bowl-shadow">
        <stop offset=".62" style="stop-color:var(--ink);stop-opacity:.22" />
        <stop offset="1" style="stop-color:var(--ink);stop-opacity:0" />
      </radialGradient>
    </defs>

    <ellipse cx={C} cy={C + 18} rx={R + 22} ry={R + 18} fill="url(#bowl-shadow)" />
    <circle class="bowl__base" cx={C} cy={C} r={R} />

    <g clip-path="url(#bowl-disc)">
      <g class="bowl__ghosts">{ghosts.map((d) => <path d={d} />)}</g>
      <g class="bowl__shards">
        {shards.map((s) => (
          <a
            href={`/blog/${s.slug}/`}
            tabindex="-1"
            class="shard"
            data-shard={s.slug}
            data-track={s.track}
            style={`--accent:var(--${s.accent});--tone:${s.tone.toFixed(2)};--order:${s.i}`}
          >
            <path class="shard__ground" d={s.d} />
            <image
              class="shard__art"
              clip-path={`url(#shard-${s.i})`}
              x={s.box.x.toFixed(1)}
              y={s.box.y.toFixed(1)}
              width={s.box.w.toFixed(1)}
              height={s.box.h.toFixed(1)}
              preserveAspectRatio="xMidYMid slice"
              data-light={s.light}
              data-dark={s.dark}
            />
            <path class="shard__tint" d={s.d} />
            <path class="shard__seam" d={s.d} />
          </a>
        ))}
      </g>
    </g>

    <circle cx={C} cy={C} r={R} fill="url(#bowl-well)" pointer-events="none" />
    <circle class="bowl__rim" cx={C} cy={C} r={R} />
  </svg>
  <figcaption>
    <p class="bowl__now" data-bowl-now></p>
    <p class="bowl__key">
      Each piece is one article. The oldest sits at the centre, and the outer ring is
      still unwritten.
    </p>
  </figcaption>
</figure>

<style is:global>
  .bowl { margin: 0; }
  .bowl svg { display: block; width: 100%; height: auto; overflow: visible; }
  .bowl__base { fill: var(--stone); }
  .bowl__rim { fill: none; stroke: var(--border); stroke-width: 2; }
  .bowl__ghosts path {
    fill: var(--paper-2); fill-opacity: .55; stroke: var(--ochre); stroke-width: 3.4;
    stroke-dasharray: .5 11; stroke-linecap: round;
  }
  .shard { cursor: pointer; outline: none; }
  .shard__ground { fill: var(--paper); }
  .shard__art { mix-blend-mode: multiply; opacity: .9; }
  .shard__tint {
    fill: var(--accent); opacity: calc(var(--tone) * .4);
    transition: opacity var(--dur-fast) var(--ease);
  }
  .shard__seam {
    fill: none; stroke: url(#bowl-gold); stroke-width: 6.5; stroke-linejoin: round;
    transition: stroke-width var(--dur-fast) var(--ease);
  }
  .shard { transition: opacity .35s var(--ease), transform .35s var(--ease); }
  .shard > path, .shard > image { transform-box: view-box; }

  /* The written part of the bowl dims together, so what you picked stands out. */
  .shard.off { opacity: .16; }
  /* While someone is exploring, the piece they are on lifts clear of the rest. */
  .shard { transform-box: fill-box; transform-origin: center; }
  .bowl.hot .shard:not(.on):not(.off) { opacity: .34; }
  .bowl.hot .shard.on {
    transform: scale(1.14);
    filter: drop-shadow(0 6px 10px color-mix(in srgb, var(--ink) 38%, transparent));
  }
  .bowl.hot .shard.on .shard__tint { opacity: .62; }
  .bowl.hot .shard.on .shard__seam { stroke-width: 8; }

  /* Scrolled into view, it assembles in publication order. Each shard ends where
     its resting style already is, so nothing depends on this having run. */
  .bowl.grow .shard {
    animation: shard-set .7s var(--ease) backwards;
    animation-delay: calc(var(--order) * 26ms);
  }
  .bowl.grow.hot .shard { animation: none; }
  @keyframes shard-set { from { opacity: 0; } }

  .bowl figcaption { margin-top: 1rem; }
  .bowl__now { margin: 0; min-height: 4.65em; font-size: .9375rem; line-height: 1.55; color: var(--ink); text-wrap: pretty; }
  .bowl__key { margin: .75rem 0 0; font-size: .8125rem; line-height: 1.5; color: var(--ink-soft); }

  :root[data-theme='dark'] .shard__art { mix-blend-mode: screen; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .shard__art { mix-blend-mode: screen; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bowl.grow .shard { animation: none; }
  }
</style>
