---
/**
 * The archive as one kintsugi bowl: one piece per published article, oldest at
 * the centre, each glazed in its theme's colour, carrying its own artwork, and
 * joined to the rest in gold.
 *
 * It is drawn as a vessel, not a diagram: the pieces are the glazed inside of a
 * bowl seen from above, with a lip, an outer wall, an unglazed foot and a shadow
 * on the table (lib/bowl-form.ts). Turn it like a bowl on a wheel; look at a
 * piece and its card rises with the drawing assembling; ask the crew on the rim
 * to pick one. Geometry: lib/bowl.ts. Behaviour: scripts/bowl.ts. Live gold:
 * scripts/bowl-gold.ts. The crew: scripts/bowl-scenes.ts. Without script it is
 * a picture whose pieces are plain links.
 */
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { TRACKS } from '../data/tracks';
import { bowlGeometry, toPath } from '../lib/bowl';
import { SIZE, C, R, K, W, H, RIM_Y, DISC_TOP, BODY, FOOT, LIP_FRONT, FLOOR_SCALE, FLOOR_DROP, rimFront } from '../lib/bowl-form';
import { liveArt } from '../lib/art';
import { bowlWall, packWall } from '../lib/bowl-wall';
import { ATLAS_COLS } from '../lib/bowl-form';
import CrewActor from './CrewActor.astro';

interface Props {
  /** Newest first, the order the index already sorts them in. */
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;

const chrono = [...posts].reverse();
const n = chrono.length;
const { capacity, cells, tones } = bowlGeometry(n);

const accentOf = Object.fromEntries(TRACKS.map((t) => [t.id, t.accent]));
const slugOf = (p: (typeof posts)[number]) => p.id.replace(/\.md$/, '');
const centre = (pts: [number, number][]) => {
  let x = 0;
  let y = 0;
  for (const p of pts) {
    x += p[0];
    y += p[1];
  }
  return [x / pts.length, y / pts.length];
};

const shards = await Promise.all(
  chrono.map(async (post, i) => {
    const pts = cells[i];
    const xs = pts.map((p) => p[0]);
    const ys = pts.map((p) => p[1]);
    const x0 = Math.min(...xs);
    const y0 = Math.min(...ys);
    const w = Math.max(...xs) - x0;
    const h = Math.max(...ys) - y0;
    const img = async (width: number, quality: number, src?: ImageMetadata) =>
      src ? (await getImage({ src, width, format: 'webp', quality })).src : '';
    const dark = post.data.heroImageDark ?? post.data.heroImage;
    const [cx, cy] = centre(pts);
    const slug = slugOf(post);
    return {
      i,
      slug,
      accent: accentOf[post.data.track],
      track: post.data.track,
      d: toPath(pts),
      cx: cx.toFixed(0),
      cy: cy.toFixed(0),
      // Oversized, because the motif sits mid-frame and pieces are small.
      box: { x: x0 - w * 0.18, y: y0 - h * 0.18, w: w * 1.36, h: h * 1.36 },
      light: await img(280, 62, post.data.heroImage),
      dark: await img(280, 62, dark),
      // Shown while its live drawing loads, and for a piece that has none.
      cardLight: await img(640, 70, post.data.heroImage),
      cardDark: await img(640, 70, dark),
      live: !!liveArt(slug),
      tone: tones[i],
    };
  })
);
const ghosts = Array.from({ length: capacity - n }, (_, k) => toPath(cells[n + k]));
// The bowl built from its pieces: its wall, cut into one piece per article.
const wall = packWall(bowlWall(n));
// A mended crack down the outside, from the front of the rim to the foot.
const [crackX, crackY] = rimFront(63);
const crack = `M${crackX.toFixed(0)} ${crackY.toFixed(0)}l-9 27l15 22l-12 28l8 26`;
const crackBranch = `M${(crackX - 6).toFixed(0)} ${(crackY + 77).toFixed(0)}l-19 10l-6 14`;
---

<figure
  class="bowl"
  id="bowl"
  data-bowl
  style={`--disc-top:${((DISC_TOP / H) * 100).toFixed(3)}%;--rim-rx:${((R / W) * 100).toFixed(2)}%;--rim-ry:${(((R * K) / H) * 100).toFixed(2)}%;--rim-cy:${((RIM_Y / H) * 100).toFixed(2)}%;--floor-scale:${FLOOR_SCALE};--floor-drop:${((FLOOR_DROP / SIZE) * 100).toFixed(2)}%`}
>
  <div
    class="bowl__body"
    data-bowl-body
    tabindex="0"
    role="group"
    aria-roledescription="bowl"
    aria-label={`The archive bowl: ${n} pieces, one per article`}
    aria-describedby="bowl-help"
  >
    {/* The bowl built from its pieces, in 3D (scripts/bowl-3d.ts). When it runs,
        the flat bowl below is only the state the page reads. */}
    <div class="bowl__table" aria-hidden="true"></div>
    <canvas
      class="bowl__3d"
      data-bowl-3d
      data-wall-counts={wall.counts}
      data-wall={wall.data}
      data-atlas-light="/bowl/atlas-light.webp"
      data-atlas-dark="/bowl/atlas-dark.webp"
      data-atlas-cols={ATLAS_COLS}
      aria-hidden="true"
    ></canvas>

    {/* The outside of the bowl, flat on screen: shadow, wall, foot, a mended crack. */}
    <svg class="bowl__outside" viewBox={`0 0 ${W} ${H}`} data-bowl-frame aria-hidden="true">
      <defs>
        <radialGradient id="bowl-table">
          <stop offset=".45" style="stop-color:var(--bowl-shadow);stop-opacity:.55" />
          <stop offset="1" style="stop-color:var(--bowl-shadow);stop-opacity:0" />
        </radialGradient>
        {/* Lit from the upper left, as everything on the site is. */}
        <linearGradient id="bowl-wall" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" style="stop-color:var(--glaze-hi)" />
          <stop offset=".34" style="stop-color:var(--glaze)" />
          <stop offset=".8" style="stop-color:var(--glaze-lo)" />
          <stop offset="1" style="stop-color:var(--glaze-lo)" />
        </linearGradient>
        <linearGradient id="bowl-wall-fall" x1="0" y1="0" x2="0" y2="1">
          <stop offset=".35" style="stop-color:var(--bowl-shadow);stop-opacity:0" />
          <stop offset="1" style="stop-color:var(--bowl-shadow);stop-opacity:.42" />
        </linearGradient>
        {/* The inside wall, seen over the far rim: lit under the lip, falling
            into shade toward the floor. */}
        <linearGradient id="bowl-inwall" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color:var(--glaze-hi)" />
          <stop offset=".3" style="stop-color:var(--glaze)" />
          <stop offset=".75" style="stop-color:var(--glaze-lo)" />
        </linearGradient>
        <pattern id="bowl-grain" width="200" height="200" patternUnits="userSpaceOnUse">
          <image href="/textures/paper-noise-mono.webp" width="200" height="200" />
        </pattern>
        <linearGradient id="bowl-foot" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" style="stop-color:var(--clay-hi)" />
          <stop offset=".6" style="stop-color:var(--clay)" />
          <stop offset="1" style="stop-color:var(--clay-lo)" />
        </linearGradient>
      </defs>
      <ellipse cx={C} cy="712" rx="350" ry="58" fill="url(#bowl-table)" />
      <path d={BODY} fill="url(#bowl-wall)" />
      <path d={BODY} fill="url(#bowl-wall-fall)" />
      <path d={BODY} fill="url(#bowl-grain)" class="bowl__grain" />
      {/* Glaze runs thin over the lip and pools just under it. */}
      <path class="bowl__pool" d={LIP_FRONT} />
      <path class="bowl__drip" d="M196 500q9 52 1 92q-8-22-13-86z" />
      <path class="bowl__drip" d="M452 551q6 38 0 66q-6-16-10-60z" />
      <path class="bowl__foot" d={FOOT} fill="url(#bowl-foot)" />
      <path class="bowl__crack" d={crack} />
      <path class="bowl__crack" d={crackBranch} />
      <path class="bowl__crack-lit" d={crack} />
      <ellipse cx={C} cy={RIM_Y} rx={R} ry={(R * K).toFixed(1)} fill="url(#bowl-inwall)" />
    </svg>

    {/* The inside, tipped back so the reader looks down into it. Everything in
        here lies in the bowl's own plane. */}
    <div class="bowl__inside">
    <div class="bowl__disc" data-bowl-disc>
      <svg class="bowl__floor" viewBox={`0 0 ${SIZE} ${SIZE}`} aria-hidden="true">
        <circle class="bowl__base" cx={C} cy={C} r={R} />
      </svg>

      {/* A still window around the turning layer, so a turned square's corners
          never poke past the screen edge on a phone. */}
      <div class="bowl__window">
        <div class="bowl__turn" data-spin>
          <svg class="bowl__pieces" viewBox={`0 0 ${SIZE} ${SIZE}`} data-bowl-svg aria-hidden="true">
            <defs>
              <clipPath id="bowl-disc"><circle cx={C} cy={C} r={R} /></clipPath>
              {shards.map((s) => <clipPath id={`shard-${s.i}`}><path d={s.d} /></clipPath>)}
              {/* The SVG seams' gold: the fallback without WebGL, and the seam
                  of a lifted piece. The live gold is scripts/bowl-gold.ts. */}
              <linearGradient id="bowl-gold" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={SIZE} y2={SIZE} data-bowl-gold>
                <stop offset="0" style="stop-color:color-mix(in srgb, var(--gold) 70%, black)" />
                <stop offset=".4" style="stop-color:var(--gold)" />
                <stop offset=".5" style="stop-color:color-mix(in srgb, var(--gold) 40%, white)" />
                <stop offset=".6" style="stop-color:var(--gold)" />
                <stop offset="1" style="stop-color:color-mix(in srgb, var(--gold) 70%, black)" />
              </linearGradient>
            </defs>
            <g clip-path="url(#bowl-disc)">
              <g class="bowl__ghosts">{ghosts.map((d) => <path d={d} data-ghost />)}</g>
              <g class="bowl__shards">
                {shards.map((s) => (
                  <a
                    href={`/blog/${s.slug}/`}
                    tabindex="-1"
                    class="shard"
                    data-shard={s.slug}
                    data-i={s.i}
                    data-track={s.track}
                    data-cx={s.cx}
                    data-cy={s.cy}
                    data-card-light={s.cardLight}
                    data-card-dark={s.cardDark}
                    data-live={s.live ? '' : undefined}
                    style={`--accent:var(--${s.accent});--mix-l:${(18 + s.tone * 16).toFixed(0)}%;--mix-d:${(30 + s.tone * 22).toFixed(0)}%;--order:${s.i}`}
                  >
                    <path class="shard__ground" d={s.d} />
                    <image
                      class="shard__art"
                      clip-path={`url(#shard-${s.i})`}
                      x={s.box.x.toFixed(1)}
                      y={s.box.y.toFixed(1)}
                      width={s.box.w.toFixed(1)}
                      height={s.box.h.toFixed(1)}
                      preserveAspectRatio="xMidYMid slice"
                      data-light={s.light}
                      data-dark={s.dark}
                    />
                    <path class="shard__tint" d={s.d} />
                    <path class="shard__seam" d={s.d} />
                  </a>
                ))}
              </g>
            </g>
          </svg>
          <canvas class="bowl__gold" data-bowl-gl aria-hidden="true"></canvas>
        </div>
      </div>

      {/* The inside wall: the near side falls into shade, the far side catches
          the light, and the lip is a band of glaze around it all. */}
      <svg class="bowl__inner" viewBox={`0 0 ${SIZE} ${SIZE}`} aria-hidden="true">
        <defs>
          <radialGradient id="bowl-well" cx=".5" cy=".4" r=".56">
            <stop offset=".5" style="stop-color:var(--bowl-shadow);stop-opacity:0" />
            <stop offset=".82" style="stop-color:var(--bowl-shadow);stop-opacity:calc(var(--well) * .32)" />
            <stop offset="1" style="stop-color:var(--bowl-shadow);stop-opacity:var(--well)" />
          </radialGradient>
          <radialGradient id="bowl-gleam" cx=".3" cy=".2" r=".5">
            <stop offset="0" style="stop-color:var(--glaze-gleam);stop-opacity:.22" />
            <stop offset="1" style="stop-color:var(--glaze-gleam);stop-opacity:0" />
          </radialGradient>
        </defs>
        <circle cx={C} cy={C} r={R} fill="url(#bowl-well)" />
        <circle cx={C} cy={C} r={R} fill="url(#bowl-gleam)" />
      </svg>
    </div>
    </div>

    {/* The lip, in the rim's own plane, over everything inside. */}
    <div class="bowl__rimplane" aria-hidden="true">
      <svg viewBox={`0 0 ${SIZE} ${SIZE}`}>
        <defs>
          <linearGradient id="bowl-lip" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" style="stop-color:var(--glaze-gleam)" />
            <stop offset=".45" style="stop-color:var(--glaze-hi)" />
            <stop offset="1" style="stop-color:var(--glaze-lo)" />
          </linearGradient>
        </defs>
        <circle class="bowl__lip" cx={C} cy={C} r={R + 6} />
        <circle class="bowl__lip-edge" cx={C} cy={C} r={R - 3} />
      </svg>
    </div>

    {/* The crew stand on the far rim. They never take a click. */}
    <div class="bowl__stage" data-bowl-stage aria-hidden="true">
      <CrewActor who="tsugi" moods={['idle', 'paint', 'proud']} />
      <CrewActor who="kiki" moods={['listen', 'happy', 'idle']} />
      <CrewActor who="oops" moods={['panic', 'swing', 'sideeye']} />
      <CrewActor who="uso" moods={['doubt', 'sideeye', 'idle']} />
      <CrewActor who="fude" moods={['scribble', 'idle', 'proud']} />
    </div>

    {/* The piece under the pointer, at a glance. Never takes a click: the piece does. */}
    <div class="bowl__peek" data-bowl-peek aria-hidden="true" hidden>
      <div class="bowl__frame">
        <svg class="bowl__art" viewBox="0 0 1600 900" data-peek-art></svg>
        <img data-peek-img alt="Artwork of the piece under the pointer" decoding="async" />
      </div>
      <p class="bowl__ck">
        <span class="bowl__dot" aria-hidden="true"></span><span data-peek-meta></span>
        <span class="bowl__read" data-peek-read hidden>Read</span>
      </p>
      <p class="bowl__ask" data-peek-ask></p>
      <p class="bowl__go-hint">Click the piece to read it</p>
    </div>

    {/* A piece, lifted out of the bowl: on touch, from "Pick one for me", or
        from an article's own bowl. Filled by scripts/bowl.ts. */}
    <div class="bowl__card" data-bowl-card role="dialog" aria-modal="false" aria-labelledby="bowl-card-ask" hidden>
      <button type="button" class="bowl__x" data-card-close aria-label="Put the piece back">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3L13 13M13 3L3 13" /></svg>
      </button>
      <div class="bowl__frame">
        <svg class="bowl__art" viewBox="0 0 1600 900" data-card-art aria-hidden="true"></svg>
        <img data-card-img alt="The artwork of the piece lifted out of the bowl" decoding="async" />
      </div>
      <p class="bowl__ck">
        <span class="bowl__dot" aria-hidden="true"></span><span data-card-track></span>
        <span class="bowl__read" data-card-read hidden>Already in your bowl</span>
      </p>
      <p class="bowl__ask" id="bowl-card-ask" data-card-ask></p>
      <p class="bowl__ct" data-card-title></p>
      <div class="bowl__acts">
        <a class="bowl__go" data-card-go href="/">Read this piece <span aria-hidden="true">→</span></a>
        <button type="button" class="bowl__another" data-card-another>Another one</button>
      </div>
    </div>
  </div>

  {/* The way into an article (scripts/bowl-warp.ts). Moved to <body> when used. */}
  <div class="warp" data-warp hidden aria-hidden="true">
    <div class="warp__veil"></div>
    <svg class="warp__seam" viewBox="0 0 100 100" preserveAspectRatio="none">
      <polyline points="-2,58 14,55 22,61 37,52 49,57 58,49 71,55 83,47 102,52" pathLength="1" />
    </svg>
    <div class="warp__art" data-warp-art><svg viewBox="0 0 1600 900"></svg></div>
    <div class="warp__crew" data-warp-crew>
      <CrewActor who="tsugi" moods={['idle', 'happy']} />
      <CrewActor who="oops" moods={['idle', 'happy']} />
      <CrewActor who="kiki" moods={['idle', 'happy']} />
      <CrewActor who="fude" moods={['idle', 'happy']} />
      <CrewActor who="uso" moods={['idle', 'happy']} />
    </div>
  </div>

  <figcaption>
    <p class="bowl__now" data-bowl-now></p>
    {/* Who is on the piece being previewed. Filled by the page. */}
    <slot />
    <div class="bowl__bar" data-bowl-bar hidden>
      <button type="button" class="bowl__pick" data-bowl-pick>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.5a7.5 7.5 0 1 1-7.1 5.1M2.6 3.2l.3 4.5 4.4-1" /></svg>
        Pick one for me
      </button>
      <span class="bowl__progress" data-bowl-progress></span>
    </div>
    <p class="bowl__talk" data-bowl-talk>
      <span class="bowl__key" id="bowl-help" data-quiet>
        Each piece is one article. The oldest are at the foot, every new one goes
        in at the rim, and the faint outline is where the bowl grows
        next.<span class="bowl__how" data-bowl-how></span>
      </span>
      <span class="crew-line" data-say aria-live="polite"></span>
    </p>
  </figcaption>
</figure>

<style is:global>
  /* ---------- the bowl's own materials ----------
     Pale glazed stoneware on paper, dark raku on the dark page, with an
     unglazed clay foot. All of it is mixed from the site's tokens, so the bowl
     re-skins with the theme and shares the page's palette. */
  .bowl {
    --glaze: color-mix(in srgb, var(--stone) 92%, var(--ink));
    --glaze-hi: var(--paper);
    --glaze-lo: color-mix(in srgb, var(--stone) 76%, var(--ink));
    --glaze-gleam: var(--paper);
    --clay: color-mix(in srgb, var(--ochre) 42%, var(--stone));
    --clay-hi: color-mix(in srgb, var(--ochre) 28%, var(--paper));
    --clay-lo: color-mix(in srgb, var(--ochre) 70%, var(--ink));
    --bowl-in: var(--paper-2);
    --bowl-shadow: var(--ink);
    --well: .45;
    --piece-ink: multiply;
  }
  :root[data-theme='dark'] .bowl {
    --glaze: color-mix(in srgb, var(--stone) 86%, var(--ink));
    --glaze-hi: color-mix(in srgb, var(--stone) 72%, var(--ink));
    --glaze-lo: var(--paper);
    --glaze-gleam: color-mix(in srgb, var(--ink) 55%, var(--stone));
    --clay: color-mix(in srgb, var(--ochre) 20%, var(--stone));
    --clay-hi: color-mix(in srgb, var(--ochre) 28%, var(--stone));
    --clay-lo: color-mix(in srgb, var(--ochre) 12%, var(--paper));
    --bowl-in: color-mix(in srgb, var(--paper-2) 90%, var(--ink));
    --bowl-shadow: black;
    --well: .34;
    --piece-ink: screen;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .bowl {
      --glaze: color-mix(in srgb, var(--stone) 86%, var(--ink));
      --glaze-hi: color-mix(in srgb, var(--stone) 72%, var(--ink));
      --glaze-lo: var(--paper);
      --glaze-gleam: color-mix(in srgb, var(--ink) 55%, var(--stone));
      --clay: color-mix(in srgb, var(--ochre) 20%, var(--stone));
      --clay-hi: color-mix(in srgb, var(--ochre) 28%, var(--stone));
      --clay-lo: color-mix(in srgb, var(--ochre) 12%, var(--paper));
      --bowl-in: color-mix(in srgb, var(--paper-2) 90%, var(--ink));
      --bowl-shadow: black;
      --well: .34;
      --piece-ink: screen;
    }
  }

  .bowl { position: relative; margin: 0; --glaze-in: var(--bowl-in); }

  /* ---------- the bowl built from its pieces (3D) ---------- */
  .bowl__3d, .bowl__table { display: none; }
  .bowl.gl3d .bowl__body { aspect-ratio: 220 / 172; border-radius: 30%; }
  .bowl.gl3d .bowl__3d { display: block; position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; }
  .bowl.gl3d .bowl__outside, .bowl.gl3d .bowl__inside, .bowl.gl3d .bowl__rimplane { display: none; }
  .bowl.gl3d .bowl__table {
    display: block; position: absolute; left: 22%; right: 22%; bottom: 7%; height: 9%;
    border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--bowl-shadow) 38%, transparent), transparent);
  }
  html.js .bowl.gl3d { padding-top: 2%; }
  /* Room above the far rim for whoever stands on it. */
  html.js .bowl { padding-top: 9%; }
  .bowl__body { position: relative; aspect-ratio: 1000 / 840; outline: none; border-radius: 40% 40% 30% 30%; }
  .bowl__body:focus-visible { box-shadow: 0 0 0 3px var(--paper), 0 0 0 5px var(--gold); }
  .bowl svg { display: block; overflow: visible; }
  .bowl__outside { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bowl__pool { fill: none; stroke: var(--glaze-gleam); stroke-opacity: .35; stroke-width: 5; stroke-linecap: round; }
  .bowl__drip { fill: var(--glaze-lo); opacity: .3; }
  .bowl__grain { opacity: .9; }
  .bowl__crack { fill: none; stroke: color-mix(in srgb, var(--gold) 75%, black); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; }
  .bowl__crack-lit { fill: none; stroke: color-mix(in srgb, var(--gold) 55%, white); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; opacity: .85; }

  /* The inside: a 1000-unit square tipped back about its centre, which sits on
     the rim's centre in the body's frame. */
  /* The inside is seen only through the rim: the floor's near edge goes behind the lip. */
  .bowl__inside {
    position: absolute; inset: 0; pointer-events: none;
    clip-path: ellipse(var(--rim-rx) var(--rim-ry) at 50% var(--rim-cy));
  }
  .bowl__inside .bowl__disc { pointer-events: auto; }
  .bowl__disc, .bowl__rimplane {
    position: absolute; left: 0; top: var(--disc-top); width: 100%; aspect-ratio: 1;
    transform-origin: 50% 50%;
  }
  .bowl__disc { transform: translateY(var(--floor-drop)) rotateX(58deg) scale(var(--floor-scale)); }
  .bowl__rimplane { transform: rotateX(58deg); pointer-events: none; }
  .bowl__rimplane svg { width: 100%; height: 100%; }
  .bowl__floor, .bowl__inner { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bowl__inner { pointer-events: none; }
  .bowl__base { fill: var(--bowl-in); }
  .bowl__lip { fill: none; stroke: url(#bowl-lip); stroke-width: 15; }
  .bowl__lip-edge { fill: none; stroke: var(--bowl-shadow); stroke-opacity: .22; stroke-width: 2.5; }
