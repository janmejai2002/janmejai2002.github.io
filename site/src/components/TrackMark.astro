---
/**
 * The five theme marks. Each is a complete order with exactly one break in it;
 * the parent closes the break on hover or selection. See docs/ARTWORK.md.
 */
import type { TrackId } from '../data/tracks';
interface Props {
  id: TrackId;
}
const { id } = Astro.props;
---

{id === 'technical' && (
  <svg viewBox="0 0 120 120" fill="none" aria-hidden="true">
    <circle class="ring" cx="60" cy="60" r="34" stroke="currentColor" stroke-width="3" pathLength="100" />
    <circle cx="60" cy="60" r="4" fill="currentColor" />
    <path d="M60 12v10M108 60H98M60 108V98M12 60h10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
  </svg>
)}
{id === 'business' && (
  <svg viewBox="0 0 120 120" fill="none" aria-hidden="true">
    <g class="grid" fill="currentColor">
      {[26, 47, 68, 89].map((y) => [26, 47, 68, 89].map((x) => <circle cx={x} cy={y} r="4" />))}
    </g>
    <circle class="stray" cx="89" cy="26" r="4" fill="currentColor" />
  </svg>
)}
{id === 'case-studies' && (
  <svg viewBox="0 0 120 120" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="9" stroke-linecap="butt">
      <path d="M22 96V74" />
      <path d="M44 96V60" />
      <path d="M66 96V80" />
      <path class="stray" d="M88 96V38" />
    </g>
    <path d="M10 96h100" stroke="currentColor" stroke-width="3" />
  </svg>
)}
{id === 'talks' && (
  <svg viewBox="0 0 120 120" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round">
      <path class="arc a1" d="M34 96a34 34 0 0 1 52 0" pathLength="100" />
      <path class="arc a2" d="M22 78a52 52 0 0 1 76 0" pathLength="100" />
      <path class="arc a3" d="M10 60a68 68 0 0 1 100 0" pathLength="100" />
    </g>
    <circle cx="60" cy="103" r="4.5" fill="currentColor" />
  </svg>
)}
{id === 'basics' && (
  <svg viewBox="0 0 120 120" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="3" stroke-linecap="square">
      <path class="arc a1" d="M14 98h26v-22" pathLength="100" />
      <path class="arc a2" d="M40 76h26v-22" pathLength="100" />
      <path class="arc a3" d="M66 54h26v-22" pathLength="100" />
    </g>
    <circle cx="14" cy="98" r="4.5" fill="currentColor" />
  </svg>
)}
