---
const { posts } = Astro.props;
const dateOf = (d: Date) =>
  d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---

<ol class="plist">
  {
    posts.map((post: any) => (
      <li>
        <a href={`/blog/${post.id}/`}>
          {post.data.question && <p class="plist__q">{post.data.question}</p>}
          <h2 class="plist__t">{post.data.title}</h2>
          <p class="plist__d">{post.data.description}</p>
          <time class="plist__m" datetime={post.data.pubDate.toISOString()}>
            {dateOf(post.data.pubDate)}
          </time>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .plist { list-style: none; margin: 2rem 0 0; padding: 0; }
  .plist li { border-top: 1px solid var(--border); }
  .plist a { display: block; padding: 1.25rem 0; color: inherit; text-decoration: none; }
  .plist__q { margin: 0 0 .35rem; font-size: .8125rem; color: var(--ink-soft); }
  .plist__t { margin: 0 0 .4rem; font-size: 1.15rem; line-height: 1.3; }
  .plist a:hover .plist__t { color: var(--mizu); }
  .plist__d { margin: 0 0 .5rem; font-size: .9rem; line-height: 1.55; color: var(--ink-soft); }
  .plist__m { font-size: .6875rem; color: var(--ink-faint); }
</style>
