---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TrackMark from '../components/TrackMark.astro';
import Bowl from '../components/Bowl.astro';
import Crew from '../components/Crew.astro';
import CrewActor from '../components/CrewActor.astro';
import { TRACKS } from '../data/tracks';
import { CLAIMS } from '../data/claims';
import { plateEdge, EDGE_DEPTH } from '../lib/bowl';
import { pickCrew, WHO, type Mood, type Who } from '../lib/crew';
import { newestFirst } from '../lib/posts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  newestFirst
);

const slugOf = (p: (typeof posts)[number]) => p.id.replace(/\.md$/, '');
const dateOf = (d: Date) =>
  d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const trackOf = Object.fromEntries(TRACKS.map((t) => [t.id, t]));
const counts = Object.fromEntries(
  TRACKS.map((t) => [t.id, posts.filter((p) => p.data.track === t.id).length])
);

/* The same zigzag for every claim, moved to that claim's seam. One shape drives
   the two clip-paths and the drawn line, so the pieces always meet on it. */
const JAG = [
  [1.2, 0],
  [-0.9, 18],
  [1.6, 41],
  [-1.4, 63],
  [0.7, 82],
  [-0.5, 100],
];
const seamOf = (x: number) => JAG.map(([dx, y]) => [+(x + dx).toFixed(2), y] as const);
// A renamed or retired post drops out of the hero instead of failing the build:
// publishing is automated, and one stale slug must never be able to block it.
const live = CLAIMS.flatMap((c) => {
  const post = posts.find((p) => slugOf(p) === c.slug);
  if (!post) console.warn(`claims.ts: skipping missing post ${c.slug}`);
  return post ? [{ c, post }] : [];
});

/* One article per track, picked at random on each visit (the inline script
   after the cues). The page ships a small pool per track: its hand-written
   claims from claims.ts, plus its newest posts, which use their Reader Question
   as the line and their meta description as the finding. */
const POOL_PER_TRACK = 4;
const handSlugs = new Set(live.map(({ c }) => c.slug));
const seamFor = (slug: string) => 36 + ([...slug].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) >>> 0, 7) % 12);
const pool = TRACKS.flatMap((t) => [
  ...live.filter(({ post }) => post.data.track === t.id).map(({ c, post }) => ({ ...c, kind: 'claim' as const, post })),
  ...posts
    .filter((p) => p.data.track === t.id && !handSlugs.has(slugOf(p)))
    .slice(0, POOL_PER_TRACK)
    .map((p) => ({
      slug: slugOf(p),
      subject: t.label,
      claim: p.data.question ?? p.data.title,
      mend: p.data.description,
      seam: seamFor(slugOf(p)),
      kind: 'question' as const,
      post: p,
    })),
]);
if (!pool.length) throw new Error('index.astro: no published post for the hero');
const claims = pool.map(({ post, ...c }) => {
  const pts = seamOf(c.seam);
  const edge = pts.map(([x, y]) => `${x}% ${y}%`);
  const first = pts[0][0];
  const last = pts[pts.length - 1][0];
  return {
    ...c,
    label: c.kind === 'claim' ? 'Claimed' : 'The question',
    long: c.claim.length > 60,
    trackId: post.data.track,
    href: `/blog/${c.slug}/`,
    accent: trackOf[post.data.track].accent,
    track: trackOf[post.data.track].label,
    line: pts.map(([x, y]) => `${x},${y}`).join(' '),
    left: `polygon(-4% -25%, ${first}% -25%, ${edge.join(', ')}, ${last}% 125%, -4% 125%)`,
    right: `polygon(104% -25%, ${first}% -25%, ${edge.join(', ')}, ${last}% 125%, 104% 125%)`,
  };
});

const INITIAL_ROWS = 8;

// Every piece has one of the crew on it, cast from its own title and keywords:
// the same character the reader meets in the piece. Each seat below only draws
// the moods its character is actually cast in.
const castOf = Object.fromEntries(
  posts.map((p) => {
    const c = pickCrew({ slug: slugOf(p), title: p.data.title, question: p.data.question, keywords: p.data.keywords, track: p.data.track });
    return [slugOf(p), c];
  })
);
const castMoods = Object.fromEntries(
  WHO.map((w) => [w, [...new Set(Object.values(castOf).filter((c) => c.who === w).map((c) => c.mood))]])
) as Record<Who, Mood[]>;

// The same broken, gold-seamed edge the article plates have.
const edge = plateEdge('home');
const edgeClip = `polygon(0 0,100% 0,${[...edge].reverse().map(([x, d]) => `${x.toFixed(1)}% calc(100% - ${d.toFixed(1)}px)`).join(',')})`;
const edgeLine = edge.map(([x, d]) => `${(x * 10).toFixed(0)},${(EDGE_DEPTH - d).toFixed(1)}`).join(' ');
---

<Base
  title="wAIbi-sabi — Applied AI, in practice"
  description="wAIbi-sabi: an applied-AI journal. What benchmarks leave out, what breaks in production, and what the research says past the abstract."
  section="Applied AI"
  wide
  immersive
>
  <section class="plate" aria-labelledby="thesis" style={`clip-path:${edgeClip}`}>
    <div class="wrap plate__in">
      <header class="plate__id">
        <h1 id="thesis">The models are never finished<span class="plate__caret" aria-hidden="true"></span></h1>
        <p>
          Writing about AI that shows its working: what the benchmarks leave out, what breaks
          in production, and which parts do not hold up.
        </p>
      </header>

      <div class="stage" data-stage>
        <div class="claims" data-claims>
          {claims.map((c, n) => (
            <div class:list={['claim', c.long && 'claim--long', n === 0 && 'on', n === 0 && 'play']} data-claim={n} data-seam={c.seam} data-track={c.trackId}>
              <span class="claim__k">{c.label}</span>
              <span class="claim__said">
                <span class="sr">{c.claim}</span>
                <span class="claim__pc claim__pc--l" style={`clip-path:${c.left}`} aria-hidden="true">{c.claim}</span>
                <span class="claim__pc claim__pc--r" style={`clip-path:${c.right}`} aria-hidden="true">{c.claim}</span>
                <svg class="claim__seam" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  <polyline points={c.line} vector-effect="non-scaling-stroke" />
                </svg>
              </span>
              <span class="claim__mend">
                <span class="claim__k claim__k--gold">What the article found</span>
                <span class="claim__fix">{c.mend}</span>
                <a class="claim__go" href={c.href}>Read the {c.track.toLowerCase()} piece <span aria-hidden="true">→</span></a>
              </span>
            </div>
          ))}
        </div>

        <div class="cues" data-cues>
          {claims.map((c, n) => (
            <button
              type="button"
              class:list={['cue', n === 0 && 'cue--on']}
              data-cue={n}
              data-track={c.trackId}
              aria-pressed={n === 0 ? 'true' : 'false'}
              style={`--accent:var(--${c.accent})`}
            >
              <span class="cue__dot" aria-hidden="true"></span>{c.subject}
              <span class="cue__bar" aria-hidden="true"></span>
            </button>
          ))}
          <div class="seat on-plate" data-seat hidden>
            <div class="seat__who">
              <CrewActor who="oops" moods={['idle', 'swing', 'panic', 'sideeye']} />
              <CrewActor who="tsugi" moods={['idle', 'paint', 'proud']} />
              <CrewActor who="kiki" moods={['listen', 'happy']} />
            </div>
            <span class="seat__text" aria-live="polite"><span class="seat__hint" data-quiet data-hint></span><span class="crew-line" data-say></span></span>
          </div>
          <button type="button" class="cue-pause" data-pause>Pause</button>
        </div>
        {/* One claim per track, chosen at random on every visit. Inline and
            synchronous, so it runs before first paint and before the page
            script below reads the claims (it maps cues to claims by position). */}
        <script is:inline>
          (function () {
            var claims = [].slice.call(document.querySelectorAll('[data-claim]'));
            var cues = [].slice.call(document.querySelectorAll('[data-cue]'));
            var groups = {};
            claims.forEach(function (el, i) { (groups[el.dataset.track] = groups[el.dataset.track] || []).push(i); });
            var keep = {};
            Object.keys(groups).forEach(function (t) { var g = groups[t]; keep[g[Math.floor(Math.random() * g.length)]] = true; });
            var n = 0;
            claims.forEach(function (el, i) {
              if (!keep[i]) { el.remove(); if (cues[i]) cues[i].remove(); return; }
              var first = n === 0;
              el.dataset.claim = String(n);
              el.classList.toggle('on', first);
              el.classList.toggle('play', first);
              if (cues[i]) {
                cues[i].dataset.cue = String(n);
                cues[i].classList.toggle('cue--on', first);
                cues[i].setAttribute('aria-pressed', first ? 'true' : 'false');
              }
              n++;
            });
          })();
        </script>
      </div>
    </div>

  </section>
  {/* The broken edge is the crew's stage: they stand on the gold line itself. */}
  <div class="edge-stage" data-edge-stage data-edge={edgeLine} data-depth={EDGE_DEPTH} aria-hidden="true">
    <svg class="plate-edge" viewBox={`0 0 1000 ${EDGE_DEPTH}`} preserveAspectRatio="none">
      <polyline points={edgeLine} vector-effect="non-scaling-stroke" />
    </svg>
    <svg class="plate-edge plate-edge--lit" viewBox={`0 0 1000 ${EDGE_DEPTH}`} preserveAspectRatio="none" data-edge-lit>
      <polyline points={edgeLine} vector-effect="non-scaling-stroke" />
    </svg>
    <span class="edge-board" data-board>
      <svg viewBox="0 0 60 12"><path d="M2 7L9 3L31 2L52 3L58 6L50 9L28 10L8 10Z" /><path class="edge-board__seam" d="M20 3L24 6L21 9M41 3L38 6L42 9" /></svg>
    </span>
    <CrewActor who="kiki" moods={['happy']} />
    <CrewActor who="tsugi" moods={['paint', 'proud', 'idle']} />
    <CrewActor who="oops" moods={['swing', 'panic']} />
    <CrewActor who="uso" moods={['idle', 'doubt', 'sideeye']} />
    <CrewActor who="fude" moods={['idle', 'scribble']} />
  </div>

  <section class="reader wrap" aria-labelledby="reader-h" id="writing">
    <a class="again" data-again hidden href="/">
      <span class="again__k">Pick up where you left off</span>
      <span class="again__ask" data-again-ask></span>
      <span class="again__at" data-again-at></span>
    </a>
    <div class="reader__top">
      <h2 id="reader-h">What are you trying to work out?</h2>
      <div class="find">
        <label for="find-q">Search {posts.length} questions</label>
        <div class="find__box">
          <input id="find-q" type="search" autocomplete="off" placeholder="cost, latency, Klarna…" data-find />
          <kbd aria-hidden="true">/</kbd>
        </div>
      </div>
    </div>

    <div class="doors" role="group" aria-label="Filter by what you are here for">
      {TRACKS.map((t) => (
        <button
          type="button"
          class="door"
          data-door={t.id}
          data-label={t.label}
          data-blurb={t.blurb}
          aria-pressed="false"
          style={`--accent:var(--${t.accent});--tint:var(--wash-${t.accent})`}
        >
          <span class="door__mark"><TrackMark id={t.id} /></span>
          <span class="door__label">{t.label}<span class="door__n">{counts[t.id]}</span></span>
          <span class="door__ask">{t.ask}</span>
        </button>
      ))}
    </div>

    <div class="status">
      <p class="status__text" data-status aria-live="polite">Everything, newest first.</p>
      <button type="button" class="linkish" data-reset hidden>Show everything</button>
      <a class="linkish" data-theme-link href="/" hidden>This theme's own page →</a>
    </div>

    <div class="shelf">
      <ol class="qs" data-qs>
        {posts.map((post, n) => {
          const t = trackOf[post.data.track];
          const hay = `${post.data.question ?? ''} ${post.data.title} ${post.data.description} ${t.label}`.toLowerCase();
          return (
            <li
              class="q"
              data-q={slugOf(post)}
              data-track={post.data.track}
              data-hay={hay}
              data-d={post.data.description}
              style={`--accent:var(--${t.accent})`}
              data-extra={n >= INITIAL_ROWS ? '' : undefined}
              data-at={post.data.pubDate.valueOf()}
              data-who={castOf[slugOf(post)].who}
              data-mood={castOf[slugOf(post)].mood}
            >
              <a href={`/blog/${slugOf(post)}/`}>
                <span class="q__ask">{post.data.question ?? post.data.title}</span>
                <span class="q__title">{post.data.title}</span>
                <span class="q__meta">
                  <span class="q__dot" aria-hidden="true"></span>{t.label}
                  {post.data.readingTime && <span> · {post.data.readingTime.replace(' read', '')}</span>}
                  <span> · <time datetime={post.data.pubDate.toISOString()}>{dateOf(post.data.pubDate)}</time></span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>

      <aside class="pv">
        <Bowl posts={posts}>
          <span class="pv__who" data-pv-who hidden>
            <span class="seat__who">
              {WHO.filter((w) => castMoods[w].length).map((w) => <CrewActor who={w} moods={castMoods[w]} />)}
            </span>
            <span class="pv__with" data-pv-with></span>
          </span>
        </Bowl>
      </aside>
    </div>

    <p class="empty-q" data-none hidden>
      <Crew who="oops" mood="shrug" class="empty-q__crew" />
      No question matches that yet. Try a broader word, or <button type="button" class="linkish" data-clear>clear the search</button>.
    </p>
    <button type="button" class="more" data-more hidden></button>
  </section>

  <section class="working" aria-labelledby="working-h">
    <div class="wrap working__in">
      <div class="working__text">
        <h2 id="working-h">You should know how this gets made.</h2>
        <p>
          Scheduled routines find the topics, research them, draft them and draw the art. A
          person decides which of those parts get to reach you.
        </p>
        <a class="linkish" href="/blog/how-this-blog-builds-itself/">How this blog builds itself →</a>
      </div>

      <div class="flow" role="img" aria-label="Topics are found, researched and drafted by routines. Technical and Business pieces then wait for a human sign-off. Talks, Case Studies and Basics publish on their own.">
        <ol class="flow__steps" aria-hidden="true">
          <li>Found</li>
          <li>Researched</li>
          <li>Drafted</li>
        </ol>
        <div class="flow__lanes" aria-hidden="true">
          <div class="lane lane--human">
            <span class="lane__seal">Human<br />sign-off</span>
            <span class="lane__who">Technical, Business</span>
            <span class="lane__end">Published</span>
          </div>
          <div class="lane">
            <span class="lane__who">Talks, Case Studies, Basics</span>
            <span class="lane__end">Published</span>
          </div>
        </div>
      </div>

      <div class="author">
        <h3>Janmejai Singh Minhas</h3>
        <p>
          I build machine learning systems that have to work outside a notebook, and I break
          other people's. Medical imaging, credit risk models at American Express, and
          red-teaming frontier models, where I rank #352 on Gray Swan.
        </p>
        <a class="linkish" href="/about/">More about me →</a>
      </div>
    </div>
  </section>

  <section class="wrap bschool">
    <div>
      <h2>BSchool News Archive</h2>
      <p>
        A daily business-news digest for Indian B-school placement prep. Each story comes with
        the angle an interviewer is likely to push on.
      </p>
    </div>
    <a href="/news/" class="bschool__go">Browse the archive <span aria-hidden="true">→</span></a>
  </section>
</Base>

<script>
  import { createPlate } from '../scripts/kintsugi';
  import { createCast } from '../lib/crew-actor';
  import { createEdgeStage, type SceneName } from '../scripts/edge-scenes';
  import { createDirector, fill, choose } from '../lib/crew-director';
  import { linesFor, JOB, type Moment } from '../lib/crew-lines';

  const CAP = 8;
  const DWELL_END = 'cue-fill';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touch = matchMedia('(hover: none)').matches;

  /* ---------- the cracked claim ---------- */
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const claimEls = [...document.querySelectorAll<HTMLElement>('[data-claim]')];
  const cues = [...document.querySelectorAll<HTMLButtonElement>('[data-cue]')];
  const pause = document.querySelector<HTMLButtonElement>('[data-pause]');
  const claimsBox = document.querySelector<HTMLElement>('[data-claims]');
  const plateEl = document.querySelector<HTMLElement>('.plate');
  const seatEl = document.querySelector<HTMLElement>('[data-seat]');
  const hint = document.querySelector<HTMLElement>('[data-hint]');

  let current = 0;
  let auto = false;

  // Null without WebGL2, in which case the CSS crack below it stays in charge.
  const plate = plateEl ? createPlate({ plate: plateEl, claims: claimEls, reduced }) : null;

  /* ---------- the crew's seat ----------
     One place in the layout, at the end of the cue row. Oops sits there with
     his hammer, which is the invitation. Breaking a claim leaves the crack
     open; the reader pours the gold by holding the plate, and the finding is
     written in as the gold goes in. If they don't, Tsugi does it for them. */
  const cast = seatEl ? createCast(seatEl, { reduced }) : null;
  const director = createDirector({
    gapMs: 8000,
    budget: 3,
    rules: {
      'new-since': { once: true, priority: true },
      'mended-reader': { cooldownMs: 30000 },
      'strike-again': { once: true },
    },
  });
  const HINT = {
    rest: touch ? 'Tap the plate to break the next claim' : 'Click the plate to break the next claim',
    open: touch ? 'Press and hold the plate to pour the gold' : 'Hold the mouse down on the plate to pour the gold',
    mending: 'Tsugi is mending it',
  };
  const setHint = (text: string) => {
    if (hint) hint.textContent = text;
  };
  // Characters who have hopped down onto the edge are not in the seat.
  const away = new Set<string>();
  /** Whoever sits in the seat now, in which mood. The others fade out. */
  const sit = (who: string, mood: string) => {
    if (!cast) return;
    for (const id of ['oops', 'tsugi', 'kiki']) {
      const a = cast.get(id);
      if (!a) continue;
      if (id === who && !away.has(id)) {
        a.mood(mood);
        a.show();
      } else a.hide();
    }
  };
  const speak = (moment: Moment, who: string, vars: Record<string, number> = {}, ms = 4600) => {
    const a = cast?.get(who);
    const options = linesFor(moment, who as never);
    if (!cast || !a || !options.length || !director.take(moment, performance.now())) return false;
    cast.say(a, fill(choose(options, `${moment}:${Math.floor(Date.now() / 6e4)}`), vars), ms);
    return true;
  };

  /* ---------- scenes on the edge below the plate ---------- */
  const edgeEl = document.querySelector<HTMLElement>('[data-edge-stage]');
  const edgeCast = edgeEl ? createCast(edgeEl, { reduced }) : null;
  const edge = edgeEl && edgeCast
    ? createEdgeStage({
        stage: edgeEl,
        cast: edgeCast,
        reduced,
        depth: Number(edgeEl.dataset.depth ?? 22),
        points: (edgeEl.dataset.edge ?? '').split(' ').map((p) => p.split(',').map(Number) as [number, number]),
        // A character sitting in the seat hops down from where they sit.
        seatOf: (who) => {
          const a = cast?.get(who);
          if (!a?.visible || !seatEl || seatEl.hidden) return null;
          const r = a.el.getBoundingClientRect();
          const b = edgeEl.getBoundingClientRect();
          return { x: r.left + r.width / 2 - b.left, y: r.bottom - b.top - r.height * 0.06 };
        },
        onSeat: (who, gone) => {
          if (gone) {
            away.add(who);
            cast?.get(who)?.hide();
            return;
          }
          away.delete(who);
          const someone = ['oops', 'tsugi', 'kiki'].some((id) => cast?.get(id)?.visible);
          if (phase === 'whole' && !someone) rest();
        },
      })
    : null;
  // Ambient scenes give way to a reader who is busy with the plate.
  let touchedAt = -Infinity;
  plateEl?.addEventListener('pointerdown', () => (touchedAt = performance.now()));
  const scene = (name?: SceneName) => {
    if (!edge || !edge.inView) return;
    if (!name && performance.now() - touchedAt < 6000) return;
    if (name) edge.play(name, true);
    else edge.playFresh();
  };

  /* The repair, as a small state machine. 'whole' is the resting state. */
  type Phase = 'whole' | 'breaking' | 'open' | 'mending';
  let phase: Phase = 'whole';
  let gold = 0; // 0..1 of the plate's full gold reach
  let poured = 0; // the reader's share of it
  let pouring = false;
  let lastPour = 0;
  let wholeAt = 0;
  let strikes = 0;
  let downOnBreak = false;
  let brush = { x: 0, y: 0, speed: 0 };
  let loop = 0;
  let lastTick = 0;
  let restTimer = 0;
  const STALL = 2400; // how long Tsugi waits before helping
  const BREAK = 1250; // the crack has finished spreading (kintsugi.ts OUT + break)

  const setMend = (v: number) => claimEls[current]?.style.setProperty('--mend', v.toFixed(3));

  const rest = () => {
    clearTimeout(restTimer);
    sit('oops', 'idle');
    setHint(HINT.rest);
  };

  const close = (byReader: boolean) => {
    phase = 'whole';
    wholeAt = performance.now();
    pouring = false;
    gold = 1;
    plate?.setGoldProgress(1);
    setMend(1);
    claimEls[current]?.classList.remove('held');
    if (byReader) {
      try {
        localStorage.setItem('waibi:mended', String(Number(localStorage.getItem('waibi:mended') ?? 0) + 1));
      } catch {
        // Private windows can refuse storage. Nothing depends on it.
      }
    }
    sit('tsugi', 'proud');
    const spoke = byReader && speak('mended-reader', 'tsugi');
    setHint(HINT.rest);
    restTimer = window.setTimeout(rest, spoke ? 4800 : 1800);
    // Pleased with the repair, Tsugi goes down to see to the edge as well.
    window.setTimeout(() => scene('gild'), spoke ? 1500 : 900);
  };

  const tick = (now: number) => {
    loop = 0;
    if (phase !== 'open' && phase !== 'mending') return;
    const dt = Math.min(0.05, (now - lastTick) / 1000);
    lastTick = now;
    let add = 0;
    if (pouring) {
      // A still hold pours steadily; brushing back and forth pours faster.
      add = dt * (0.3 + Math.min(0.4, brush.speed / 1800));
      poured += add;
      brush.speed *= 0.9;
      lastPour = now;
    } else if (phase === 'open' && now - lastPour > STALL) {
      phase = 'mending';
      sit('tsugi', 'paint');
      setHint(HINT.mending);
    }
    if (phase === 'mending' && !pouring) add = dt * 0.4;
    gold = Math.min(1, gold + add);
    plate?.setGoldProgress(gold);
    setMend(gold);
    if (gold >= 1) {
      close(poured / Math.max(gold, 1e-6) >= 0.5);
      return;
    }
    loop = requestAnimationFrame(tick);
  };
  const run = () => {
    if (loop) return;
    lastTick = performance.now();
    loop = requestAnimationFrame(tick);
  };

  /** Leave any open repair, finished, before a different claim is shown. */
  const abandon = () => {
    if (phase === 'whole') return;
    cancelAnimationFrame(loop);
    loop = 0;
    phase = 'whole';
    pouring = false;
    setMend(1);
    claimEls[current]?.classList.remove('held');
    rest();
  };

  const syncAuto = () => {
    stage?.classList.toggle('auto', auto);
    if (pause) {
      pause.textContent = auto ? 'Pause' : 'Play';
      pause.setAttribute('aria-pressed', String(!auto));
    }
  };

  /** Show claim n. `held` leaves its crack open for the reader to mend. */
  const show = (n: number, at?: { x: number; y: number }, held = false) => {
    abandon();
    current = n;
    claimEls.forEach((el, i) => {
      el.classList.toggle('on', i === n);
      el.classList.remove('play', 'held');
    });
    cues.forEach((c, i) => {
      c.classList.toggle('cue--on', i === n);
      c.setAttribute('aria-pressed', String(i === n));
    });
    const hold = held && !!plate && !reduced;
    plate?.strike(n, at, hold);
    if (!reduced) {
      void claimEls[n].offsetWidth;
      claimEls[n].classList.add('play');
    }
    if (!hold) return;

    // Oops did it. The swing lands as the crack starts to spread.
    strikes++;
    gold = poured = 0;
    phase = 'breaking';
    claimEls[n].classList.add('held');
    setMend(0);
    clearTimeout(restTimer);
    cast?.hush();
    sit('oops', 'swing');
    cast?.get('oops')?.act('hit', 360);
    window.setTimeout(() => {
      if (phase !== 'breaking' || current !== n) return;
      sit('oops', 'panic');
      // The first time, and now and then after, he makes a run for it.
      if (strikes === 1 || Math.random() < 0.35) window.setTimeout(() => scene('tumble'), 260);
    }, 420);
    window.setTimeout(() => {
      if (phase !== 'breaking' || current !== n) return;
      phase = 'open';
      lastPour = performance.now();
      setHint(HINT.open);
      if (strikes >= 3 && !pouring) {
        sit('oops', 'sideeye');
        if (speak('strike-again', 'oops', {}, 3000)) {
          window.setTimeout(() => phase === 'open' && current === n && sit('tsugi', 'idle'), 3000);
        } else sit('tsugi', 'idle');
      } else sit('tsugi', 'idle');
      run();
    }, BREAK);
  };

  // Pouring: hold anywhere on the plate that isn't a link or a button.
  const onPlate = (e: Event) => !(e.target as HTMLElement).closest('a, button, input');
  plateEl?.addEventListener('pointerdown', (e) => {
    downOnBreak = phase !== 'whole';
    if (!downOnBreak || !onPlate(e) || e.button > 0) return;
    pouring = true;
    brush = { x: e.clientX, y: e.clientY, speed: 0 };
    if (phase === 'mending') {
      phase = 'open';
      sit('tsugi', 'idle');
      setHint(HINT.open);
    }
    run();
  });
  addEventListener('pointermove', (e) => {
    cast?.look({ x: e.clientX, y: e.clientY });
    if (!pouring) return;
    brush.speed = Math.min(3000, brush.speed * 0.6 + Math.hypot(e.clientX - brush.x, e.clientY - brush.y) * 24);
    brush.x = e.clientX;
    brush.y = e.clientY;
  }, { passive: true });
  const lift = () => {
    if (!pouring) return;
    pouring = false;
    lastPour = performance.now();
  };
  addEventListener('pointerup', lift);
  addEventListener('pointercancel', lift);
  // Holding a finger still must not open a menu.
  plateEl?.addEventListener('contextmenu', (e) => {
    if (phase !== 'whole') e.preventDefault();
  });

  plateEl?.addEventListener('click', (e) => {
    if (!plate || !onPlate(e)) return;
    // The click that ends a pour is not a request to break the next claim.
    if (downOnBreak || phase !== 'whole' || performance.now() - wholeAt < 450) return;
    if (getSelection()?.toString()) return;
    auto = false;
    syncAuto();
    claimsBox?.setAttribute('aria-live', 'polite');
    show((current + 1) % claimEls.length, { x: e.clientX, y: e.clientY }, true);
  });

  cues.forEach((c, i) => {
    c.addEventListener('click', () => {
      auto = false;
      syncAuto();
      claimsBox?.setAttribute('aria-live', 'polite');
      show(i);
    });
    c.querySelector('.cue__bar')?.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName !== DWELL_END || !auto || i !== current) return;
      if (i === cues.length - 1) {
        auto = false;
        syncAuto();
        show(0);
      } else {
        show(i + 1);
      }
    });
  });

  pause?.addEventListener('click', () => {
    auto = !auto;
    syncAuto();
  });

  const hold = (on: boolean) => stage?.classList.toggle('held', on);
  stage?.addEventListener('pointerenter', () => hold(true));
  stage?.addEventListener('pointerleave', () => hold(false));
  stage?.addEventListener('focusin', () => hold(true));
  stage?.addEventListener('focusout', () => hold(false));
  if (reduced && pause) pause.hidden = true;
  syncAuto();

  if (seatEl && plate) {
    seatEl.hidden = false;
    rest();
  }

  /** Called once the question list knows what is new since the last visit. */
  const greet = (fresh: number) => {
    if (!seatEl || !plate || !fresh || phase !== 'whole') return;
    sit('kiki', 'listen');
    if (!speak('new-since', 'kiki', { n: fresh }, 5200)) return rest();
    restTimer = window.setTimeout(() => phase === 'whole' && rest(), 5400);
  };

  // When the edge comes into view (on landing, or scrolled to), and after a
  // quiet stretch while it is on screen, someone turns up on it.
  if (edgeEl && edge) {
    let first = true;
    new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      const delay = first ? 1900 : 450;
      first = false;
      window.setTimeout(() => phase === 'whole' && scene(), delay);
    }, { threshold: 0.6 }).observe(edgeEl);
    let quiet = 0;
    const stir = () => {
      clearTimeout(quiet);
      quiet = window.setTimeout(() => phase === 'whole' && scene(), 14000);
    };
    for (const ev of ['pointermove', 'pointerdown', 'scroll', 'keydown']) addEventListener(ev, stir, { passive: true });
    stir();
  }

  const startPlate = () => {
    claimEls.forEach((el, i) => {
      el.classList.toggle('on', i === 0);
      el.classList.remove('play');
    });
    cues.forEach((c, i) => {
      c.classList.toggle('cue--on', i === 0);
      c.setAttribute('aria-pressed', String(i === 0));
    });
    plate?.settle(0);
  };
  if (plate) document.fonts.load('800 80px Inter').then(startPlate, startPlate);

  /* ---------- the question list ---------- */
  const rows = [...document.querySelectorAll<HTMLElement>('[data-q]')];
  const doors = [...document.querySelectorAll<HTMLButtonElement>('[data-door]')];
  const find = document.querySelector<HTMLInputElement>('[data-find]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const reset = document.querySelector<HTMLElement>('[data-reset]');
  const clear = document.querySelector<HTMLElement>('[data-clear]');
  const none = document.querySelector<HTMLElement>('[data-none]');
  const more = document.querySelector<HTMLButtonElement>('[data-more]');
  const themeLink = document.querySelector<HTMLAnchorElement>('[data-theme-link]');
  const bowl = document.querySelector<HTMLElement>('[data-bowl]');
  const shards = [...document.querySelectorAll<SVGElement>('[data-shard]')];
  const bowlNow = document.querySelector<HTMLElement>('[data-bowl-now]');
  const rowOf = new Map(rows.map((r) => [r.dataset.q, r]));

  const state = { track: 'all', text: '', open: false };

  /* ---------- what this reader has already done here ----------
     All of it stays in their own browser. */
  const store = {
    get<T>(key: string, fallback: T): T {
      try {
        return (JSON.parse(localStorage.getItem(key) ?? 'null') as T) ?? fallback;
      } catch {
        return fallback;
      }
    },
    set(key: string, value: unknown) {
      try {
        localStorage.setItem(key, JSON.stringify(value));
      } catch {
        // Private windows can refuse storage. Nothing depends on it.
      }
    },
  };
  const flag = (row: HTMLElement | undefined, text: string) => {
    const meta = row?.querySelector('.q__meta');
    if (!meta) return;
    const el = document.createElement('span');
    el.className = 'q__flag';
    el.textContent = text;
    meta.append(el);
  };

  // Finished pieces turn gold in the bowl.
  const finished = store.get<string[]>('waibi:read', []).filter((s) => rowOf.has(s));
  for (const s of shards) if (finished.includes(s.dataset.shard ?? '')) s.classList.add('read');
  for (const slug of finished) flag(rowOf.get(slug), 'Read');
  if (finished.length) {
    const key = document.querySelector('.bowl__key');
    if (key) key.append(` The gold ones are yours: ${finished.length} of ${rows.length} read.`);
  }

  // The piece they most recently left unfinished.
  const leftOff = Object.keys((() => { try { return localStorage; } catch { return {}; } })())
    .filter((k) => k.startsWith('waibi:place:'))
    .map((k) => ({ slug: k.slice('waibi:place:'.length), ...store.get<{ id?: string; at?: number; ask?: string; section?: string }>(k, {}) }))
    .filter((p) => p.id && p.ask && p.at && Date.now() - p.at < 45 * 864e5 && rowOf.has(p.slug))
    .sort((a, b) => (b.at ?? 0) - (a.at ?? 0))[0];
  const again = document.querySelector<HTMLAnchorElement>('[data-again]');
  if (leftOff && again) {
    again.href = `/blog/${leftOff.slug}/#${leftOff.id}`;
    // A word joiner keeps names like GPT-4 on one line.
    again.querySelector('[data-again-ask]')!.textContent = (leftOff.ask ?? '').replace(/-(?=\d)/g, '-⁠');
    again.querySelector('[data-again-at]')!.textContent = leftOff.section ? `You were at: ${leftOff.section}` : '';
    again.hidden = false;
  }

  // What is new since the last visit. A visit counts once it is six hours old,
  // so a refresh does not wipe the markers.
  const visit = store.get<{ at?: number; prev?: number }>('waibi:visit', {});
  const now = Date.now();
  if (!visit.at) store.set('waibi:visit', { at: now });
  else if (now - visit.at > 6 * 36e5) store.set('waibi:visit', { at: now, prev: visit.at });
  const since = visit.at && now - visit.at > 6 * 36e5 ? visit.at : visit.prev;
  const fresh = since ? rows.filter((r) => Number(r.dataset.at) > since) : [];
  for (const r of fresh) if (!finished.includes(r.dataset.q ?? '')) flag(r, 'New');
  const newNote = fresh.length ? ` ${fresh.length} new since your last visit.` : '';
  greet(fresh.length);

  // Who is on the piece being previewed: the same character the reader will
  // meet inside it. Changes with the preview, never on its own.
  const pvWho = document.querySelector<HTMLElement>('[data-pv-who]');
  const pvWith = document.querySelector<HTMLElement>('[data-pv-with]');
  const pvCast = pvWho ? createCast(pvWho, { reduced }) : null;
  const castFor = (row?: HTMLElement) => {
    const who = row?.dataset.who;
    const actor = who ? pvCast?.get(who) : undefined;
    if (!pvWho || !actor || !row) return;
    for (const id of ['tsugi', 'oops', 'kiki', 'fude', 'uso']) if (id !== who) pvCast?.get(id)?.hide();
    actor.mood(row.dataset.mood ?? 'idle');
    actor.show();
    if (pvWith) pvWith.textContent = `With ${actor.el.dataset.name}, who ${JOB[who as keyof typeof JOB]}.`;
    pvWho.hidden = false;
  };

  const preview = (slug?: string, exploring = false) => {
    if (!slug) return;
    const row = rowOf.get(slug);
    castFor(row);
    for (const s of shards) {
      const on = s.dataset.shard === slug;
      // Last in the group paints on top, so a lifted shard clears its neighbours.
      if (on && exploring && !s.classList.contains('on')) s.parentNode?.appendChild(s);
      s.classList.toggle('on', on);
    }
    bowl?.classList.toggle('hot', exploring);
    if (bowlNow && row) bowlNow.textContent = row.dataset.d ?? '';
  };

  const render = () => {
    const terms = state.text.toLowerCase().split(/\s+/).filter(Boolean);
    const matches = rows.filter(
      (r) =>
        (state.track === 'all' || r.dataset.track === state.track) &&
        terms.every((t) => r.dataset.hay?.includes(t))
    );
    const limit = terms.length || state.open ? matches.length : CAP;
    const shown = new Set(matches.slice(0, limit));
    for (const r of rows) r.hidden = !shown.has(r);
    const matching = new Set(matches.map((r) => r.dataset.q));
    for (const s of shards) s.classList.toggle('off', !matching.has(s.dataset.shard));

    const door = doors.find((d) => d.dataset.door === state.track);
    for (const d of doors) d.setAttribute('aria-pressed', String(d === door));
    if (status) {
      const n = matches.length;
      const count = `${n} ${n === 1 ? 'question' : 'questions'}`;
      status.textContent = terms.length
        ? `${count} matching “${state.text.trim()}”.`
        : (door?.dataset.blurb ?? `Everything, newest first.${newNote}`);
    }
    if (reset) reset.hidden = state.track === 'all' && !terms.length;
    if (themeLink) {
      themeLink.hidden = state.track === 'all';
      if (state.track !== 'all') themeLink.href = `/${state.track}/`;
    }
    if (none) none.hidden = matches.length > 0;
    if (more) {
      more.hidden = limit >= matches.length;
      more.textContent = `Show all ${matches.length} questions`;
    }
    preview(matches[0]?.dataset.q);
    history.replaceState(null, '', state.track === 'all' ? location.pathname : `#${state.track}`);
  };

  for (const d of doors) {
    d.addEventListener('click', () => {
      state.track = state.track === d.dataset.door ? 'all' : d.dataset.door!;
      state.open = false;
      render();
    });
  }
  for (const r of rows) {
    r.addEventListener('pointerenter', () => preview(r.dataset.q, true));
    r.addEventListener('focusin', () => preview(r.dataset.q, true));
  }
  for (const s of shards) {
    s.addEventListener('pointerenter', () => {
      preview(s.dataset.shard, true);
      for (const r of rows) r.classList.toggle('q--on', r.dataset.q === s.dataset.shard);
    });
    s.addEventListener('pointerleave', () => rows.forEach((r) => r.classList.remove('q--on')));
  }

  document.querySelector('.shelf')?.addEventListener('pointerleave', () => bowl?.classList.remove('hot'));

  // Thumbnails wait until the bowl is close, and follow the theme.
  const isDark = () => {
    const t = document.documentElement.dataset.theme;
    return t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  };
  const artOf = [...document.querySelectorAll<SVGImageElement>('.shard__art')];
  let artLoaded = false;
  const loadArt = () => {
    if (!artLoaded) return;
    const dark = isDark();
    for (const a of artOf) {
      const src = dark ? a.dataset.dark : a.dataset.light;
      if (src) a.setAttribute('href', src); // a post with no art keeps its plain glaze
    }
  };
  if (bowl) {
    new IntersectionObserver(
      (entries, io) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        artLoaded = true;
        loadArt();
        // A one-off. Left on, re-stacking a hovered shard would replay it.
        bowl.classList.add('grow');
        setTimeout(() => bowl.classList.remove('grow'), shards.length * 26 + 800);
      },
      { rootMargin: '200px' }
    ).observe(bowl);
    new MutationObserver(loadArt).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', loadArt);

    // The seams catch the light as the pointer crosses the bowl.
    const gold = document.querySelector('[data-bowl-gold]');
    const svg = document.querySelector<SVGSVGElement>('[data-bowl-svg]');
    if (gold && svg && !reduced) {
      addEventListener('pointermove', (e) => {
        const b = svg.getBoundingClientRect();
        if (b.bottom < 0 || b.top > innerHeight) return;
        const x = ((e.clientX - b.left) / b.width) * 1000;
        const y = ((e.clientY - b.top) / b.height) * 1000;
        gold.setAttribute('x1', String(x - 620));
        gold.setAttribute('y1', String(y - 620));
        gold.setAttribute('x2', String(x + 620));
        gold.setAttribute('y2', String(y + 620));
      }, { passive: true });
    }
  }

  more?.addEventListener('click', () => {
    state.open = true;
    render();
  });
  find?.addEventListener('input', () => {
    state.text = find.value;
    render();
  });
  const clearAll = () => {
    state.track = 'all';
    state.text = '';
    state.open = false;
    if (find) find.value = '';
    render();
  };
  reset?.addEventListener('click', clearAll);
  clear?.addEventListener('click', clearAll);

  addEventListener('keydown', (e) => {
    const typing = /^(INPUT|TEXTAREA)$/.test((e.target as HTMLElement).tagName);
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      find?.focus();
    } else if (e.key === 'Escape' && e.target === find && find) {
      find.value = '';
      state.text = '';
      render();
    }
  });

  const fromHash = () => {
    const want = location.hash.slice(1);
    state.track = doors.some((d) => d.dataset.door === want) ? want : 'all';
    state.open = false;
    render();
  };
  addEventListener('hashchange', fromHash);
  fromHash();
</script>

<style is:global>

  [data-q][hidden], [data-none][hidden], [data-more][hidden],
  [data-reset][hidden], [data-theme-link][hidden], [data-pause][hidden], [data-again][hidden] { display: none !important; }


  /* ---------- the plate: dark glaze, so gold can read as gold ---------- */
  .plate {
    position: relative; color: var(--tldr-ink);
    background:
      radial-gradient(70rem 34rem at 82% -8%, color-mix(in srgb, var(--mizu) 11%, transparent), transparent 70%),
      radial-gradient(56rem 32rem at 4% 108%, color-mix(in srgb, var(--plum) 16%, transparent), transparent 70%),
      var(--tldr-bg);
  }
  /* The break where the plate meets the paper, seamed in gold so it holds in dark too. */
  .plate-edge { display: block; position: relative; width: 100%; height: 22px; overflow: visible; pointer-events: none; }
  .plate-edge polyline { fill: none; stroke: var(--ochre); stroke-width: 1.75; stroke-linejoin: miter; }

  /* ---------- the crew's stage: the edge between the plate and the paper ----------
     Clipped sideways only, so a character can walk off either end without the
     page scrolling, while standing tall above the line. Never takes a tap. */
  .edge-stage {
    position: relative; z-index: 3; height: 22px; margin-top: -22px; pointer-events: none;
    overflow-x: clip; overflow-y: visible;
  }
  .edge-stage .actor { --size: clamp(54px, 6.2vw, 78px); }
  /* Their bodies stand over the dark plate, so they take the plate's ink. */
  .edge-stage .crew { --crew-line: var(--tldr-ink); }
  .edge-stage .crew-wash { opacity: .78; }
  .edge-stage .crew-ink { stroke-width: 2.3; }
  .plate-edge--lit { position: absolute; inset: 0; opacity: 0; transition: opacity 1.1s ease; }
  .plate-edge--lit.on { opacity: 1; transition: opacity .15s ease; }
  .plate-edge--lit polyline {
    stroke: color-mix(in srgb, var(--gold) 70%, white); stroke-width: 3.6;
    filter: drop-shadow(0 0 3px var(--gold)) drop-shadow(0 0 10px color-mix(in srgb, var(--gold) 60%, transparent));
  }
  .edge-board {
    position: absolute; left: 0; top: 0; width: clamp(48px, 5.6vw, 70px); height: auto;
    transform-origin: 0 0; transform: translate(var(--x, -999px), var(--y, -999px)) rotate(var(--tilt, 0deg)) translate(-50%, -62%);
    opacity: 0; transition: opacity .25s ease;
  }
  .edge-board.on { opacity: 1; }
  .edge-board svg { display: block; width: 100%; overflow: visible; }
  .edge-board path { fill: var(--gold); stroke: var(--tldr-bg); stroke-width: 1.2; stroke-linejoin: round; }
  .edge-board .edge-board__seam { fill: none; stroke: var(--tldr-bg); stroke-width: 1; }
  html:not(.js) .edge-stage .actor, html:not(.js) .edge-board { display: none; }
  @media (prefers-reduced-motion: reduce) { .edge-stage .actor, .edge-board, .plate-edge--lit { display: none; } }
  .plate::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .5; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 240 240' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
  }
  /* Once the shader is running it paints the whole band, headline included. The
     DOM headline keeps its layout and stays in the accessibility tree. */
  .plate__gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .plate.gl { cursor: crosshair; background: var(--tldr-bg); }
  .plate.gl::before { display: none; }
  .plate.gl .claim__pc, .plate.gl .claim__seam { visibility: hidden; }
  .plate.gl a, .plate.gl button { cursor: pointer; }
  .plate.gl .claim.play .claim__mend { animation-delay: 1.75s; }
  /* ---------- the crew's seat, at the end of the cue row ---------- */
  .seat { --seat: 3.25rem; display: flex; align-items: center; gap: .65rem; margin-left: auto; min-height: 2.75rem; color: var(--tldr-dim); }
  .seat[hidden] { display: none; }
  .seat__who { margin-block: -.5rem -.35rem; }
  .seat__text { max-width: 24rem; font-size: .875rem; line-height: 1.35; }
  .seat .crew-line { color: var(--tldr-ink); font-size: 1rem; }
  .seat .crew-line__who { color: var(--ochre); }
  .seat + .cue-pause { margin-left: 0; }
  html:not(.js) .seat { display: none; }

  /* A held repair: the finding is written in as the gold goes in. */
  .claim.held .claim__mend { animation: none; opacity: 1; }
  .claim.held .claim__k--gold, .claim.held .claim__go { opacity: var(--mend, 0); transition: opacity .2s linear; }
  .claim.held .claim__fix {
    --edge: calc(var(--mend, 0) * 118% - 14%);
    -webkit-mask-image: linear-gradient(90deg, #000 var(--edge), transparent calc(var(--edge) + 14%));
    mask-image: linear-gradient(90deg, #000 var(--edge), transparent calc(var(--edge) + 14%));
  }
  .plate.gl:has(.claim.held) { cursor: copy; }
  .plate:has(.claim.held) { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; touch-action: pan-y; }
  .empty-q__crew { display: inline-block; width: 4.5rem; height: 4.5rem; vertical-align: middle; margin-right: .5rem; }

  /* The bottom leaves headroom for the crew standing on the edge below. */
  .plate__in { position: relative; padding-block: clamp(1.75rem, 3.5vw, 3rem) clamp(4.5rem, 6.5vw, 5.75rem); }

  .plate__id {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 34rem);
    gap: 1rem 4rem; align-items: end;
    padding-bottom: 1.5rem; border-bottom: 1px solid var(--tldr-hair);
  }
  .plate__id h1 {
    margin: 0; font-size: clamp(1.625rem, 2.8vw, 2.5rem); font-weight: 800;
    letter-spacing: -.03em; line-height: 1.1; text-wrap: balance;
  }
  .plate__caret {
