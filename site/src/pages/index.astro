---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// The three themes. Each has its own research routine feeding the Notion radar.
// Say what each one is in words a first-time visitor understands without
// decoding anything — the clever framing belongs inside the articles, not on
// the door. Accents follow docs/ARTWORK.md.
const TRACKS = [
  {
    id: 'technical',
    label: 'Technical',
    accent: 'mizu',
    ask: 'For people who build with AI',
    blurb:
      'How models and AI systems actually work, and how they break once they are doing real work.',
    cta: 'Read the technical posts',
  },
  {
    id: 'business',
    label: 'Business',
    accent: 'ochre',
    ask: 'For people who decide about AI',
    blurb:
      'What AI changes about consulting, marketing and strategy — and how to judge a claim without being an engineer.',
    cta: 'Read the business posts',
  },
  {
    id: 'basics',
    label: 'Basics',
    accent: 'plum',
    ask: 'For people getting up to speed',
    blurb:
      'AI explained in plain language, what is genuinely new this month, and the setups I have built.',
    cta: 'Start here',
  },
] as const;

const counts = Object.fromEntries(
  TRACKS.map((t) => [t.id, posts.filter((p) => p.data.track === t.id).length])
);
const accentOf = Object.fromEntries(TRACKS.map((t) => [t.id, t.accent]));
const labelOf = Object.fromEntries(TRACKS.map((t) => [t.id, t.label]));

const featured = posts.slice(0, 3);
const slugOf = (p: (typeof posts)[number]) => p.id.replace(/\.md$/, '');
const dateOf = (d: Date) =>
  d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base
  title="Wabi Sabi — Applied AI, in practice"
  description="Wabi Sabi: an applied-AI journal on the systems that are never finished. What benchmarks leave out, what breaks in production, and what the research says past the abstract."
  section="Applied AI"
  wide
>
  {/* Centred masthead. A stranger should know what this is from one screen. */}
  <section class="mast fade-up d1">
    <span class="hanko">Wabi Sabi</span>
    <h1>The models are<br /><span class="hl">never finished</span></h1>
    <p class="mast__lede">
      Writing about AI that shows its working — what the benchmarks leave out, what breaks
      in production, and which parts do not hold up.
    </p>
  </section>

  <div class="rulebar fade-up d2" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

  <section class="tracks" aria-labelledby="tracks-h">
    <div class="sec">
      <h2 class="sec__t" id="tracks-h">What's here</h2>
      <span class="sec__r" aria-hidden="true"></span>
    </div>

    <div class="tracks__grid">
      {
        TRACKS.map((t, n) => (
          <article
            class="track scroll-reveal"
            data-track-card={t.id}
            style={`transition-delay:${n * 90}ms;--accent:var(--${t.accent});--tint:var(--wash-${t.accent})`}
          >
            {/* Each mark is a complete order with exactly one break in it. The
                break closes on hover — the drawing finishes when you reach for
                it. See docs/ARTWORK.md. */}
            <div class="track__art" aria-hidden="true">
              {t.id === 'technical' && (
                <svg viewBox="0 0 120 120" fill="none">
                  <circle class="ring" cx="60" cy="60" r="34" stroke="currentColor" stroke-width="1.5" pathLength="100" />
                  <circle cx="60" cy="60" r="2.5" fill="currentColor" />
                  <path d="M60 12v10M108 60H98M60 108V98M12 60h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              )}
              {t.id === 'business' && (
                <svg viewBox="0 0 120 120" fill="none">
                  <g class="grid" fill="currentColor">
                    {[26, 47, 68, 89].map((y) =>
                      [26, 47, 68, 89].map((x) => <circle cx={x} cy={y} r="2.5" />)
                    )}
                  </g>
                  <circle class="stray" cx="89" cy="26" r="2.5" fill="currentColor" />
                </svg>
              )}
              {/* Basics: steps up out of a single point. The top step is
                  unfinished, because getting up to speed never quite ends. */}
              {t.id === 'basics' && (
                <svg viewBox="0 0 120 120" fill="none">
                  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
                    <path class="arc a1" d="M14 98h26v-22" pathLength="100" />
                    <path class="arc a2" d="M40 76h26v-22" pathLength="100" />
                    <path class="arc a3" d="M66 54h26v-22" pathLength="100" />
                  </g>
                  <circle cx="14" cy="98" r="3" fill="currentColor" />
                </svg>
              )}
            </div>

            <p class="track__ask">{t.ask}</p>
            <h3 class="track__label">{t.label}</h3>
            <p class="track__blurb">{t.blurb}</p>

            <button type="button" class="track__cta" data-filter={t.id} aria-pressed="false">
              <span>{counts[t.id] > 0 ? t.cta : 'Nothing here yet'}</span>
              <span class="track__count">
                {counts[t.id]} {counts[t.id] === 1 ? 'post' : 'posts'}
              </span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </button>

            {/* The setups and projects belong with the learning material, but
                they keep their own page — already indexed, and not an article
                stream. Link across rather than duplicating it. */}
            {t.id === 'basics' && (
              <a class="track__aside" href="/projects/">
                Or see the setups and projects I have built →
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="featured" aria-labelledby="featured-h">
        <div class="sec">
          <h2 class="sec__t" id="featured-h">Featured</h2>
          <span class="sec__r" aria-hidden="true" />
        </div>
        <ol class="featured__grid">
          {featured.map((post, n) => {
            const a = accentOf[post.data.track];
            return (
              <li
                class="scroll-reveal"
                style={`transition-delay:${n * 70}ms;--accent:var(--${a});--tint:var(--wash-${a})`}
              >
                <a href={`/blog/${slugOf(post)}/`}>
                  <span class="featured__n" aria-hidden="true">
                    {String(n + 1).padStart(2, '0')}
                  </span>
                  <span class="featured__track">{labelOf[post.data.track]}</span>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <span class="featured__meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {dateOf(post.data.pubDate)}
                    </time>
                    {post.data.readingTime && <span>{post.data.readingTime}</span>}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    )
  }

  <section class="archive" id="writing" aria-labelledby="archive-h">
    <div class="sec">
      <h2 class="sec__t" id="archive-h"><span data-archive-label>Everything</span></h2>
      <span class="sec__r" aria-hidden="true"></span>
      <div class="sortby">
        <span class="sortby__k">Sort by</span>
        <button type="button" class="pill is-on" data-sort="date" aria-pressed="true">Most recent</button>
        <button type="button" class="pill" data-sort="title" aria-pressed="false">Title</button>
      </div>
      <button type="button" class="reset" data-filter="all" hidden>Show everything</button>
    </div>

    {
      posts.length === 0 ? (
        <p class="postlist__none">No posts published yet.</p>
      ) : (
        <table class="ptable">
          <thead>
            <tr>
              <th scope="col">Theme</th>
              <th scope="col">Title</th>
              <th scope="col" class="num">Read</th>
              <th scope="col" class="num">Published</th>
            </tr>
          </thead>
          <tbody>
            {posts.map((post) => (
              <tr
                data-track={post.data.track}
                data-title={post.data.title.toLowerCase()}
                data-date={post.data.pubDate.toISOString()}
                style={`--accent:var(--${accentOf[post.data.track]})`}
              >
                <td class="ptable__track">
                  <span class="dot" aria-hidden="true" />
                  {labelOf[post.data.track]}
                </td>
                <th scope="row">
                  <a href={`/blog/${slugOf(post)}/`}>{post.data.title}</a>
                  {post.data.question && <span class="ptable__q">{post.data.question}</span>}
                </th>
                <td class="num">{post.data.readingTime ?? '—'}</td>
                <td class="num">
                  <time datetime={post.data.pubDate.toISOString()}>{dateOf(post.data.pubDate)}</time>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }

    <p class="postlist__none" hidden>Nothing published in this theme yet.</p>
  </section>

  <section class="plug scroll-reveal">
    <div>
      <span class="meta" style="color:var(--ochre)">Also here</span>
      <h2>Interview News Archive</h2>
      <p>
        A daily business-news digest for Indian B-school placement prep — each story paired
        with the angle an interviewer is likely to push on.
      </p>
    </div>
    <a href="/news/" class="plug__cta">
      Browse the archive
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </section>
</Base>

<script>
  // Filter and sort the archive table. Attribute toggling and DOM reordering
  // only — every row stays in the document, so the page is complete for
  // crawlers and works as a plain table without JS.
  const tbody = document.querySelector<HTMLElement>('.ptable tbody');
  const rows = [...document.querySelectorAll<HTMLElement>('.ptable tbody tr')];
  const ctas = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const sorts = [...document.querySelectorAll<HTMLButtonElement>('[data-sort]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-track-card]')];
  const none = document.querySelector<HTMLElement>('.postlist__none[hidden]');
  const label = document.querySelector<HTMLElement>('[data-archive-label]');
  const reset = document.querySelector<HTMLElement>('.reset');
  const LABELS: Record<string, string> = {
    technical: 'Technical',
    business: 'Business',
    basics: 'Basics',
  };

  const apply = (want: string, scroll = false) => {
    let shown = 0;
    for (const row of rows) {
      const on = want === 'all' || row.dataset.track === want;
      row.hidden = !on;
      if (on) shown++;
    }
    for (const c of ctas) {
      if (c.dataset.filter === 'all') continue;
      c.setAttribute('aria-pressed', String(c.dataset.filter === want));
    }
    for (const p of panels) p.classList.toggle('is-on', p.dataset.trackCard === want);
    if (label) label.textContent = LABELS[want] ?? 'Everything';
    if (reset) reset.hidden = want === 'all';
    if (none) none.hidden = shown > 0;

    history.replaceState(null, '', want === 'all' ? location.pathname : `#${want}`);

    if (scroll) {
      document.getElementById('writing')?.scrollIntoView({
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'start',
      });
    }
  };

  const sortBy = (key: string) => {
    const sorted = [...rows].sort((a, b) =>
      key === 'title'
        ? (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '')
        : (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '')
    );
    for (const r of sorted) tbody?.appendChild(r);
    for (const s of sorts) {
      const on = s.dataset.sort === key;
      s.classList.toggle('is-on', on);
      s.setAttribute('aria-pressed', String(on));
    }
  };

  for (const c of ctas) {
    c.addEventListener('click', () => {
      const want = c.dataset.filter!;
      // Clicking the open theme again returns you to everything.
      const already = c.getAttribute('aria-pressed') === 'true';
      apply(already ? 'all' : want, !already && want !== 'all');
    });
  }
  for (const s of sorts) s.addEventListener('click', () => sortBy(s.dataset.sort!));

  const initial = location.hash.replace('#', '');
  if (initial && initial in LABELS) apply(initial);
</script>

<style>
  /* `[hidden]` is 0,1,0 and loses to author `display` rules, so anything hidden
     by the attribute has to opt out — see docs/HANDOFF.md §6. */
  .ptable tbody tr[hidden],
  .postlist__none[hidden],
  .reset[hidden] { display: none !important; }

  /* ---------- masthead ---------- */
  .mast { text-align: center; padding: 3.5rem 0 2.5rem; }
  .mast h1 {
    font-size: clamp(2.4rem, 7vw, 4.5rem); font-weight: 800; line-height: 1.02;
    letter-spacing: -.04em; margin: 1rem 0 0; text-wrap: balance;
  }
  .mast__lede {
    margin: 1.25rem auto 0; max-width: 38rem;
    font-size: 1.0625rem; line-height: 1.7; color: var(--ink-soft);
  }
  @media (min-width: 768px) { .mast__lede { font-size: 1.125rem; } }

  .rulebar { display: flex; gap: 3px; margin: 1rem 0 0; }
  .rulebar span {
    height: 3px; flex: 1; border-radius: 2px;
    transform-origin: left; animation: stretch .8s var(--ease) both;
  }
  .rulebar span:nth-child(1) { background: var(--mizu); animation-delay: .15s; }
  .rulebar span:nth-child(2) { background: var(--ochre); animation-delay: .22s; }
  .rulebar span:nth-child(3) { background: var(--moss); animation-delay: .29s; }
  .rulebar span:nth-child(4) { background: var(--plum); animation-delay: .36s; }
  .rulebar span:nth-child(5) { background: var(--hanko); animation-delay: .43s; }
  .rulebar span:nth-child(6) { background: var(--indigo); animation-delay: .5s; }
  @keyframes stretch { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* ---------- section headers ---------- */
  .sec { display: flex; align-items: center; gap: 1rem; margin: 3.5rem 0 1.5rem; flex-wrap: wrap; }
  .sec__t {
    margin: 0; font-size: .6875rem; font-weight: 800; letter-spacing: .18em;
    text-transform: uppercase; color: var(--ink-faint); white-space: nowrap;
  }
  .sec__r { flex: 1; height: 1px; background: var(--border); }

  .sortby { display: flex; align-items: center; gap: .4rem; }
  .sortby__k {
    font-size: .5625rem; font-weight: 800; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ink-faint); margin-right: .2rem;
  }
  .pill, .reset {
    font: inherit; cursor: pointer; background: transparent;
    border: 1px solid var(--border); color: var(--ink-soft); border-radius: 999px;
    padding: .38rem .8rem;
    font-size: .625rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease),
                background var(--dur-fast) var(--ease);
  }
  .pill:hover, .reset:hover { color: var(--ink); border-color: var(--ink-faint); }
  .pill.is-on { color: var(--ink); border-color: var(--ink); background: var(--card); }

  /* ---------- theme panels ---------- */
  .tracks__grid { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); }
  .track {
    display: flex; flex-direction: column; gap: .5rem;
    padding: 1.75rem; border-radius: 20px;
    border: 1px solid var(--border); background: var(--card);
    position: relative; overflow: hidden;
    transition: border-color .35s var(--ease), transform .35s var(--ease);
  }
  .track::before {
    content: ''; position: absolute; inset: 0; background: var(--tint);
    opacity: 0; transition: opacity .35s var(--ease);
  }
  .track > * { position: relative; }
  .track:hover, .track:focus-within { border-color: var(--accent); transform: translateY(-4px); }
  .track:hover::before, .track:focus-within::before, .track.is-on::before { opacity: 1; }
  .track.is-on { border-color: var(--accent); }

  .track__art { color: var(--accent); width: 80px; height: 80px; margin-bottom: .25rem; }
  .track__art svg { width: 100%; height: 100%; overflow: visible; }

  /* The one deliberate break in each mark, closing on hover. */
  .track .ring {
    stroke-dasharray: 100; stroke-dashoffset: 22;
    transition: stroke-dashoffset .7s var(--ease);
  }
  .track:hover .ring, .track.is-on .ring { stroke-dashoffset: 0; }
  .track .stray { transform: translate(-9px, 11px); transition: transform .6s var(--ease); }
  .track:hover .stray, .track.is-on .stray { transform: none; }
  .track .grid circle:last-child { opacity: 0; }
  .track .arc { stroke-dasharray: 100; stroke-dashoffset: 26; transition: stroke-dashoffset .7s var(--ease); }
  .track .a2 { transition-delay: .07s; }
  .track .a3 { transition-delay: .14s; }
  .track:hover .arc, .track.is-on .arc { stroke-dashoffset: 0; }

  .track__ask { margin: 0; font-size: .8125rem; font-weight: 800; letter-spacing: .02em; color: var(--accent); }
  .track__label { margin: 0; font-size: 1.75rem; font-weight: 800; letter-spacing: -.03em; line-height: 1; }
  .track__blurb { margin: .25rem 0 0; font-size: .875rem; line-height: 1.65; color: var(--ink-soft); }

  .track__cta {
    font: inherit; cursor: pointer; margin-top: 1.25rem;
    display: flex; align-items: center; gap: .5rem;
    background: transparent; border: 0; padding: 0; text-align: left;
    font-size: .6875rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
    color: var(--accent);
  }
  .track__cta svg { width: 13px; height: 13px; transition: transform .3s var(--ease); }
  .track:hover .track__cta svg, .track__cta:focus-visible svg { transform: translateX(5px); }
  .track__count { margin-left: auto; color: var(--ink-faint); letter-spacing: .1em; font-size: .5625rem; }
  .track__cta::after { content: ''; position: absolute; inset: 0; border-radius: 20px; }
  .track__aside {
    position: relative; z-index: 1; margin-top: .75rem;
    font-size: .8125rem; line-height: 1.5; color: var(--ink-soft);
    text-decoration: none; border-bottom: 1px solid var(--border);
    align-self: flex-start; padding-bottom: 1px;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .track__aside:hover { color: var(--accent); border-color: var(--accent); }

  /* ---------- featured ---------- */
  .featured__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr);
  }
  .featured__grid a {
    display: flex; flex-direction: column; height: 100%; gap: .5rem;
    text-decoration: none; padding: 1.5rem; border-radius: 18px;
    border: 1px solid var(--border); background: var(--card);
    position: relative; overflow: hidden;
    transition: transform .3s var(--ease), border-color .3s var(--ease);
  }
  .featured__grid a::before {
    content: ''; position: absolute; inset: 0; background: var(--tint);
    opacity: 0; transition: opacity .3s var(--ease);
  }
  .featured__grid a > * { position: relative; }
  .featured__grid a:hover, .featured__grid a:focus-visible {
    transform: translateY(-4px); border-color: var(--accent);
  }
  .featured__grid a:hover::before, .featured__grid a:focus-visible::before { opacity: 1; }
  .featured__n {
    font-size: 2.5rem; font-weight: 800; line-height: 1; letter-spacing: -.04em;
    color: var(--accent); opacity: .28;
  }
  .featured__track {
    font-size: .5625rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    color: var(--accent);
  }
  .featured__grid h3 {
    margin: 0; font-size: 1.0625rem; font-weight: 800; line-height: 1.3; letter-spacing: -.015em;
  }
  .featured__grid p { margin: 0; font-size: .875rem; line-height: 1.6; color: var(--ink-soft); }
  .featured__meta {
    margin-top: auto; padding-top: .75rem; display: flex; gap: .75rem;
    font-size: .625rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* ---------- archive table ---------- */
  .ptable { width: 100%; border-collapse: collapse; font-size: .9375rem; }
  .ptable thead th {
    text-align: left; padding: .6rem .75rem;
    font-size: .5625rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase;
    color: var(--ink-faint); border-bottom: 1px solid var(--border);
  }
  .ptable tbody td, .ptable tbody th {
    text-align: left; padding: 1rem .75rem; border-bottom: 1px solid var(--border);
    vertical-align: top; font-weight: 400;
  }
  .ptable tbody tr { transition: background var(--dur-fast) var(--ease); }
  .ptable tbody tr:hover { background: var(--card); }
  .ptable tbody th a {
    text-decoration: none; font-weight: 700; font-size: 1rem; line-height: 1.35;
    background-image: none; display: inline-block;
    transition: color var(--dur-fast) var(--ease);
  }
  .ptable tbody tr:hover th a { color: var(--accent); }
  .ptable__q {
    display: block; margin-top: .25rem; font-size: .8125rem; line-height: 1.5;
    color: var(--ink-faint); max-width: 44rem;
  }
  .ptable__track {
    white-space: nowrap; font-size: .6875rem; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; color: var(--accent);
  }
  .dot {
    display: inline-block; width: 7px; height: 7px; border-radius: 999px;
    background: var(--accent); margin-right: .5rem; vertical-align: middle;
  }
  .ptable .num {
    white-space: nowrap; font-variant-numeric: tabular-nums;
    font-size: .8125rem; color: var(--ink-faint);
  }
  .postlist__none { margin: 1.5rem 0 0; font-size: .9375rem; color: var(--ink-soft); }

  /* ---------- news plug ---------- */
  .plug {
    margin-top: 3.5rem; padding: 1.75rem; border-radius: 18px;
    background: var(--wash-ochre); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    gap: 1.5rem; flex-wrap: wrap;
  }
  .plug h2 { font-size: 1.25rem; font-weight: 800; margin: .5rem 0 .5rem; letter-spacing: -.015em; }
  .plug p { margin: 0; font-size: .9375rem; line-height: 1.6; color: var(--ink-soft); max-width: 32rem; }
  .plug__cta {
    display: inline-flex; align-items: center; gap: .45rem; flex-shrink: 0;
    font-size: .6875rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
    text-decoration: none; color: var(--paper); background: var(--ink);
