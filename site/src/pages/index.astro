---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TrackMark from '../components/TrackMark.astro';
import Bowl from '../components/Bowl.astro';
import { TRACKS } from '../data/tracks';
import { CLAIMS } from '../data/claims';
import { plateEdge, EDGE_DEPTH } from '../lib/bowl';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const slugOf = (p: (typeof posts)[number]) => p.id.replace(/\.md$/, '');
const dateOf = (d: Date) =>
  d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const trackOf = Object.fromEntries(TRACKS.map((t) => [t.id, t]));
const counts = Object.fromEntries(
  TRACKS.map((t) => [t.id, posts.filter((p) => p.data.track === t.id).length])
);

/* The same zigzag for every claim, moved to that claim's seam. One shape drives
   the two clip-paths and the drawn line, so the pieces always meet on it. */
const JAG = [
  [1.2, 0],
  [-0.9, 18],
  [1.6, 41],
  [-1.4, 63],
  [0.7, 82],
  [-0.5, 100],
];
const seamOf = (x: number) => JAG.map(([dx, y]) => [+(x + dx).toFixed(2), y] as const);
// A renamed or retired post drops out of the hero instead of failing the build:
// publishing is automated, and one stale slug must never be able to block it.
const live = CLAIMS.flatMap((c) => {
  const post = posts.find((p) => slugOf(p) === c.slug);
  if (!post) console.warn(`claims.ts: skipping missing post ${c.slug}`);
  return post ? [{ c, post }] : [];
});
if (!live.length) throw new Error('claims.ts: no claim points at a published post');
const claims = live.map(({ c, post }) => {
  const pts = seamOf(c.seam);
  const edge = pts.map(([x, y]) => `${x}% ${y}%`);
  const first = pts[0][0];
  const last = pts[pts.length - 1][0];
  return {
    ...c,
    href: `/blog/${c.slug}/`,
    accent: trackOf[post.data.track].accent,
    track: trackOf[post.data.track].label,
    line: pts.map(([x, y]) => `${x},${y}`).join(' '),
    left: `polygon(-4% -25%, ${first}% -25%, ${edge.join(', ')}, ${last}% 125%, -4% 125%)`,
    right: `polygon(104% -25%, ${first}% -25%, ${edge.join(', ')}, ${last}% 125%, 104% 125%)`,
  };
});

const INITIAL_ROWS = 8;

// The same broken, gold-seamed edge the article plates have.
const edge = plateEdge('home');
const edgeClip = `polygon(0 0,100% 0,${[...edge].reverse().map(([x, d]) => `${x.toFixed(1)}% calc(100% - ${d.toFixed(1)}px)`).join(',')})`;
const edgeLine = edge.map(([x, d]) => `${(x * 10).toFixed(0)},${(EDGE_DEPTH - d).toFixed(1)}`).join(' ');
---

<Base
  title="wAIbi-sabi — Applied AI, in practice"
  description="wAIbi-sabi: an applied-AI journal. What benchmarks leave out, what breaks in production, and what the research says past the abstract."
  section="Applied AI"
  wide
  immersive
>
  <section class="plate" aria-labelledby="thesis" style={`clip-path:${edgeClip}`}>
    <div class="wrap plate__in">
      <header class="plate__id">
        <h1 id="thesis">The models are never finished<span class="plate__caret" aria-hidden="true"></span></h1>
        <p>
          Writing about AI that shows its working: what the benchmarks leave out, what breaks
          in production, and which parts do not hold up.
        </p>
      </header>

      <div class="stage" data-stage>
        <div class="claims" data-claims>
          {claims.map((c, n) => (
            <div class:list={['claim', n === 0 && 'on', n === 0 && 'play']} data-claim={n} data-seam={c.seam}>
              <span class="claim__k">Claimed</span>
              <span class="claim__said">
                <span class="sr">{c.claim}</span>
                <span class="claim__pc claim__pc--l" style={`clip-path:${c.left}`} aria-hidden="true">{c.claim}</span>
                <span class="claim__pc claim__pc--r" style={`clip-path:${c.right}`} aria-hidden="true">{c.claim}</span>
                <svg class="claim__seam" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  <polyline points={c.line} vector-effect="non-scaling-stroke" />
                </svg>
              </span>
              <span class="claim__mend">
                <span class="claim__k claim__k--gold">What the article found</span>
                <span class="claim__fix">{c.mend}</span>
                <a class="claim__go" href={c.href}>Read the {c.track.toLowerCase()} piece <span aria-hidden="true">→</span></a>
              </span>
            </div>
          ))}
        </div>

        <div class="cues" data-cues>
          {claims.map((c, n) => (
            <button
              type="button"
              class:list={['cue', n === 0 && 'cue--on']}
              data-cue={n}
              aria-pressed={n === 0 ? 'true' : 'false'}
              style={`--accent:var(--${c.accent})`}
            >
              <span class="cue__dot" aria-hidden="true"></span>{c.subject}
              <span class="cue__bar" aria-hidden="true"></span>
            </button>
          ))}
          <span class="cue-hint" data-hint hidden><span class="cue-hint__fine">Click the plate to break the next claim</span><span class="cue-hint__touch">Tap the plate to break the next claim</span></span>
          <button type="button" class="cue-pause" data-pause>Pause</button>
        </div>
      </div>
    </div>
  </section>
  <svg class="plate-edge" viewBox={`0 0 1000 ${EDGE_DEPTH}`} preserveAspectRatio="none" aria-hidden="true">
    <polyline points={edgeLine} vector-effect="non-scaling-stroke" />
  </svg>

  <section class="reader wrap" aria-labelledby="reader-h" id="writing">
    <a class="again" data-again hidden href="/">
      <span class="again__k">Pick up where you left off</span>
      <span class="again__ask" data-again-ask></span>
      <span class="again__at" data-again-at></span>
    </a>
    <div class="reader__top">
      <h2 id="reader-h">What are you trying to work out?</h2>
      <div class="find">
        <label for="find-q">Search {posts.length} questions</label>
        <div class="find__box">
          <input id="find-q" type="search" autocomplete="off" placeholder="cost, latency, Klarna…" data-find />
          <kbd aria-hidden="true">/</kbd>
        </div>
      </div>
    </div>

    <div class="doors" role="group" aria-label="Filter by what you are here for">
      {TRACKS.map((t) => (
        <button
          type="button"
          class="door"
          data-door={t.id}
          data-label={t.label}
          data-blurb={t.blurb}
          aria-pressed="false"
          style={`--accent:var(--${t.accent});--tint:var(--wash-${t.accent})`}
        >
          <span class="door__mark"><TrackMark id={t.id} /></span>
          <span class="door__label">{t.label}<span class="door__n">{counts[t.id]}</span></span>
          <span class="door__ask">{t.ask}</span>
        </button>
      ))}
    </div>

    <div class="status">
      <p class="status__text" data-status aria-live="polite">Everything, newest first.</p>
      <button type="button" class="linkish" data-reset hidden>Show everything</button>
      <a class="linkish" data-theme-link href="/" hidden>This theme's own page →</a>
    </div>

    <div class="shelf">
      <ol class="qs" data-qs>
        {posts.map((post, n) => {
          const t = trackOf[post.data.track];
          const hay = `${post.data.question ?? ''} ${post.data.title} ${post.data.description} ${t.label}`.toLowerCase();
          return (
            <li
              class="q"
              data-q={slugOf(post)}
              data-track={post.data.track}
              data-hay={hay}
              data-d={post.data.description}
              style={`--accent:var(--${t.accent})`}
              data-extra={n >= INITIAL_ROWS ? '' : undefined}
              data-at={post.data.pubDate.valueOf()}
            >
              <a href={`/blog/${slugOf(post)}/`}>
                <span class="q__ask">{post.data.question ?? post.data.title}</span>
                <span class="q__title">{post.data.title}</span>
                <span class="q__meta">
                  <span class="q__dot" aria-hidden="true"></span>{t.label}
                  {post.data.readingTime && <span> · {post.data.readingTime.replace(' read', '')}</span>}
                  <span> · <time datetime={post.data.pubDate.toISOString()}>{dateOf(post.data.pubDate)}</time></span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>

      <aside class="pv"><Bowl posts={posts} /></aside>
    </div>

    <p class="empty-q" data-none hidden>
      No question matches that yet. Try a broader word, or <button type="button" class="linkish" data-clear>clear the search</button>.
    </p>
    <button type="button" class="more" data-more hidden></button>
  </section>

  <section class="working" aria-labelledby="working-h">
    <div class="wrap working__in">
      <div class="working__text">
        <h2 id="working-h">You should know how this gets made.</h2>
        <p>
          Scheduled routines find the topics, research them, draft them and draw the art. A
          person decides which of those parts get to reach you.
        </p>
        <a class="linkish" href="/blog/how-this-blog-builds-itself/">How this blog builds itself →</a>
      </div>

      <div class="flow" role="img" aria-label="Topics are found, researched and drafted by routines. Technical and Business pieces then wait for a human sign-off. Talks, Case Studies and Basics publish on their own.">
        <ol class="flow__steps" aria-hidden="true">
          <li>Found</li>
          <li>Researched</li>
          <li>Drafted</li>
        </ol>
        <div class="flow__lanes" aria-hidden="true">
          <div class="lane lane--human">
            <span class="lane__seal">Human<br />sign-off</span>
            <span class="lane__who">Technical, Business</span>
            <span class="lane__end">Published</span>
          </div>
          <div class="lane">
            <span class="lane__who">Talks, Case Studies, Basics</span>
            <span class="lane__end">Published</span>
          </div>
        </div>
      </div>

      <div class="author">
        <h3>Janmejai Singh Minhas</h3>
        <p>
          I build machine learning systems that have to work outside a notebook, and I break
          other people's. Medical imaging, credit risk models at American Express, and
          red-teaming frontier models, where I rank #352 on Gray Swan.
        </p>
        <a class="linkish" href="/about/">More about me →</a>
      </div>
    </div>
  </section>

  <section class="wrap bschool">
    <div>
      <h2>BSchool News Archive</h2>
      <p>
        A daily business-news digest for Indian B-school placement prep. Each story comes with
        the angle an interviewer is likely to push on.
      </p>
    </div>
    <a href="/news/" class="bschool__go">Browse the archive <span aria-hidden="true">→</span></a>
  </section>
</Base>

<script>
  import { createPlate } from '../scripts/kintsugi';

  const CAP = 8;
  const DWELL_END = 'cue-fill';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- the cracked claim ---------- */
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const claimEls = [...document.querySelectorAll<HTMLElement>('[data-claim]')];
  const cues = [...document.querySelectorAll<HTMLButtonElement>('[data-cue]')];
  const pause = document.querySelector<HTMLButtonElement>('[data-pause]');
  const claimsBox = document.querySelector<HTMLElement>('[data-claims]');
  const plateEl = document.querySelector<HTMLElement>('.plate');
  const hint = document.querySelector<HTMLElement>('[data-hint]');
  let current = 0;
  let auto = !reduced;

  // Null without WebGL2, in which case the CSS crack below it stays in charge.
  const plate = plateEl ? createPlate({ plate: plateEl, claims: claimEls, reduced }) : null;
  if (plate && hint) hint.hidden = false;

  const syncAuto = () => {
    stage?.classList.toggle('auto', auto);
    if (pause) {
      pause.textContent = auto ? 'Pause' : 'Play';
      pause.setAttribute('aria-pressed', String(!auto));
    }
  };

  const show = (n: number, at?: { x: number; y: number }) => {
    current = n;
    plate?.strike(n, at);
    claimEls.forEach((el, i) => {
      el.classList.toggle('on', i === n);
      el.classList.remove('play');
    });
    if (!reduced) {
      void claimEls[n].offsetWidth; // restart the keyframes on a repeat visit
      claimEls[n].classList.add('play');
    }
    cues.forEach((c, i) => {
      c.classList.toggle('cue--on', i === n);
      c.setAttribute('aria-pressed', String(i === n));
    });
  };

  cues.forEach((c, i) => {
    c.addEventListener('click', () => {
      auto = false;
      syncAuto();
      claimsBox?.setAttribute('aria-live', 'polite');
      show(i);
    });
    // One pass through the five, then rest on the first. It is not a carousel.
    c.querySelector('.cue__bar')?.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName !== DWELL_END || !auto || i !== current) return;
      if (i === cues.length - 1) {
        auto = false;
        syncAuto();
        show(0);
      } else {
        show(i + 1);
      }
    });
  });

  // Anywhere on the plate that is not already a control breaks the next claim,
  // from exactly where it was struck.
  plateEl?.addEventListener('click', (e) => {
    if (!plate || (e.target as HTMLElement).closest('a, button, input')) return;
    if (getSelection()?.toString()) return;
    auto = false;
    syncAuto();
    claimsBox?.setAttribute('aria-live', 'polite');
    show((current + 1) % claimEls.length, { x: e.clientX, y: e.clientY });
  });

  pause?.addEventListener('click', () => {
    auto = !auto;
    syncAuto();
  });

  const hold = (on: boolean) => stage?.classList.toggle('held', on);
  stage?.addEventListener('pointerenter', () => hold(true));
  stage?.addEventListener('pointerleave', () => hold(false));
  stage?.addEventListener('focusin', () => hold(true));
  stage?.addEventListener('focusout', () => hold(false));
  if (reduced && pause) pause.hidden = true;
  syncAuto();

  const startPlate = () => plate?.strike(0);
  if (plate) {
    claimEls[0].classList.remove('play');
    void claimEls[0].offsetWidth;
    if (!reduced) claimEls[0].classList.add('play');
    // The headline is set into a texture, so it has to wait for the real face.
    document.fonts.load('800 80px Inter').then(startPlate, startPlate);
  }

  /* ---------- the question list ---------- */
  const rows = [...document.querySelectorAll<HTMLElement>('[data-q]')];
  const doors = [...document.querySelectorAll<HTMLButtonElement>('[data-door]')];
  const find = document.querySelector<HTMLInputElement>('[data-find]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const reset = document.querySelector<HTMLElement>('[data-reset]');
  const clear = document.querySelector<HTMLElement>('[data-clear]');
  const none = document.querySelector<HTMLElement>('[data-none]');
  const more = document.querySelector<HTMLButtonElement>('[data-more]');
  const themeLink = document.querySelector<HTMLAnchorElement>('[data-theme-link]');
  const bowl = document.querySelector<HTMLElement>('[data-bowl]');
  const shards = [...document.querySelectorAll<SVGElement>('[data-shard]')];
  const bowlNow = document.querySelector<HTMLElement>('[data-bowl-now]');
  const rowOf = new Map(rows.map((r) => [r.dataset.q, r]));

  const state = { track: 'all', text: '', open: false };

  /* ---------- what this reader has already done here ----------
     All of it stays in their own browser. */
  const store = {
    get<T>(key: string, fallback: T): T {
      try {
        return (JSON.parse(localStorage.getItem(key) ?? 'null') as T) ?? fallback;
      } catch {
        return fallback;
      }
    },
    set(key: string, value: unknown) {
      try {
        localStorage.setItem(key, JSON.stringify(value));
      } catch {
        // Private windows can refuse storage. Nothing depends on it.
      }
    },
  };
  const flag = (row: HTMLElement | undefined, text: string) => {
    const meta = row?.querySelector('.q__meta');
    if (!meta) return;
    const el = document.createElement('span');
    el.className = 'q__flag';
    el.textContent = text;
    meta.append(el);
  };

  // Finished pieces turn gold in the bowl.
  const finished = store.get<string[]>('waibi:read', []).filter((s) => rowOf.has(s));
  for (const s of shards) if (finished.includes(s.dataset.shard ?? '')) s.classList.add('read');
  for (const slug of finished) flag(rowOf.get(slug), 'Read');
  if (finished.length) {
    const key = document.querySelector('.bowl__key');
    if (key) key.append(` The gold ones are yours: ${finished.length} of ${rows.length} read.`);
  }

  // The piece they most recently left unfinished.
  const leftOff = Object.keys((() => { try { return localStorage; } catch { return {}; } })())
    .filter((k) => k.startsWith('waibi:place:'))
    .map((k) => ({ slug: k.slice('waibi:place:'.length), ...store.get<{ id?: string; at?: number; ask?: string; section?: string }>(k, {}) }))
    .filter((p) => p.id && p.ask && p.at && Date.now() - p.at < 45 * 864e5 && rowOf.has(p.slug))
    .sort((a, b) => (b.at ?? 0) - (a.at ?? 0))[0];
  const again = document.querySelector<HTMLAnchorElement>('[data-again]');
  if (leftOff && again) {
    again.href = `/blog/${leftOff.slug}/#${leftOff.id}`;
    // A word joiner keeps names like GPT-4 on one line.
    again.querySelector('[data-again-ask]')!.textContent = (leftOff.ask ?? '').replace(/-(?=\d)/g, '-⁠');
    again.querySelector('[data-again-at]')!.textContent = leftOff.section ? `You were at: ${leftOff.section}` : '';
    again.hidden = false;
  }

  // What is new since the last visit. A visit counts once it is six hours old,
  // so a refresh does not wipe the markers.
  const visit = store.get<{ at?: number; prev?: number }>('waibi:visit', {});
  const now = Date.now();
  if (!visit.at) store.set('waibi:visit', { at: now });
  else if (now - visit.at > 6 * 36e5) store.set('waibi:visit', { at: now, prev: visit.at });
  const since = visit.at && now - visit.at > 6 * 36e5 ? visit.at : visit.prev;
  const fresh = since ? rows.filter((r) => Number(r.dataset.at) > since) : [];
  for (const r of fresh) if (!finished.includes(r.dataset.q ?? '')) flag(r, 'New');
  const newNote = fresh.length ? ` ${fresh.length} new since your last visit.` : '';

  const preview = (slug?: string, exploring = false) => {
    if (!slug) return;
    const row = rowOf.get(slug);
    for (const s of shards) {
      const on = s.dataset.shard === slug;
      // Last in the group paints on top, so a lifted shard clears its neighbours.
      if (on && exploring && !s.classList.contains('on')) s.parentNode?.appendChild(s);
      s.classList.toggle('on', on);
    }
    bowl?.classList.toggle('hot', exploring);
    if (bowlNow && row) bowlNow.textContent = row.dataset.d ?? '';
  };

  const render = () => {
    const terms = state.text.toLowerCase().split(/\s+/).filter(Boolean);
    const matches = rows.filter(
      (r) =>
        (state.track === 'all' || r.dataset.track === state.track) &&
        terms.every((t) => r.dataset.hay?.includes(t))
    );
    const limit = terms.length || state.open ? matches.length : CAP;
    const shown = new Set(matches.slice(0, limit));
    for (const r of rows) r.hidden = !shown.has(r);
    const matching = new Set(matches.map((r) => r.dataset.q));
    for (const s of shards) s.classList.toggle('off', !matching.has(s.dataset.shard));

    const door = doors.find((d) => d.dataset.door === state.track);
    for (const d of doors) d.setAttribute('aria-pressed', String(d === door));
    if (status) {
      const n = matches.length;
      const count = `${n} ${n === 1 ? 'question' : 'questions'}`;
      status.textContent = terms.length
        ? `${count} matching “${state.text.trim()}”.`
        : (door?.dataset.blurb ?? `Everything, newest first.${newNote}`);
    }
    if (reset) reset.hidden = state.track === 'all' && !terms.length;
    if (themeLink) {
      themeLink.hidden = state.track === 'all';
      if (state.track !== 'all') themeLink.href = `/${state.track}/`;
    }
    if (none) none.hidden = matches.length > 0;
    if (more) {
      more.hidden = limit >= matches.length;
      more.textContent = `Show all ${matches.length} questions`;
    }
    preview(matches[0]?.dataset.q);
    history.replaceState(null, '', state.track === 'all' ? location.pathname : `#${state.track}`);
  };

  for (const d of doors) {
    d.addEventListener('click', () => {
      state.track = state.track === d.dataset.door ? 'all' : d.dataset.door!;
      state.open = false;
      render();
    });
  }
  for (const r of rows) {
    r.addEventListener('pointerenter', () => preview(r.dataset.q, true));
    r.addEventListener('focusin', () => preview(r.dataset.q, true));
  }
  for (const s of shards) {
    s.addEventListener('pointerenter', () => {
      preview(s.dataset.shard, true);
      for (const r of rows) r.classList.toggle('q--on', r.dataset.q === s.dataset.shard);
    });
    s.addEventListener('pointerleave', () => rows.forEach((r) => r.classList.remove('q--on')));
  }

  document.querySelector('.shelf')?.addEventListener('pointerleave', () => bowl?.classList.remove('hot'));

  // Thumbnails wait until the bowl is close, and follow the theme.
  const isDark = () => {
    const t = document.documentElement.dataset.theme;
    return t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  };
  const artOf = [...document.querySelectorAll<SVGImageElement>('.shard__art')];
  let artLoaded = false;
  const loadArt = () => {
    if (!artLoaded) return;
    const dark = isDark();
    for (const a of artOf) {
      const src = dark ? a.dataset.dark : a.dataset.light;
      if (src) a.setAttribute('href', src); // a post with no art keeps its plain glaze
    }
  };
  if (bowl) {
    new IntersectionObserver(
      (entries, io) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        artLoaded = true;
        loadArt();
        // A one-off. Left on, re-stacking a hovered shard would replay it.
        bowl.classList.add('grow');
        setTimeout(() => bowl.classList.remove('grow'), shards.length * 26 + 800);
      },
      { rootMargin: '200px' }
    ).observe(bowl);
    new MutationObserver(loadArt).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', loadArt);

    // The seams catch the light as the pointer crosses the bowl.
    const gold = document.querySelector('[data-bowl-gold]');
    const svg = document.querySelector<SVGSVGElement>('[data-bowl-svg]');
    if (gold && svg && !reduced) {
      addEventListener('pointermove', (e) => {
        const b = svg.getBoundingClientRect();
        if (b.bottom < 0 || b.top > innerHeight) return;
        const x = ((e.clientX - b.left) / b.width) * 1000;
        const y = ((e.clientY - b.top) / b.height) * 1000;
        gold.setAttribute('x1', String(x - 620));
        gold.setAttribute('y1', String(y - 620));
        gold.setAttribute('x2', String(x + 620));
        gold.setAttribute('y2', String(y + 620));
      }, { passive: true });
    }
  }

  more?.addEventListener('click', () => {
    state.open = true;
    render();
  });
  find?.addEventListener('input', () => {
    state.text = find.value;
    render();
  });
  const clearAll = () => {
    state.track = 'all';
    state.text = '';
    state.open = false;
    if (find) find.value = '';
    render();
  };
  reset?.addEventListener('click', clearAll);
  clear?.addEventListener('click', clearAll);

  addEventListener('keydown', (e) => {
    const typing = /^(INPUT|TEXTAREA)$/.test((e.target as HTMLElement).tagName);
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      find?.focus();
    } else if (e.key === 'Escape' && e.target === find && find) {
      find.value = '';
      state.text = '';
      render();
    }
  });

  const fromHash = () => {
    const want = location.hash.slice(1);
    state.track = doors.some((d) => d.dataset.door === want) ? want : 'all';
    state.open = false;
    render();
  };
  addEventListener('hashchange', fromHash);
  fromHash();
</script>

