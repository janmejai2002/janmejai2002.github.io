---
/**
 * A theme's own page — /technical/, /business/, /basics/, /case-studies/,
 * /talks/. The index's panels filter in place; these are the permanent,
 * linkable, indexable homes. The list is question-led rather than title-led:
 * the question is the reader's entry point, and it is also the shape
 * retrieval systems lift.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { TRACKS } from '../data/tracks';

export function getStaticPaths() {
  return TRACKS.map((t) => ({ params: { track: t.id }, props: { t } }));
}

const { t } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.track === t.id)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const others = TRACKS.filter((x) => x.id !== t.id);
const slugOf = (p: (typeof posts)[number]) => p.id.replace(/\.md$/, '');
const dateOf = (d: Date) =>
  d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base
  title={`${t.label} — wAIbi-sabi`}
  description={t.blurb}
  section={t.label}
>
  <article class="theme" style={`--accent:var(--${t.accent});--tint:var(--wash-${t.accent})`}>
    <header class="theme__head fade-up d1">
      <p class="theme__ask">{t.ask}</p>
      <h1>{t.label}</h1>
      <p class="theme__blurb">{t.blurb}</p>
    </header>

    {
      posts.length > 0 ? (
        <ol class="qlist">
          {posts.map((post, n) => (
            <li class="scroll-reveal" style={`transition-delay:${Math.min(n, 5) * 60}ms`}>
              <a href={`/blog/${slugOf(post)}/`}>
                {post.data.question && <p class="qlist__q">{post.data.question}</p>}
                <h2 class="qlist__t">{post.data.title}</h2>
                <p class="qlist__d">{post.data.description}</p>
                <span class="qlist__meta">
                  <time datetime={post.data.pubDate.toISOString()}>{dateOf(post.data.pubDate)}</time>
                  {post.data.readingTime && <span>{post.data.readingTime}</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <div class="theme__empty fade-up d2">
          <p>
            Nothing published here yet — this theme is still taking root. A
            research routine is already working it, and the first pieces land
            once they survive a human read-through.
          </p>
          {t.id === 'basics' && (
            <p>
              Meanwhile, <a href="/projects/">the setups and projects</a> live on
              their own page.
            </p>
          )}
        </div>
      )
    }

    <nav class="theme__others fade-up d3" aria-label="Other themes">
      <span class="theme__others-k">Other themes</span>
      {others.map((o) => (
        <a href={`/${o.id}/`} style={`--accent:var(--${o.accent})`}>{o.label}</a>
      ))}
    </nav>
  </article>
</Base>

<style>
  .theme { padding-top: 3rem; max-width: 48rem; }

  .theme__ask {
    margin: 0 0 .5rem; font-size: .8125rem; font-weight: 800;
    letter-spacing: .02em; color: var(--accent);
  }
  .theme h1 {
    margin: 0; font-size: clamp(2.2rem, 6vw, 3.4rem); font-weight: 800;
    letter-spacing: -.03em; line-height: 1.05;
  }
  .theme__blurb {
    margin: 1rem 0 0; max-width: 38rem;
    font-size: 1.0625rem; line-height: 1.7; color: var(--ink-soft);
  }

  .qlist { list-style: none; margin: 3rem 0 0; padding: 0; }
  .qlist li + li { margin-top: 1rem; }
  .qlist a {
    display: flex; flex-direction: column; gap: .4rem;
    padding: 1.5rem 1.6rem; border-radius: 18px; text-decoration: none;
    border: 1px solid var(--border); background: var(--card);
    position: relative; overflow: hidden;
    transition: transform .3s var(--ease), border-color .3s var(--ease);
  }
  .qlist a::before {
    content: ''; position: absolute; inset: 0; background: var(--tint);
    opacity: 0; transition: opacity .3s var(--ease);
  }
  .qlist a > * { position: relative; }
  .qlist a:hover, .qlist a:focus-visible { transform: translateY(-3px); border-color: var(--accent); }
  .qlist a:hover::before, .qlist a:focus-visible::before { opacity: 1; }

  .qlist__q {
    margin: 0; font-family: var(--serif); font-size: 1.05rem; line-height: 1.5;
    color: var(--accent);
  }
  .qlist__t {
    margin: 0; font-size: 1.25rem; font-weight: 800; letter-spacing: -.015em;
    line-height: 1.3; color: var(--ink);
  }
  .qlist__d { margin: 0; font-size: .9375rem; line-height: 1.6; color: var(--ink-soft); }
  .qlist__meta {
    margin-top: .5rem; display: flex; gap: .75rem;
    font-size: .625rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink-faint);
  }

  .theme__empty {
    margin-top: 3rem; padding: 1.75rem; border-radius: 18px;
    border: 1px dashed var(--border); background: var(--card);
    font-size: .9375rem; line-height: 1.7; color: var(--ink-soft); max-width: 38rem;
  }
  .theme__empty p { margin: 0; }
  .theme__empty p + p { margin-top: .75rem; }
  .theme__empty a { color: var(--accent); }

  .theme__others {
    margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
  }
  .theme__others-k {
    font-size: .5625rem; font-weight: 800; letter-spacing: .16em;
    text-transform: uppercase; color: var(--ink-faint);
  }
  .theme__others a {
    font-size: .75rem; font-weight: 700; text-decoration: none;
    color: var(--accent); border: 1px solid var(--border); border-radius: 999px;
    padding: .35rem .8rem;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .theme__others a:hover { border-color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .qlist a:hover { transform: none; }
  }
</style>
