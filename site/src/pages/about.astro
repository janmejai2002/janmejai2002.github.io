---
import Base from '../layouts/Base.astro';
import { plateEdge, EDGE_DEPTH } from '../lib/bowl';

// Distinct seed for the about page kintsugi fracture edge
const edge = plateEdge('about-janmejai');
const clip = `polygon(0 0,100% 0,${[...edge].reverse().map(([x, d]) => `${x.toFixed(1)}% calc(100% - ${d.toFixed(1)}px)`).join(',')})`;
const line = edge.map(([x, d]) => `${(x * 10).toFixed(0)},${(EDGE_DEPTH - d).toFixed(1)}`).join(' ');

const timeline = [
  {
    when: '2026',
    what: 'Summer Intern — Risk Modelling',
    where: 'American Express · Bangalore',
    accent: 'plum',
    body: 'Inside the Credit Risk function, on the core modelling side rather than routine reporting.',
    points: [
      'Improved the performance of credit risk rating models covering short- and long-term horizons for the Business portfolio of Card Members. Gains came from systematic variable design rather than blind model search — auditing the construction pipelines of structural risk variables.',
      'Constructed internal custom GPT interfaces querying dense model validation documentation with zero-hallucination source attribution.',
      'Calibrated understanding of interchange economics, closed-loop spend networks, and credit appetite parameters.',
    ],
  },
  {
    when: '2024',
    what: 'Live Project — Enterprise LLM & Market Quantification',
    where: 'Alps Technosystems · Remote',
    accent: 'mizu',
    body: 'Built an LLM-based secure internal AI assistant fetching data from 50k+ proprietary documents using RAG, reducing repetitive internal inquiries by 40%. Modeled the global night-vision goggles industry (USD 8.57 Bn 2025E, 8.5% CAGR).',
  },
  {
    when: '2023',
    what: 'Software Developer, Python',
    where: 'Marg ERP Ltd. · New Delhi',
    accent: 'ochre',
    body: 'Developed a 98% accurate AI SaaS receipt parsing engine that achieved 95% time savings for SME accounting workflows. Analyzed 4,500+ customer reviews to identify 15+ pain points (reducing complaints by 30%), and segmented 300+ enterprise leads via geospatial cluster analysis.',
  },
  {
    when: '2021 – 22',
    what: 'AI Project Lead',
    where: 'Design Innovation Centre (MDaRT) · Chandigarh',
    accent: 'moss',
    body: 'Headed a team of 25+ across 4 verticals with cumulative funding of ₹45L+ across AI & IoT. Orchestrated 15+ workshops delivering 700+ hours to 5,000+ participants, and aided 12+ teams with ₹10Cr+ combined healthcare funding.',
  },
  {
    when: '2021 – 22',
    what: 'Visiting Research Fellow',
    where: 'Nottingham Trent University · UK (Remote)',
    accent: 'indigo',
    body: 'Awarded ₹75K international fellowship (1 of 2 from 1,800+ candidates). Forecasted EV battery internal cell temperatures with 97% accuracy using neural networks, and constructed 4-step pipelines creating 50+ real-time telemetry dashboards.',
  },
];

const competitions = [
  {
    title: 'Godrej LOUD Season 14',
    badge: 'Campus Finalist (Top 14 / 400)',
    detail: 'Ranked top 14 out of 400 candidates nationwide in Sales & Marketing strategy.',
  },
  {
    title: 'Accenture B-School Challenge Season 9',
    badge: 'Campus Finalist (Top 640 / 11,701)',
    detail: 'Campus finalist among top 640 out of 11,701 participants across top tier Indian business schools.',
  },
  {
    title: 'Airtel i-Create Challenge',
    badge: 'Campus Finalist (Top 5% Nationwide)',
    detail: 'Ranked campus finalist among top 32/268 teams; top 5% nationwide out of 5,700+ competing teams.',
  },
];

const papers = [
  {
    title: 'Fused framework for glaucoma diagnosis using Optical Coherence Tomography images',
    venue: 'Expert Systems with Applications',
    pub: 'Elsevier ScienceDirect',
    impact: '7.5 – 8.6',
    detail: 'Trained 4 fused deep-learning models on 1.1k 3D retinal scans, achieving 96% diagnostic accuracy.',
    accent: 'moss',
  },
  {
    title: 'Denoising techniques for cephalometric X-ray images: a comprehensive review',
    venue: 'Multimedia Tools and Applications',
    pub: 'Springer',
    impact: '3.6',
    detail: 'Comprehensive survey of 10+ AI-based radiographic denoising architectures; 750+ accesses and international citations.',
    accent: 'indigo',
  },
];
---

<Base
  title="Janmejai Singh Minhas — Applied AI & Research"
  description="Janmejai Singh Minhas: applied AI, credit risk modelling at American Express, clinical computer vision research, and XLRI candidate."
  section="About"
  pageType="ProfilePage"
  immersive={true}
  schema={{
    mainEntity: {
      '@type': 'Person',
      name: 'Janmejai Singh Minhas',
      url: 'https://janmejai2002.github.io/about/',
      affiliation: { '@type': 'EducationalOrganization', name: 'XLRI' },
      alumniOf: { '@type': 'EducationalOrganization', name: 'UIET Panjab University, Chandigarh' },
      sameAs: [
        'https://github.com/janmejai2002',
        'https://linkedin.com/in/janmejai',
        'https://app.grayswan.ai/',
      ],
    },
  }}
>
  <!-- Full-Bleed Dark Glazed Ceramic Plate with Gold Fractured Edge -->
  <section class="pg-plate" style={`clip-path:${clip}`}>
    <div class="wrap pg-plate__in">
      <span class="hanko">Colophon</span>
      <h1>Janmejai Singh <span class="hl">Minhas</span></h1>
      <p class="lede">
        I build machine learning systems that have to work outside a notebook — and I break
        other people's. My background spans credit risk modelling at American Express,
        peer-reviewed medical imaging research (Elsevier, Springer), and adversarial red-teaming
        on frontier AI models. Currently studying at XLRI.
      </p>

      <div class="plate-links">
        <a href="https://linkedin.com/in/janmejai" rel="noopener me" target="_blank">LinkedIn</a>
        <a href="https://github.com/janmejai2002" rel="noopener me" target="_blank">GitHub</a>
        <a href="https://app.grayswan.ai/" rel="noopener" target="_blank">Gray Swan Profile</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </div>
  </section>

  <!-- Gold Fracture Edge Transition -->
  <svg class="pg-edge" viewBox={`0 0 1000 ${EDGE_DEPTH}`} preserveAspectRatio="none" aria-hidden="true">
    <polyline points={line} vector-effect="non-scaling-stroke" />
  </svg>

  <div class="wrap pg-body">
    <!-- Stat Band -->
    <div class="statband fade-up d1">
      <div class="stat" style="--accent:var(--hanko)">
        <span class="stat__n" data-count="352" data-prefix="#">#352</span>
        <span class="stat__k">Gray Swan global rank</span>
      </div>
      <div class="stat" style="--accent:var(--mizu)">
        <span class="stat__n" data-count="36">36</span>
        <span class="stat__k">Unique model breaks</span>
      </div>
      <div class="stat" style="--accent:var(--ochre)">
        <span class="stat__n" data-count="414">414</span>
        <span class="stat__k">Attack submissions</span>
      </div>
      <div class="stat" style="--accent:var(--moss)">
        <span class="stat__n" data-count="2">2</span>
        <span class="stat__k">Peer-reviewed papers</span>
      </div>
    </div>

    <!-- Career & Research Timeline -->
    <section class="sec scroll-reveal" style="--accent:var(--mizu)">
      <h2 class="sec__h">
        <span class="sec__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
          </svg>
        </span>
        Experience &amp; Research
      </h2>

      <ol class="tl">
        {timeline.map((t) => (
          <li style={`--accent:var(--${t.accent})`}>
            <span class="tl__when">{t.when}</span>
            <div class="tl__body">
              <h3>{t.what}</h3>
              <span class="tl__where">{t.where}</span>
              <p>{t.body}</p>
              {t.points && (
                <ul class="tl__points">
                  {t.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Published Research -->
    <section class="sec scroll-reveal" style="--accent:var(--moss)">
      <h2 class="sec__h">
        <span class="sec__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          </svg>
        </span>
        Published Research
      </h2>

      <div class="papers">
        {papers.map((p) => (
          <article class="paper" style={`--accent:var(--${p.accent})`}>
            <h3>{p.title}</h3>
            <p class="paper__detail">{p.detail}</p>
            <div class="paper__meta">
              <span class="paper__venue">{p.venue}</span>
              <span class="paper__pub">{p.pub}</span>
              <span class="paper__if">IF {p.impact}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- National Case Finals & Leadership -->
    <section class="sec scroll-reveal" style="--accent:var(--ochre)">
      <h2 class="sec__h">
        <span class="sec__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
            <path d="M4 22h16"/>
            <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
            <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
            <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
          </svg>
        </span>
        National Case Competitions
      </h2>

      <div class="papers">
        {competitions.map((c) => (
          <article class="paper" style="--accent:var(--ochre)">
            <h3>{c.title}</h3>
            <p class="paper__detail">{c.detail}</p>
            <div class="paper__meta">
              <span class="paper__venue">{c.badge}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Education & Stack -->
    <section class="sec scroll-reveal" style="--accent:var(--plum)">
      <h2 class="sec__h">
        <span class="sec__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 9L12 4 2 9l10 5 10-5z" /><path d="M6 11.5V17c0 1 3 3 6 3s6-2 6-3v-5.5" />
          </svg>
        </span>
        Education &amp; Toolkit
      </h2>

      <div class="factgrid">
        <div class="fact" style="--accent:var(--plum);--tint:var(--wash-plum)">
          <div class="fact__k">Postgraduate</div>
          <div class="fact__v">
            MBA (BM)
            <span>XLRI (Candidate 2025–27)</span>
          </div>
        </div>
        <div class="fact" style="--accent:var(--plum);--tint:var(--wash-plum)">
          <div class="fact__k">Undergraduate</div>
          <div class="fact__v">
            B.E. (Hons) Information Technology
            <span>UIET Panjab University, Chandigarh · 8.32/10</span>
          </div>
        </div>
        <div class="fact" style="--accent:var(--mizu);--tint:var(--wash-mizu)">
          <div class="fact__k">Core Stack</div>
          <div class="fact__v">
            Python · PyTorch · TensorFlow
            <span>OpenCV, scikit-learn, FastAPI, RAG</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Dark Plate Hero Matching the wAIbi-sabi Home Style */
  .pg-plate {
    position: relative;
    color: var(--tldr-ink);
    background: var(--tldr-bg);
  }
  .pg-plate::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55rem 30rem at 92% -10%, color-mix(in srgb, var(--mizu) 14%, transparent), transparent 70%),
      radial-gradient(45rem 25rem at 5% 105%, color-mix(in srgb, var(--plum) 12%, transparent), transparent 70%);
    pointer-events: none;
  }
  .pg-plate__in {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.5rem, 4.5vw, 4rem) calc(22px + clamp(2rem, 3.5vw, 3rem));
  }
  .pg-plate h1 {
    margin: 0.6rem 0 1rem;
    font-size: clamp(2.3rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--tldr-ink);
    text-wrap: balance;
  }
  .pg-plate .lede {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--tldr-dim);
    margin: 0 0 1.75rem;
    max-width: 44rem;
  }
  .pg-edge {
    display: block;
    position: relative;
    width: 100%;
    height: 22px;
    margin-top: -22px;
    overflow: visible;
    pointer-events: none;
  }
  .pg-edge polyline {
    fill: none;
    stroke: var(--ochre);
    stroke-width: 1.75;
    stroke-linejoin: miter;
  }
  .plate-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .plate-links a {
    box-shadow: none;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--tldr-hair);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tldr-dim);
    text-decoration: none;
    transition: all 0.25s;
  }
  .plate-links a:hover {
    background: var(--tldr-ink);
    color: var(--tldr-bg);
    border-color: var(--tldr-ink);
  }

  .pg-body {
    padding-top: clamp(2.5rem, 4vw, 3.75rem);
    padding-bottom: 5rem;
    max-width: var(--measure);
  }

  /* Stat band */
  .statband {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.6rem;
    margin: 0 0 3.25rem;
  }
  .stat {
    padding: 1.1rem 1rem;
    border-radius: 14px;
    border: 1px solid var(--border);
    border-bottom: 3px solid var(--accent);
    background: var(--card);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .stat:hover { transform: translateY(-3px); }
  .stat__n {
    display: block;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .stat__k {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.5625rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* Section shell */
  .sec { margin-top: 3.5rem; }
  .sec__h {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 1.5rem;
  }
  .sec__icon {
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 9px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }
  .sec__icon svg { width: 15px; height: 15px; }

  /* Timeline */
  .tl { list-style: none; margin: 0; padding: 0; position: relative; }
  .tl::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--border);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 4rem, #000 calc(100% - 4rem), transparent);
    mask-image: linear-gradient(180deg, transparent, #000 4rem, #000 calc(100% - 4rem), transparent);
  }
  @media (min-width: 620px) { .tl::before { left: 7.5rem; } }
  .tl > li { position: relative; padding: 0 0 1.75rem 1.75rem; }
  @media (min-width: 620px) {
    .tl > li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1.75rem; padding-left: 0; }
  }
  .tl > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42rem;
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: var(--paper);
    border: 2.5px solid var(--accent);
    z-index: 1;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.45s;
  }
  .tl > li:hover::before {
    transform: scale(1.25);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 16%, transparent);
  }
  @media (min-width: 620px) { .tl > li::before { left: calc(7.5rem - 5px); } }
  .tl__when {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    display: block;
    margin-bottom: 0.35rem;
  }
  @media (min-width: 620px) {
    .tl__when {
      text-align: right;
      margin-bottom: 0;
      padding-top: 0.12rem;
      padding-right: 0.95rem;
    }
  }
  .tl__body h3 { font-size: 0.95rem; font-weight: 700; margin: 0 0 0.2rem; color: var(--ink); }
  .tl__where { font-size: 0.75rem; color: var(--ink-faint); font-weight: 600; }
  .tl__body p { margin: 0.55rem 0 0; font-size: 0.875rem; line-height: 1.62; color: var(--ink-soft); }
  .tl__points { margin: 0.7rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .tl__points li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .tl__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--accent);
    opacity: 0.75;
  }

  /* Papers & Cards */
  .papers { display: grid; gap: 0.85rem; }
  .paper {
    padding: 1.25rem 1.35rem;
    border-radius: 14px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    background: var(--card);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s;
  }
  .paper:hover { transform: translateY(-2px); box-shadow: 0 12px 26px var(--shadow); }
  .paper h3 {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 0.4rem;
    color: var(--ink);
    text-wrap: balance;
  }
  .paper__detail {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 0.65rem;
  }
  .paper__meta { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center; }
  .paper__venue, .paper__pub, .paper__if {
    font-size: 0.5625rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.22rem 0.5rem;
    border-radius: 5px;
  }
  .paper__venue {
    color: var(--ink);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid var(--accent);
  }
  .paper__pub { color: var(--ink-faint); border: 1px solid var(--border); }
  .paper__if { color: var(--ink-faint); border: 1px solid var(--border); font-variant-numeric: tabular-nums; }

  /* Factgrid */
  .factgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.7rem;
  }
  .fact {
    padding: 1rem 1.1rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--card);
  }
  .fact__k {
    font-size: 0.5625rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.35rem;
  }
  .fact__v {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.4;
  }
  .fact__v span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-soft);
  }
</style>

<script>
  // Counter animation
  const stats = [...document.querySelectorAll<HTMLElement>('.stat__n')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stats.length && !reduce) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          io.unobserve(el);
          const target = Number(el.dataset.count ?? 0);
          const prefix = el.dataset.prefix ?? '';
          const dur = 900;
          const t0 = performance.now();
          const tick = (now: number) => {
            const p = Math.min((now - t0) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = prefix + Math.round(target * eased).toLocaleString('en-IN');
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.4 }
    );
    stats.forEach((s) => io.observe(s));
  }
</script>
