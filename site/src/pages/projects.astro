---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import { projects, PROJECT_CATEGORIES } from '../data/projects';

const featuredProject = projects.find((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);

const categoryCounts = Object.fromEntries(
  PROJECT_CATEGORIES.map((cat) => [
    cat.id,
    cat.id === 'all' ? projects.length : projects.filter((p) => p.category === cat.id).length,
  ])
);
---

<Base
  title="Projects & Systems — wAIbi-sabi"
  description="Production architectures and empirical research by Janmejai Singh Minhas: autonomous AI publishing pipelines, frontier model red-teaming, credit risk RAG, bio-imaging, and sovereign edge computing."
  section="Projects"
  wide
  keywords={[
    'building with Claude Code',
    'autonomous AI agent pipelines',
    'frontier AI red teaming',
    'Gray Swan Arena breaks',
    'credit risk modelling RAG',
    'medical computer vision research',
    'serverless content architecture',
    'Astro content architecture',
  ]}
>
  {/* Landing Page Masthead / Hero */}
  <section class="proj-mast fade-up d1">
    <div class="proj-mast__badge">
      <span class="hanko">Systems & Research</span>
      <span class="proj-mast__count">{projects.length} Active Systems</span>
    </div>

    <h1 class="proj-mast__title">
      Systems built to work <br />
      <span class="hl hl--plum">outside a notebook</span>
    </h1>

    <p class="proj-mast__lede">
      Working architectures, empirical safety research, and production pipelines — not throwaway demos.
      Engineered with verified benchmarks, zero standing server costs, and strict human-in-the-loop gates.
    </p>

    {/* Hero Key Metrics Strip */}
    <div class="metrics-grid">
      <div class="metric-card" style="--m-accent:var(--mizu);--m-wash:var(--wash-mizu)">
        <span class="metric-card__val">6</span>
        <span class="metric-card__lbl">Production Systems</span>
        <span class="metric-card__sub">Zero dead demos</span>
      </div>
      <div class="metric-card" style="--m-accent:var(--hanko);--m-wash:var(--wash-hanko)">
        <span class="metric-card__val">36</span>
        <span class="metric-card__lbl">Frontier Model Breaks</span>
        <span class="metric-card__sub">Gray Swan Arena verified</span>
      </div>
      <div class="metric-card" style="--m-accent:var(--ochre);--m-wash:var(--wash-ochre)">
        <span class="metric-card__val">603+</span>
        <span class="metric-card__lbl">MBA Placement Cases</span>
        <span class="metric-card__sub">Daily cloud feeder sync</span>
      </div>
      <div class="metric-card" style="--m-accent:var(--moss);--m-wash:var(--wash-moss)">
        <span class="metric-card__val">8.6</span>
        <span class="metric-card__lbl">Journal Impact Factor</span>
        <span class="metric-card__sub">Elsevier ESWA Published</span>
      </div>
      <div class="metric-card" style="--m-accent:var(--indigo);--m-wash:var(--wash-indigo)">
        <span class="metric-card__val">0</span>
        <span class="metric-card__lbl">Cloud Server Cost</span>
        <span class="metric-card__sub">100% Serverless Loops</span>
      </div>
    </div>
  </section>

  <div class="rulebar fade-up d2" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

  {/* Interactive Category Filter Bar */}
  <section class="filter-section fade-up d2">
    <div class="filter-header">
      <span class="filter-label">Filter Systems:</span>
      <div class="filter-bar" role="tablist" aria-label="Project categories">
        {PROJECT_CATEGORIES.map((cat) => (
          <button
            type="button"
            class={`filter-pill ${cat.id === 'all' ? 'is-active' : ''}`}
            data-filter={cat.id}
            role="tab"
            aria-selected={cat.id === 'all' ? 'true' : 'false'}
          >
            <span>{cat.label}</span>
            <span class="pill-count">{categoryCounts[cat.id]}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* Flagship Featured Showcase */}
  {featuredProject && (
    <section class="flagship-section project-entry" data-category={featuredProject.category}>
      <div class="sec-label">
        <span class="sec-label__eyebrow">Flagship Architecture</span>
        <span class="sec-label__rule"></span>
      </div>

      <article
        class="proj proj--flagship scroll-reveal"
        style={`--accent:${featuredProject.accent};--tint:${featuredProject.wash}`}
      >
        <header class="proj__head">
          <div class="proj__meta-row">
            <span class="proj__tag">{featuredProject.tag}</span>
            <span class="proj__category-badge">{featuredProject.categoryLabel}</span>
          </div>

          <h2 class="proj__flagship-title">{featuredProject.title}</h2>
          <p class="proj__lede">{featuredProject.lede}</p>

          {featuredProject.stats && (
            <div class="proj__stats-strip">
              {featuredProject.stats.map((s) => (
                <div class="stat-pill">
                  <span class="stat-pill__val">{s.value}</span>
                  <span class="stat-pill__lbl">{s.label}</span>
                </div>
              ))}
            </div>
          )}
        </header>

        <div class="body proj__cols">
          <div class="proj__colA">
            <h3>What it does</h3>
            <p>{featuredProject.whatItDoes}</p>

            {featuredProject.stack && (
              <div class="proj__stack-pills">
                <span class="stack-label">Stack & Tooling</span>
                <div class="pill-group">
                  {featuredProject.stack.map((st) => (
                    <span class="tech-pill">{st}</span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div class="proj__colB">
            <h3>The architecture pieces</h3>
            <div class="stack">
              {featuredProject.pieces?.map((piece) => (
                <div class="layer">
                  <span class="layer__k">{piece.k}</span>
                  <p>{piece.v}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="proj__colC">
            <h3>Engineering lessons before you copy it</h3>
            <ul class="takeaway-list">
              {featuredProject.takeaways?.map((t) => (
                <li>
                  <strong>{t.title}</strong> {t.text}
                </li>
              ))}
            </ul>

            {featuredProject.deepDiveLink && (
              <div class="proj__cta-box">
                <a class="flagship-cta" href={featuredProject.deepDiveLink.href}>
                  <span>{featuredProject.deepDiveLink.label}</span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
                {featuredProject.deepDiveLink.note && (
                  <p class="cta-note">{featuredProject.deepDiveLink.note}</p>
                )}
              </div>
            )}
          </div>
        </div>
      </article>
    </section>
  )}

  {/* Modular Systems & Research Portfolio */}
  <section class="portfolio-section">
    <div class="sec-label">
      <span class="sec-label__eyebrow">Systems, Research & Production Engines</span>
      <span class="sec-label__rule"></span>
    </div>

    <div class="proj__grid">
      {otherProjects.map((p, idx) => (
        <div class="project-entry" data-category={p.category}>
          <article
            class="proj proj--card scroll-reveal"
            style={`--accent:${p.accent};--tint:${p.wash};transition-delay:${(idx % 4) * 0.08}s`}
          >
            <div class="proj__card-content">
              <header class="proj__head">
                <div class="proj__meta-row">
                  <span class="proj__tag">{p.tag}</span>
                  <span class="proj__category-badge">{p.categoryLabel}</span>
                </div>

                <h3 class="proj__card-title">{p.title}</h3>
                <p class="proj__lede">{p.lede}</p>

                {p.metrics && (
                  <div class="proj__stats-strip">
                    {p.metrics.map((m) => (
                      <div class="stat-pill">
                        <span class="stat-pill__val">{m.value}</span>
                        <span class="stat-pill__lbl">{m.label}</span>
                      </div>
                    ))}
                  </div>
                )}
              </header>

              {p.highlights && (
                <div class="proj__highlights">
                  <h4 class="proj__sub-label">Highlights & Technical Receipts</h4>
                  <ul>
                    {p.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <div class="proj__card-footer">
              {p.stack && (
                <div class="proj__stack-pills">
                  <div class="pill-group">
                    {p.stack.map((st) => (
                      <span class="tech-pill">{st}</span>
                    ))}
                  </div>
                </div>
              )}

              {p.links && p.links.length > 0 && (
                <div class="proj__actions">
                  {p.links.map((lnk) => (
                    <a
                      class="proj__cta"
                      href={lnk.href}
                      target={lnk.external ? '_blank' : undefined}
                      rel={lnk.external ? 'noopener noreferrer' : undefined}
                    >
                      <span>{lnk.label}</span>
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        </div>
      ))}
    </div>
  </section>

  {/* Engineering Invariants & Philosophy Section */}
  <section class="invariants-section scroll-reveal">
    <div class="sec-label">
      <span class="sec-label__eyebrow">Operating Invariants</span>
      <span class="sec-label__rule"></span>
    </div>

    <div class="invariants-card">
      <div class="invariants-header">
        <span class="hanko">Philosophy</span>
        <h2>How I Build Systems</h2>
        <p>
          Lessons derived from building unattended agent pipelines, testing frontier model failure modes,
          and training clinical computer vision models where reliability is non-negotiable.
        </p>
      </div>

      <div class="invariants-grid">
        <div class="inv-item">
          <span class="inv-num">01</span>
          <h4>The Human Gate at the Decision Surface</h4>
          <p>
            Research, drafting, and SVG rendering are cheap to automate. Deciding what is worth an
            audience's attention is not. Put human judgment where discretion lives.
          </p>
        </div>

        <div class="inv-item">
          <span class="inv-num">02</span>
          <h4>State Barriers Over Intentions</h4>
          <p>
            An instruction in prose saying "do not auto-publish" is easily bypassed under stochastic
            sampling. A state barrier where the machine literally lacks the credentials to set
            <code>Approved</code> will never fail.
          </p>
        </div>

        <div class="inv-item">
          <span class="inv-num">03</span>
          <h4>System 1 (Deterministic) vs System 2 (Probabilistic)</h4>
          <p>
            Never ask an LLM to count characters, parse XML, or assert HTTP endpoints. Let Node.js
            scripts enforce contracts in sub-10ms, reserving models strictly for synthesis.
          </p>
        </div>

        <div class="inv-item">
          <span class="inv-num">04</span>
          <h4>Credentials That Cannot Expire</h4>
          <p>
            Unattended routines firing at 06:00 IST cannot depend on interactive browser sessions or
            OAuth refresh tokens that require a human to re-log in.
          </p>
        </div>

        <div class="inv-item">
          <span class="inv-num">05</span>
          <h4>Quarantine Raw Context</h4>
          <p>
            Never inject raw web scrapes or multi-megabyte crawls into prompt context. Quarantine
            scrapes to scratchpads, extracting only verified claim ledgers with verbatim quotes.
          </p>
        </div>

        <div class="inv-item">
          <span class="inv-num">06</span>
          <h4>Verify at the Live Edge</h4>
          <p>
            Never mark a database row published simply because a build command exited with code 0.
            Assert live HTTP 200 delivery with headline confirmation over the public network.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    const pills = document.querySelectorAll('.filter-pill');
    const items = document.querySelectorAll('.project-entry');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-filter');

        pills.forEach((p) => {
          p.classList.remove('is-active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('is-active');
        pill.setAttribute('aria-selected', 'true');

        items.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          if (cat === 'all' || itemCat === cat) {
            item.style.display = '';
            item.classList.remove('is-hidden');
          } else {
            item.style.display = 'none';
            item.classList.add('is-hidden');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Landing Masthead */
  .proj-mast {
    margin: 1.5rem 0 2rem;
    max-width: 58rem;
  }
  .proj-mast__badge {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    margin-bottom: 1rem;
  }
  .proj-mast__count {
    font-size: .6875rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: color-mix(in srgb, var(--paper-2) 80%, transparent);
    padding: .25rem .65rem;
    border-radius: 999px;
    border: 1px solid var(--border-soft);
  }
  .proj-mast__title {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -.03em;
    margin: 0 0 1.25rem;
    text-wrap: balance;
  }
  .proj-mast__lede {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 2.25rem;
    max-width: 48rem;
    text-wrap: pretty;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .85rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 48rem) {
    .metrics-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .metric-card {
    background: var(--m-wash, var(--wash-mizu));
    border: 1px solid var(--border-soft);
    border-top: 3px solid var(--m-accent, var(--mizu));
    border-radius: 14px;
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    transition: transform var(--dur-fast) var(--ease);
  }
  .metric-card:hover {
    transform: translateY(-2px);
  }
  .metric-card__val {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -.02em;
    color: var(--m-accent, var(--mizu));
    font-variant-numeric: tabular-nums;
  }
  .metric-card__lbl {
    font-size: .6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--ink);
    margin-top: .4rem;
  }
  .metric-card__sub {
    font-size: .625rem;
    color: var(--ink-soft);
    margin-top: .2rem;
  }

  /* Palette Rulebar */
  .rulebar { display: flex; gap: 3px; margin: 2.5rem 0; }
  .rulebar span {
    height: 3px; flex: 1; border-radius: 2px;
    transform-origin: left; animation: stretch .8s var(--ease) both;
  }
  .rulebar span:nth-child(1) { background: var(--mizu); animation-delay: .15s; }
  .rulebar span:nth-child(2) { background: var(--ochre); animation-delay: .22s; }
  .rulebar span:nth-child(3) { background: var(--moss); animation-delay: .29s; }
  .rulebar span:nth-child(4) { background: var(--plum); animation-delay: .36s; }
  .rulebar span:nth-child(5) { background: var(--hanko); animation-delay: .43s; }
  .rulebar span:nth-child(6) { background: var(--indigo); animation-delay: .5s; }
  @keyframes stretch { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* Section Labels */
  .sec-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2.5rem 0 1.5rem;
  }
  .sec-label__eyebrow {
    font-size: .6875rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .sec-label__rule {
    height: 1px;
    flex: 1;
    background: var(--border-soft);
  }

  /* Filter Section */
  .filter-section {
    margin: 1.5rem 0 2rem;
  }
  .filter-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .filter-label {
    font-size: .6875rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
  }
  .filter-pill {
    appearance: none;
    background: color-mix(in srgb, var(--paper) 70%, transparent);
    border: 1px solid var(--border);
    color: var(--ink-soft);
    font-size: .6875rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .45rem .85rem;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    transition: all var(--dur-fast) var(--ease);
  }
  .filter-pill:hover {
    color: var(--ink);
    border-color: var(--ink-soft);
    transform: translateY(-1px);
  }
  .filter-pill.is-active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .pill-count {
    font-size: .5625rem;
    font-weight: 800;
    opacity: .75;
    background: color-mix(in srgb, currentColor 15%, transparent);
    padding: .1rem .4rem;
    border-radius: 999px;
  }

  /* Projects Base Card */
  .proj {
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 18px;
    background: var(--tint);
    padding: 1.75rem;
    margin-bottom: 1.75rem;
    transition: transform var(--dur-fast) var(--ease),
                border-left-width var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease),
                box-shadow var(--dur-fast) var(--ease);
  }
  .proj:hover, .proj:focus-within {
    transform: translateY(-3px);
    border-left-width: 5px;
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: 0 14px 28px -12px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  @media (min-width: 768px) {
    .proj { padding: 2.25rem 2.5rem; }
  }

  .proj__meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: .6rem;
  }
  .proj__tag {
    font-size: .625rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .proj__category-badge {
    font-size: .5625rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    padding: .2rem .55rem;
    border-radius: 6px;
    border: 1px solid var(--border-soft);
  }

  .proj__flagship-title {
    font-size: clamp(1.5rem, 3.8vw, 2.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -.02em;
    margin: .5rem 0 .75rem;
    text-wrap: balance;
  }
  .proj__card-title {
    font-size: clamp(1.25rem, 2.5vw, 1.55rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -.015em;
    margin: .4rem 0 .65rem;
    color: var(--ink);
  }
  .proj__lede {
    font-size: .95rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  /* Stats Bar */
  .proj__stats-strip {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin: 1.25rem 0 .5rem;
    padding-top: 1rem;
    border-top: 1px dashed color-mix(in srgb, var(--accent) 25%, var(--border));
  }
  .stat-pill {
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--paper) 70%, transparent);
    border: 1px solid var(--border-soft);
    padding: .45rem .85rem;
    border-radius: 8px;
    min-width: 5rem;
  }
  .stat-pill__val {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .stat-pill__lbl {
    font-size: .5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--ink-soft);
    margin-top: .15rem;
  }

  /* Flagship 3-Column Prose / Rails */
  .proj .body { margin-top: 2rem; }
  .proj__colA, .proj__colC { max-width: var(--measure); min-width: 0; }
  .proj__colB { min-width: 0; }
  .proj__colB h3:first-child { margin-top: 2.25rem; }

  @media (min-width: 60rem) {
    .proj__cols {
      display: grid;
      column-gap: 3rem;
      grid-template-columns: minmax(0, var(--measure)) minmax(16rem, 1fr);
      grid-template-areas: 'a b' 'c b';
      align-items: start;
    }
    .proj__colA { grid-area: a; }
    .proj__colB { grid-area: b; }
    .proj__colC { grid-area: c; }
    .proj__colA h3:first-child, .proj__colB h3:first-child { margin-top: 0; }
  }

  .proj .body h3,
  .proj__sub-label {
    font-size: .6875rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 1.75rem 0 .8rem;
  }
  .proj__colA > p {
    font-size: .95rem;
    line-height: 1.65;
    font-weight: 400;
    margin: 0 0 1.25rem;
  }

  .stack { display: grid; gap: .6rem; }
  .layer {
    background: color-mix(in srgb, var(--paper) 60%, transparent);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
