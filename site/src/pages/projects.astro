---
import Base from '../layouts/Base.astro';
import { projects, PROJECT_CATEGORIES } from '../data/projects';

const featuredProject = projects.find((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<Base
  title="Projects & Setups — wAIbi-sabi"
  description="Working systems and research by Janmejai Singh Minhas: autonomous AI publishing pipelines, frontier model red-teaming, credit risk RAG, bio-imaging, and sovereign edge computing."
  section="Setups"
  keywords={[
    'building with Claude Code',
    'autonomous AI agent pipelines',
    'frontier AI red teaming',
    'Gray Swan Arena breaks',
    'credit risk modelling RAG',
    'medical computer vision research',
    'Astro content architecture',
  ]}
>
  <section class="hero fade-up d1" style="padding-bottom:1.5rem">
    <span class="hanko">Setups & Research</span>
    <h1>Systems built <span class="hl hl--plum">to work</span></h1>
    <p>
      Working systems, empirical research, and production pipelines — not throwaway demos.
      What they do, how the components integrate, and the engineering decisions behind them.
    </p>
  </section>

  <div class="rulebar fade-up d2" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

  {/* Category Filter Pills */}
  <div class="filter-bar fade-up d2" role="tablist" aria-label="Project categories">
    {PROJECT_CATEGORIES.map((cat) => (
      <button
        type="button"
        class={`filter-pill ${cat.id === 'all' ? 'is-active' : ''}`}
        data-filter={cat.id}
        role="tab"
        aria-selected={cat.id === 'all' ? 'true' : 'false'}
      >
        {cat.label}
      </button>
    ))}
  </div>

  {/* Flagship Featured Project */}
  {featuredProject && (
    <div class="project-entry" data-category={featuredProject.category}>
      <article
        class="proj proj--flagship scroll-reveal"
        style={`--accent:${featuredProject.accent};--tint:${featuredProject.wash}`}
      >
        <header class="proj__head">
          <div class="proj__meta-row">
            <span class="proj__tag">{featuredProject.tag}</span>
            <span class="proj__category-badge">{featuredProject.categoryLabel}</span>
          </div>
          <h2>{featuredProject.title}</h2>
          <p class="proj__lede">{featuredProject.lede}</p>

          {featuredProject.stats && (
            <div class="proj__stats-strip">
              {featuredProject.stats.map((s) => (
                <div class="stat-pill">
                  <span class="stat-pill__val">{s.value}</span>
                  <span class="stat-pill__lbl">{s.label}</span>
                </div>
              ))}
            </div>
          )}
        </header>

        <div class="body proj__cols">
          <div class="proj__colA">
            <h3>What it does</h3>
            <p>{featuredProject.whatItDoes}</p>

            {featuredProject.stack && (
              <div class="proj__stack-pills">
                <span class="stack-label">Stack</span>
                <div class="pill-group">
                  {featuredProject.stack.map((st) => (
                    <span class="tech-pill">{st}</span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div class="proj__colB">
            <h3>The pieces</h3>
            <div class="stack">
              {featuredProject.pieces?.map((piece) => (
                <div class="layer">
                  <span class="layer__k">{piece.k}</span>
                  <p>{piece.v}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="proj__colC">
            <h3>What I would tell you before you copy it</h3>
            <ul>
              {featuredProject.takeaways?.map((t) => (
                <li>
                  <strong>{t.title}</strong> {t.text}
                </li>
              ))}
            </ul>

            {featuredProject.deepDiveLink && (
              <p class="proj__note">
                <a href={featuredProject.deepDiveLink.href}>
                  {featuredProject.deepDiveLink.label}
                </a>
                {featuredProject.deepDiveLink.note && (
                  <span> — {featuredProject.deepDiveLink.note}</span>
                )}
              </p>
            )}
          </div>
        </div>
      </article>
    </div>
  )}

  {/* Modular Projects Grid */}
  <section class="section-block">
    <div class="section-head">
      <h2 class="section-title">Systems & Research Portfolio</h2>
      <p class="section-sub">
        Explore ongoing AI safety research, specialized production systems, and applied clinical AI.
      </p>
    </div>

    <div class="proj__grid">
      {otherProjects.map((p, idx) => (
        <div class="project-entry" data-category={p.category}>
          <article
            class="proj proj--card scroll-reveal"
            style={`--accent:${p.accent};--tint:${p.wash};transition-delay:${idx * 0.05}s`}
          >
            <header class="proj__head">
              <div class="proj__meta-row">
                <span class="proj__tag">{p.tag}</span>
                <span class="proj__category-badge">{p.categoryLabel}</span>
              </div>
              <h3 class="proj__card-title">{p.title}</h3>
              <p class="proj__lede">{p.lede}</p>

              {p.metrics && (
                <div class="proj__stats-strip">
                  {p.metrics.map((m) => (
                    <div class="stat-pill">
                      <span class="stat-pill__val">{m.value}</span>
                      <span class="stat-pill__lbl">{m.label}</span>
                    </div>
                  ))}
                </div>
              )}
            </header>

            {p.highlights && (
              <div class="proj__highlights">
                <h4 class="proj__sub-label">Key Highlights</h4>
                <ul>
                  {p.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            )}

            {p.stack && (
              <div class="proj__stack-pills">
                <div class="pill-group">
                  {p.stack.map((st) => (
                    <span class="tech-pill">{st}</span>
                  ))}
                </div>
              </div>
            )}

            {p.links && p.links.length > 0 && (
              <div class="proj__actions">
                {p.links.map((lnk) => (
                  <a
                    class="proj__cta"
                    href={lnk.href}
                    target={lnk.external ? '_blank' : undefined}
                    rel={lnk.external ? 'noopener noreferrer' : undefined}
                  >
                    <span>{lnk.label}</span>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                ))}
              </div>
            )}
          </article>
        </div>
      ))}
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    const pills = document.querySelectorAll('.filter-pill');
    const items = document.querySelectorAll('.project-entry');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-filter');

        pills.forEach((p) => {
          p.classList.remove('is-active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('is-active');
        pill.setAttribute('aria-selected', 'true');

        items.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          if (cat === 'all' || itemCat === cat) {
            item.style.display = '';
            item.classList.remove('is-hidden');
          } else {
            item.style.display = 'none';
            item.classList.add('is-hidden');
          }
        });
      });
    });
  })();
</script>

<style>
  .rulebar { display: flex; gap: 3px; margin: 2rem 0 2.25rem; }
  .rulebar span {
    height: 3px; flex: 1; border-radius: 2px;
    transform-origin: left; animation: stretch .8s var(--ease) both;
  }
  .rulebar span:nth-child(1) { background: var(--mizu); animation-delay: .15s; }
  .rulebar span:nth-child(2) { background: var(--ochre); animation-delay: .22s; }
  .rulebar span:nth-child(3) { background: var(--moss); animation-delay: .29s; }
  .rulebar span:nth-child(4) { background: var(--plum); animation-delay: .36s; }
  .rulebar span:nth-child(5) { background: var(--hanko); animation-delay: .43s; }
  .rulebar span:nth-child(6) { background: var(--indigo); animation-delay: .5s; }
  @keyframes stretch { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* Filter Bar */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: 2.25rem;
  }
  .filter-pill {
    appearance: none;
    background: color-mix(in srgb, var(--paper) 70%, transparent);
    border: 1px solid var(--border);
    color: var(--ink-soft);
    font-size: .6875rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .45rem .85rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease);
  }
  .filter-pill:hover {
    color: var(--ink);
    border-color: var(--ink-soft);
  }
  .filter-pill.is-active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  /* Base Project Card */
  .proj {
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 18px;
    background: var(--tint);
    padding: 1.75rem;
    margin-bottom: 1.5rem;
    transition: transform var(--dur-fast) var(--ease),
                border-left-width var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease),
                box-shadow var(--dur-fast) var(--ease);
  }
  .proj:hover, .proj:focus-within {
    transform: translateY(-3px);
    border-left-width: 5px;
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: 0 12px 24px -10px color-mix(in srgb, var(--accent) 15%, transparent);
  }
  @media (min-width: 768px) {
    .proj { padding: 2.25rem 2.5rem; }
  }

  .proj__meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: .6rem;
  }
  .proj__tag {
    font-size: .625rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .proj__category-badge {
    font-size: .5625rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    padding: .2rem .55rem;
    border-radius: 6px;
    border: 1px solid var(--border-soft);
  }

  .proj__head h2 {
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -.02em;
    margin: .4rem 0 .75rem;
    text-wrap: balance;
  }
  .proj__card-title {
    font-size: clamp(1.2rem, 2.5vw, 1.45rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -.015em;
    margin: .4rem 0 .65rem;
    color: var(--ink);
  }
  .proj__lede {
    font-size: .9375rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  /* Stats Bar */
  .proj__stats-strip {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin: 1.25rem 0 .5rem;
    padding-top: 1rem;
    border-top: 1px dashed color-mix(in srgb, var(--accent) 25%, var(--border));
  }
  .stat-pill {
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--paper) 70%, transparent);
    border: 1px solid var(--border-soft);
    padding: .45rem .85rem;
    border-radius: 8px;
    min-width: 5rem;
  }
  .stat-pill__val {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .stat-pill__lbl {
    font-size: .5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--ink-soft);
    margin-top: .15rem;
  }

  /* Flagship 3-Column Prose / Rails */
  .proj .body { margin-top: 2rem; }
  .proj__colA, .proj__colC { max-width: var(--measure); min-width: 0; }
  .proj__colB { min-width: 0; }
  .proj__colB h3:first-child { margin-top: 2.25rem; }

  @media (min-width: 60rem) {
    .proj__cols {
      display: grid;
      column-gap: 3rem;
      grid-template-columns: minmax(0, var(--measure)) minmax(16rem, 1fr);
      grid-template-areas: 'a b' 'c b';
      align-items: start;
    }
    .proj__colA { grid-area: a; }
    .proj__colB { grid-area: b; }
    .proj__colC { grid-area: c; }
    .proj__colA h3:first-child, .proj__colB h3:first-child { margin-top: 0; }
  }

  .proj .body h3,
  .proj__sub-label {
    font-size: .6875rem;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 1.75rem 0 .8rem;
  }
  .proj__colA > p, .proj__colC > p:not(.proj__note) {
    font-size: .9375rem;
    line-height: 1.65;
    font-weight: 400;
    margin: 0 0 1.25rem;
  }

  .stack { display: grid; gap: .6rem; }
  .layer {
    background: color-mix(in srgb, var(--paper) 60%, transparent);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: .85rem 1rem;
  }
  .layer__k {
    display: block;
    font-size: .5625rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: .3rem;
  }
  .layer p { margin: 0; font-size: .84rem; line-height: 1.55; }

  .proj__colC ul {
    margin: 0 0 1.5rem;
    padding-left: 1.25rem;
    font-size: .9rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .proj__colC ul li { margin-bottom: .6rem; }

  .proj__note {
    margin-top: 1.5rem;
    padding: .85rem 1.1rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--paper) 60%, transparent);
    border: 1px dashed var(--border);
    font-size: .8125rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .proj__note a {
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  /* Portfolio Section Head */
  .section-block { margin-top: 3.5rem; }
  .section-head { margin-bottom: 2rem; max-width: var(--measure); }
  .section-title {
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -.02em;
    margin: 0 0 .5rem;
  }
  .section-sub {
    font-size: .9375rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  /* Modular Portfolio Grid */
  .proj__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .proj__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
  }
  .proj--card {
    height: 100%;
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .proj__highlights {
    margin-top: 1.25rem;
    flex-grow: 1;
  }
  .proj__highlights ul {
    margin: 0;
    padding-left: 1.15rem;
    font-size: .84rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .proj__highlights ul li {
    margin-bottom: .5rem;
  }

  /* Tech Stack Pills */
  .proj__stack-pills { margin: 1.25rem 0 .5rem; }
  .stack-label {
    display: block;
    font-size: .5625rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: .4rem;
  }
  .pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
  }
  .tech-pill {
    font-size: .625rem;
    font-weight: 600;
    letter-spacing: .04em;
    color: var(--ink);
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    border: 1px solid var(--border-soft);
    padding: .25rem .55rem;
    border-radius: 6px;
  }

  /* Actions / CTA */
  .proj__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px dashed color-mix(in srgb, var(--accent) 25%, var(--border));
  }
  .proj__cta {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    font-size: .625rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
    background: var(--ink);
    padding: .55rem .95rem;
    border-radius: 999px;
    transition: transform var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .proj__cta svg {
    width: 12px;
    height: 12px;
    transition: transform var(--dur-fast) var(--ease);
  }
  .proj__cta:hover {
    transform: translateY(-2px);
    background: var(--accent);
  }
  .proj__cta:hover svg {
    transform: translateX(3px);
  }

  .is-hidden { display: none !important; }

  @media (prefers-reduced-motion: reduce) {
    .rulebar span { animation: none; transform: none; }
    .proj:hover, .proj:focus-within, .proj__cta:hover { transform: none; }
    .proj__cta svg { transition: none; }
  }
</style>
