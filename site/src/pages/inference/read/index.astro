---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { plateEdge, EDGE_DEPTH } from '../../../lib/bowl';
import { INFERENCE_STATS, INFERENCE_TRACK_GROUPS, INFERENCE_UNITS, type InferenceUnit } from '../../../data/inference';

const freeEntries = (await getCollection('inference')).sort((a, b) => a.data.order - b.data.order);

const edge = plateEdge('inference-read');
const clip = `polygon(0 0, 100% 0, ${[...edge].reverse().map(([x, d]) => `${x.toFixed(1)}% calc(100% - ${d.toFixed(1)}px)`).join(',')})`;
const line = edge.map(([x, d]) => `${(x * 10).toFixed(0)},${(EDGE_DEPTH - d).toFixed(1)}`).join(' ');

const lockedUnits = INFERENCE_UNITS.filter((u) => !u.isFree);

const FILTER_BAR = [
  { id: 'all', label: `All ${INFERENCE_UNITS.length}`, accent: 'ochre' },
  { id: 'free', label: `Free Only (${INFERENCE_STATS.unitsFree})`, accent: 'moss' },
  { id: 'foundations', label: 'Foundations', accent: 'mizu' },
  { id: 'consulting', label: 'Consulting', accent: 'hanko' },
  { id: 'marketing', label: 'Marketing', accent: 'mizu' },
  { id: 'product', label: 'Product', accent: 'plum' },
  { id: 'operations', label: 'Operations', accent: 'moss' },
  { id: 'finance', label: 'Finance', accent: 'ochre' },
  { id: 'hr', label: 'HR & People', accent: 'indigo' },
  { id: 'inserts', label: 'Inserts', accent: 'ochre' },
] as const;

function getUnitDepth(u: InferenceUnit): string {
  if (u.id === 'ai-casebook') return 'Casebook · 10 cases & 10 guesstimates (~25 min study)';
  if (u.id === 'hr-casebook') return 'Casebook · 4 cases & 4 guesstimates (~16 min study)';
  if (u.id.endsWith('casebook')) return 'Casebook · 8 worked cases & rubrics (~22 min study)';
  if (u.id === 'interview-room') return 'Interview drills · Screening & live rubric (~15 min study)';
  return 'Core mechanism & economics · ~14 min study';
}

function getUnitTierLabel(u: InferenceUnit): string {
  if (u.trackId === 'foundations' || u.trackId === 'inserts') {
    return 'Full 36-Unit Edition (₹1,999 / $49) & Accelerator';
  }
  return `Single Domain Track (₹499 / $19) & Full Edition (₹1,999 / $49)`;
}
---

<Base
  card="inference-read"
  title="INFERENCE Free Edition — 5 Complete Units & 36-Unit Syllabus"
  description="Read 5 full units of INFERENCE free: Ch 00 AI in one sitting, Ch 01 Not all AI is ChatGPT, State of Play Nov 2026, India Briefing, and a worked Consulting Casebook case."
  section="INFERENCE"
  pageType="CollectionPage"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'INFERENCE', path: '/inference/' },
    { name: 'Free Edition' },
  ]}
  immersive={true}
  wide={true}
  grain={true}
>
  <section class="pg-plate" style={`clip-path:${clip}`} aria-labelledby="read-hub-title">
    <div class="wrap pg-plate__in">
      <div class="hub-top">
        <span class="hanko-mark">Free Edition · 5 of 36 Units</span>
        <a class="linkish hub-back" href="/inference/">← Sales overview &amp; pricing</a>
      </div>

      <h1 id="read-hub-title" class="pg-plate__title">
        Read five complete units before you decide.
      </h1>

      <p class="pg-plate__desc">
        Start with the Foundations opener (Ch 00), the decision split (Ch 01), both quarterly
        inserts (Global State of Play and India Briefing), and one full worked PE due-diligence
        case from the Consulting Casebook.
      </p>

      <div class="hub-actions">
        <a class="inf-btn inf-btn--primary" href={`/inference/read/${freeEntries[0]?.id}/`}>
          Start with Ch 00: AI in one sitting
        </a>
        <a class="inf-btn inf-btn--ghost" href="/inference/glossary/">
          Search 116-term glossary
        </a>
        <a class="inf-btn inf-btn--ghost" href="/inference/#pricing">
          Get all 36 units (from ₹499)
        </a>
      </div>
    </div>
  </section>

  <svg class="pg-edge" viewBox={`0 0 1000 ${EDGE_DEPTH}`} preserveAspectRatio="none" aria-hidden="true">
    <polyline points={line} class="pg-edge__glow" vector-effect="non-scaling-stroke" />
    <polyline points={line} class="pg-edge__gold" vector-effect="non-scaling-stroke" />
  </svg>

  <div class="wrap hub-body">
    <section class="hub-sec" aria-labelledby="free-units-heading">
      <div class="hub-sec__head">
        <div>
          <p class="hub-kicker">Available in full · zero signup required</p>
          <h2 id="free-units-heading">The 5 Free Edition units</h2>
        </div>
        <p class="hub-sec__note">Move your pointer across any folio plate to inspect the unit brief.</p>
      </div>

      <div class="free-grid">
        {freeEntries.map((entry, idx) => (
          <a
            class="free-card"
            href={`/inference/read/${entry.id}/`}
            style={`--card-accent:var(--${entry.data.accent})`}
            data-tilt-card
          >
            <div class="free-card__surface">
              <div class="free-card__meta">
                <span class="free-card__unit">{entry.data.unitNumber} · {entry.data.track}</span>
                <span class="free-card__folio">0{idx + 1} / 0{freeEntries.length}</span>
              </div>
              <div class="free-card__submeta">
                <span class="free-card__part">{entry.data.part}</span>
                <span class="free-card__time">{entry.data.readingTime}</span>
              </div>
              <h3>{entry.data.title}</h3>
              <p class="free-card__hook">{entry.data.hook}</p>
              <p class="free-card__deck">{entry.data.deck}</p>
              <div class="free-card__foot">
                <span class="free-card__cta">Read full unit →</span>
                <span class="free-card__open">Open reader</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="hub-sec" id="syllabus" aria-labelledby="locked-roadmap-heading">
      <div class="hub-sec__head">
        <div>
          <p class="hub-kicker">Paid Edition roadmap · {lockedUnits.length} remaining units</p>
          <h2 id="locked-roadmap-heading">What sits in the full {INFERENCE_STATS.words}-word 2027 Edition</h2>
        </div>
        <a class="inf-btn inf-btn--primary" href="/inference/#pricing">
          Get the Full Edition (₹1,999 / $49)
        </a>
      </div>

      <div class="syllabus-toolbar">
        <div class="syllabus-filters" role="group" aria-label="Filter syllabus units by track">
          {FILTER_BAR.map((f, idx) => (
            <button
              type="button"
              class:list={['syllabus-pill', idx === 0 && 'is-active']}
              data-syllabus-filter={f.id}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              style={`--pill-accent:var(--${f.accent})`}
            >
              {f.id !== 'all' && <span class="syllabus-pill__dot" aria-hidden="true"></span>}
              <span>{f.label}</span>
            </button>
          ))}
        </div>
        <p class="syllabus-status" id="syllabus-status" aria-live="polite">
          Showing {INFERENCE_UNITS.length} of {INFERENCE_UNITS.length} units · Select any Paid unit to preview its scope
        </p>
      </div>

      <div class="roadmap" id="syllabus-roadmap">
        {INFERENCE_TRACK_GROUPS.map((g) => {
          const list = INFERENCE_UNITS.filter((u) => u.trackId === g.id);
          return (
            <section
              class="roadmap-group"
              data-track-group={g.id}
              style={`--group-accent:var(--${g.accent})`}
            >
              <header class="roadmap-group__head">
                <div>
                  <h3>{g.label}</h3>
                  <p>{g.summary}</p>
                </div>
                <span class="roadmap-group__count" data-group-count={list.length}>{list.length} units</span>
              </header>
              <ol class="roadmap-list">
                {list.map((u) => (
                  <li
                    class:list={['roadmap-item', u.isFree ? 'roadmap-item--free' : 'roadmap-item--locked']}
                    data-syllabus-item
                    data-item-track={u.trackId}
                    data-item-free={u.isFree ? 'true' : 'false'}
                  >
                    {u.isFree && u.freeSlug ? (
                      <div class="roadmap-item__row">
                        <div class="roadmap-item__left">
                          <span class="roadmap-item__num">{u.unitNumber}</span>
                          <div>
                            <strong>{u.title}</strong>
                            <p>{u.deck}</p>
                          </div>
                        </div>
                        <div class="roadmap-item__right">
                          <a class="roadmap-badge roadmap-badge--free" href={`/inference/read/${u.freeSlug}/`}>
                            {u.freeScope ?? 'Free'} →
                          </a>
                        </div>
                      </div>
                    ) : (
                      <div class="roadmap-locked-shell">
                        <button
                          type="button"
                          class="roadmap-item__trigger"
                          aria-expanded="false"
                          aria-controls={`peek-${u.id}`}
                          data-peek-unit={u.id}
                        >
                          <div class="roadmap-item__left">
                            <span class="roadmap-item__num">{u.unitNumber}</span>
                            <div>
                              <strong>{u.title}</strong>
                              <p>{u.deck}</p>
                            </div>
                          </div>
                          <div class="roadmap-item__right">
                            <span class="roadmap-badge roadmap-badge--locked">
                              <span class="roadmap-badge__label">Peek unit</span>
                              <span class="roadmap-badge__chevron" aria-hidden="true">+</span>
                            </span>
                          </div>
                        </button>

                        <div id={`peek-${u.id}`} class="roadmap-peek" hidden>
                          <div class="roadmap-peek__inner">
                            <div class="roadmap-peek__grid">
                              <div class="roadmap-peek__main">
                                <p class="roadmap-peek__kicker">Unit brief · {u.partTitle}</p>
                                <p class="roadmap-peek__deck">{u.deck}</p>
                                {u.questions.length > 0 && (
                                  <div class="roadmap-peek__questions">
                                    <p class="roadmap-peek__qlabel">Questions this unit prepares you to answer</p>
                                    <ul>
                                      {u.questions.map((q) => (
                                        <li>{q}</li>
                                      ))}
                                    </ul>
                                  </div>
                                )}
                              </div>
                              <dl class="roadmap-peek__meta">
                                <div>
                                  <dt>Track membership</dt>
                                  <dd>{u.trackLabel} · {u.partTitle}</dd>
                                </div>
                                <div>
                                  <dt>Estimated reading depth</dt>
                                  <dd>{getUnitDepth(u)}</dd>
                                </div>
                                <div>
                                  <dt>Included in</dt>
                                  <dd>{getUnitTierLabel(u)}</dd>
                                </div>
                              </dl>
                            </div>
                            <div class="roadmap-peek__foot">
                              <a
                                class="inf-btn inf-btn--primary roadmap-peek__cta"
                                href={`/inference/?track=${u.trackId}#pricing`}
                                data-peek-cta={u.id}
                              >
                                Get {u.trackLabel} or Full Edition →
                              </a>
                              <a class="linkish roadmap-peek__glossary" href="/inference/glossary/">
                                Inspect related glossary terms
                              </a>
                            </div>
                          </div>
                        </div>
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          );
        })}
      </div>

      <p class="syllabus-empty is-hidden" id="syllabus-empty">
        No units match that track selection. Choose All 36 to restore the complete roadmap.
      </p>
    </section>
  </div>
</Base>

<script>
  // 1. 3D-perspective tilt + radial cursor spotlight on the 5 Free Edition folio cards
  const canHoverTilt =
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canHoverTilt) {
    for (const card of document.querySelectorAll<HTMLElement>('[data-tilt-card]')) {
      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        const px = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
        const py = Math.min(1, Math.max(0, (e.clientY - rect.top) / rect.height));
        const rx = ((0.5 - py) * 7.5).toFixed(2);
        const ry = ((px - 0.5) * 8.5).toFixed(2);
        card.style.setProperty('--mx', `${(px * 100).toFixed(1)}%`);
        card.style.setProperty('--my', `${(py * 100).toFixed(1)}%`);
        card.style.setProperty('--rx', `${rx}deg`);
        card.style.setProperty('--ry', `${ry}deg`);
        card.style.setProperty('--lift', '-4px');
      });

      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
        card.style.setProperty('--lift', '0px');
      });
    }
  }

  // 2. Interactive Track Filter Bar for the 36-unit syllabus
  const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-syllabus-filter]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-track-group]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-syllabus-item]')];
  const statusEl = document.getElementById('syllabus-status');
  const emptyEl = document.getElementById('syllabus-empty');

  const FILTER_LABELS: Record<string, string> = {
    all: 'all tracks',
    free: 'Free Edition',
    foundations: 'Foundations',
    consulting: 'Consulting & Strategy',
    marketing: 'Marketing & Brand',
    product: 'Product Management',
    operations: 'Operations & Supply Chain',
    finance: 'Finance & Banking',
    hr: 'HR & People',
    inserts: 'Quarterly Inserts',
  };

  function applySyllabusFilter(filterId: string) {
    for (const btn of filterBtns) {
      const on = btn.dataset.syllabusFilter === filterId;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    }

    let totalVisible = 0;
    let visibleTracks = 0;

    for (const group of groups) {
      const groupItems = [...group.querySelectorAll<HTMLElement>('[data-syllabus-item]')];
      let groupVisible = 0;

      for (const item of groupItems) {
        const match =
          filterId === 'all' ||
          (filterId === 'free' && item.dataset.itemFree === 'true') ||
          item.dataset.itemTrack === filterId;

        item.classList.toggle('is-hidden', !match);
        if (match) {
          groupVisible += 1;
          totalVisible += 1;
        }
      }

      group.classList.toggle('is-hidden', groupVisible === 0);
      if (groupVisible > 0) {
        visibleTracks += 1;
        group.classList.remove('is-filtering-in');
        void group.offsetWidth;
        group.classList.add('is-filtering-in');
      }

      const countBadge = group.querySelector<HTMLElement>('[data-group-count]');
      if (countBadge) {
        const baseCount = countBadge.dataset.groupCount || String(groupItems.length);
        countBadge.textContent =
          filterId === 'free'
            ? `${groupVisible} of ${baseCount} free`
            : `${groupVisible} ${groupVisible === 1 ? 'unit' : 'units'}`;
      }
    }

    if (statusEl) {
      if (filterId === 'all') {
        statusEl.textContent = `Showing ${totalVisible} of ${items.length} units · Select any Paid unit to preview its scope`;
      } else {
        const label = FILTER_LABELS[filterId] || filterId;
        statusEl.textContent = `Showing ${totalVisible} of ${items.length} units in ${label} (${visibleTracks} ${visibleTracks === 1 ? 'section' : 'sections'})`;
      }
    }

    emptyEl?.classList.toggle('is-hidden', totalVisible > 0);
  }

  for (const btn of filterBtns) {
    btn.addEventListener('click', () => {
      const id = btn.dataset.syllabusFilter || 'all';
      applySyllabusFilter(id);
    });
  }

  const initialTrack = new URLSearchParams(location.search).get('track');
  if (initialTrack && filterBtns.some((b) => b.dataset.syllabusFilter === initialTrack)) {
    applySyllabusFilter(initialTrack);
  }

  // 3. Peek Locked Unit inline expandable drawer + Umami event
  for (const trigger of document.querySelectorAll<HTMLButtonElement>('[data-peek-unit]')) {
    trigger.addEventListener('click', () => {
      const unitId = trigger.dataset.peekUnit || '';
      const panelId = trigger.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      if (!panel) return;

      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      const nextOpen = !isOpen;
      trigger.setAttribute('aria-expanded', nextOpen ? 'true' : 'false');

      const shell = trigger.closest('.roadmap-item');
      shell?.classList.toggle('is-expanded', nextOpen);

      const label = trigger.querySelector('.roadmap-badge__label');
      const chevron = trigger.querySelector('.roadmap-badge__chevron');
      if (label) label.textContent = nextOpen ? 'Close preview' : 'Peek unit';
      if (chevron) chevron.textContent = nextOpen ? '−' : '+';

      if (nextOpen) {
        panel.hidden = false;
        panel.classList.remove('is-opening');
        void panel.offsetWidth;
        panel.classList.add('is-opening');

        const w = window as unknown as {
          umami?: { track?: (name: string, data: Record<string, string>) => void };
        };
        w.umami?.track?.('inference_locked_peek', { unit: unitId });
      } else {
        panel.hidden = true;
        panel.classList.remove('is-opening');
      }
    });
  }
</script>

<style>
  .pg-plate {
    position: relative;
    color: var(--tldr-ink);
    background:
      radial-gradient(50rem 26rem at 88% 10%, color-mix(in srgb, var(--mizu) 15%, transparent), transparent 70%),
      radial-gradient(42rem 22rem at 6% 110%, color-mix(in srgb, var(--ochre) 14%, transparent), transparent 70%),
      var(--tldr-bg);
    overflow: hidden;
  }
  .pg-plate::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--paper-noise);
    opacity: 0.7;
    pointer-events: none;
  }
  .pg-plate__in {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.25rem, 4vw, 3.5rem) calc(22px + clamp(2rem, 3vw, 2.75rem));
  }
  .hub-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: .75rem 1.25rem;
    margin-bottom: 1.15rem;
  }
  .hanko-mark {
    display: inline-flex;
    align-items: center;
    font-family: var(--font);
    font-size: .6875rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--hanko);
    background: color-mix(in srgb, var(--hanko) 14%, transparent);
    border: 1.25px solid color-mix(in srgb, var(--hanko) 65%, transparent);
    padding: .24rem .65rem;
    border-radius: 4px;
  }
  .hub-back {
    color: var(--tldr-dim);
    font-size: .9375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .hub-back:hover {
    color: var(--tldr-ink);
  }
  .pg-plate__title {
    margin: 0;
    max-width: 52rem;
    font-family: var(--font);
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.07;
    letter-spacing: -.03em;
    color: var(--tldr-ink);
  }
  .pg-plate__desc {
    margin: 1rem 0 0;
    max-width: 44rem;
    font-size: 1.0625rem;
    line-height: 1.62;
    color: var(--tldr-dim);
  }
  .hub-actions {
    margin-top: 1.65rem;
    display: flex;
    flex-wrap: wrap;
    gap: .85rem;
  }
  .inf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: .7rem 1.35rem;
    border-radius: 10px;
    font-family: var(--font);
    font-size: .9375rem;
    font-weight: 700;
    text-decoration: none;
    border: 1.5px solid transparent;
    transition: transform var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }
  .inf-btn:hover {
    transform: translateY(-1px);
  }
  .inf-btn--primary {
    background: var(--ochre);
    color: var(--tldr-bg);
    border-color: var(--ochre);
  }
  .inf-btn--ghost {
    background: transparent;
    color: var(--tldr-ink);
    border-color: var(--tldr-hair);
  }
  .inf-btn--ghost:hover {
    border-color: var(--tldr-ink);
  }

  .pg-edge {
    display: block;
    position: relative;
    width: 100%;
    height: 22px;
    margin-top: -22px;
    overflow: visible;
    pointer-events: none;
  }
  .pg-edge__glow {
    fill: none;
    stroke: color-mix(in srgb, var(--ochre) 40%, transparent);
    stroke-width: 4;
    filter: blur(1.5px);
  }
  .pg-edge__gold {
    fill: none;
    stroke: var(--ochre);
    stroke-width: 1.75;
    stroke-linejoin: miter;
  }

  .hub-body {
    padding-top: clamp(2.25rem, 4vw, 3.5rem);
    padding-bottom: 4.5rem;
  }
  .hub-sec {
    margin-top: 3.75rem;
  }
  .hub-sec:first-child {
    margin-top: 0;
  }
  .hub-sec__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .hub-sec__note {
    margin: 0;
    font-size: .875rem;
    color: var(--ink-faint);
  }
  .hub-kicker {
    margin: 0 0 .35rem;
    font-size: .8125rem;
    font-weight: 700;
    color: var(--ochre);
  }
  .hub-sec h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -.02em;
  }
  .hub-sec__head h2 {
    margin-bottom: 0;
  }

  /* 3D-perspective tilt book-card showcase */
  .free-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1.15rem;
    perspective: 1200px;
  }
  .free-card {
    --mx: 50%;
    --my: 50%;
    --rx: 0deg;
    --ry: 0deg;
    --lift: 0px;
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 4px solid var(--card-accent, var(--ochre));
    border-radius: 16px;
    padding: 1.4rem 1.5rem;
    text-decoration: none;
    overflow: hidden;
    transform-style: preserve-3d;
    transform: perspective(1000px) rotateX(var(--rx)) rotateY(var(--ry)) translateY(var(--lift));
    transition: transform .22s var(--ease), box-shadow var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
    will-change: transform;
  }
  .free-card::before {
