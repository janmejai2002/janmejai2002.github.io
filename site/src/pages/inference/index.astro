    font-family: var(--serif);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--ochre);
  }
  .pg-plate__title {
    margin: 0;
    max-width: 38rem;
    font-family: var(--font);
    font-size: clamp(2rem, 3.8vw, 3.15rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -.03em;
    color: var(--tldr-ink);
    text-wrap: balance;
  }
  .pg-plate__desc {
    margin: 1rem 0 0;
    max-width: 37rem;
    font-size: 1.03125rem;
    line-height: 1.62;
    color: var(--tldr-dim);
  }
  .inf-hero__actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .8rem 1.15rem;
  }
  .inf-hero__glossary {
    color: var(--tldr-ink);
    font-size: .9375rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--ochre);
    padding-bottom: .15rem;
  }
  .inf-proof {
    margin: 1.85rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--tldr-hair);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .85rem 1rem;
  }
  @media (max-width: 38rem) {
    .inf-proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .inf-proof dt {
    font-size: .75rem;
    font-weight: 600;
    color: var(--tldr-dim);
  }
  .inf-proof dd {
    margin: .2rem 0 0;
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--tldr-ink);
    font-variant-numeric: tabular-nums;
  }
  .inf-hero__hint {
    margin: 1.1rem 0 0;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .04em;
    color: var(--tldr-dim);
  }
  .inf-hero__hint-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ochre);
    box-shadow: 0 0 10px var(--ochre);
  }

  /* ── 3D WebGL2 Monolith Stage ── */
  .inf-hero__stage {
    display: flex;
    flex-direction: column;
    gap: .85rem;
  }
  .inf-stage {
    --stage-accent: var(--mizu);
    position: relative;
    min-height: clamp(22rem, 42vw, 31rem);
    border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--stage-accent) 34%, var(--tldr-hair));
    background:
      radial-gradient(24rem 24rem at 54% 46%, color-mix(in srgb, var(--stage-accent) 18%, transparent), transparent 68%),
      radial-gradient(18rem 16rem at 44% 58%, color-mix(in srgb, var(--ochre) 14%, transparent), transparent 72%),
      color-mix(in srgb, var(--tldr-bg) 86%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--tldr-ink) 12%, transparent),
      0 24px 56px -24px var(--shadow);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .inf-stage[data-active-accent='mizu'] { --stage-accent: var(--mizu); }
  .inf-stage[data-active-accent='hanko'] { --stage-accent: var(--hanko); }
  .inf-stage[data-active-accent='ochre'] { --stage-accent: var(--ochre); }
  .inf-stage[data-active-accent='plum'] { --stage-accent: var(--plum); }
  .inf-stage[data-active-accent='moss'] { --stage-accent: var(--moss); }
  .inf-stage[data-active-accent='indigo'] { --stage-accent: var(--indigo); }

  .inf-stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y;
    z-index: 1;
  }
  .inf-stage__fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.5rem;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease);
  }
  .inf-stage.is-gl-ready .inf-stage__fallback {
    opacity: 0;
  }
  .inf-fallback-svg {
    width: min(14rem, 62%);
    height: auto;
  }

  .inf-stage__hud,
  .inf-stage__foot {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding: .85rem 1.05rem;
    pointer-events: none;
  }
  .inf-stage__hud-badge {
    display: inline-flex;
    align-items: center;
    gap: .48rem;
    padding: .3rem .72rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tldr-bg) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--stage-accent) 45%, var(--tldr-hair));
    backdrop-filter: blur(8px);
    font-size: .75rem;
    font-weight: 700;
    color: var(--tldr-ink);
  }
  .inf-stage__hud-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--stage-accent);
    box-shadow: 0 0 10px var(--stage-accent);
  }
  .inf-stage__hud-meta {
    font-size: .75rem;
    font-weight: 600;
    color: var(--tldr-dim);
    background: color-mix(in srgb, var(--tldr-bg) 72%, transparent);
    padding: .24rem .6rem;
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }
  .inf-stage__foot {
    font-size: .72rem;
    font-weight: 600;
    color: var(--tldr-dim);
  }
  .inf-stage__jump {
    pointer-events: auto;
    color: var(--ochre);
    text-decoration: none;
    font-weight: 700;
  }
  .inf-stage__jump:hover {
    color: var(--tldr-ink);
  }

  /* Live Domain Pill Switcher under the 3D Stage */
  .inf-stage-pills {
    display: flex;
    flex-wrap: wrap;
    gap: .42rem;
  }
  .inf-stage-pill {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: .42rem;
    min-height: 36px;
    padding: .35rem .72rem;
    border-radius: 999px;
    border: 1px solid var(--tldr-hair);
    background: color-mix(in srgb, var(--tldr-bg) 72%, transparent);
    color: var(--tldr-dim);
    font-family: var(--font);
    font-size: .75rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }
  .inf-stage-pill:hover {
    color: var(--tldr-ink);
    border-color: var(--pill-accent);
    transform: translateY(-1px);
  }
  .inf-stage-pill.is-active {
    color: var(--tldr-ink);
    border-color: var(--pill-accent);
    background: color-mix(in srgb, var(--pill-accent) 22%, var(--tldr-bg));
  }
  .inf-stage-pill__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pill-accent);
    flex-shrink: 0;
  }

  .pg-edge {
    display: block;
    position: relative;
    width: 100%;
    height: 22px;
    margin-top: -22px;
    overflow: visible;
    pointer-events: none;
  }
  .pg-edge__glow {
    fill: none;
    stroke: color-mix(in srgb, var(--ochre) 40%, transparent);
    stroke-width: 4;
    filter: blur(1.5px);
  }
  .pg-edge__gold {
    fill: none;
    stroke: var(--ochre);
    stroke-width: 1.75;
    stroke-linejoin: miter;
  }

  /* ── Buttons ── */
  .inf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: .7rem 1.35rem;
    border-radius: 10px;
    font-family: var(--font);
    font-size: .9375rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    transition: transform var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .inf-btn--sm {
    min-height: 40px;
    padding: .5rem 1rem;
    font-size: .875rem;
  }
  .inf-btn:hover {
    transform: translateY(-1px);
  }
  .inf-btn--primary {
    background: var(--ochre);
    color: var(--tldr-bg);
    border-color: var(--ochre);
  }
  .inf-btn--ghost {
    background: transparent;
    color: var(--tldr-ink);
    border-color: var(--tldr-hair);
  }
  .inf-btn--ghost:hover {
    border-color: var(--tldr-ink);
  }
  .inf-btn--secondary {
    background: var(--solid);
    color: var(--on-solid);
    border-color: var(--border);
  }

  /* ── Body Sections ── */
  .inf-body {
    padding-top: clamp(2.5rem, 4.5vw, 4rem);
    padding-bottom: 4.5rem;
  }
  .inf-sec {
    margin-top: 4.5rem;
  }
  .inf-sec:first-child {
    margin-top: 0;
  }
  .inf-sec__head {
    margin-bottom: 1.5rem;
  }
  .inf-sec__head--row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }
  .inf-sec__links {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 1.35rem;
    font-size: .9375rem;
    font-weight: 600;
  }
  .inf-kicker {
    margin: 0 0 .35rem;
    font-size: .8125rem;
    font-weight: 700;
    color: var(--ochre);
  }
  .inf-sec h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2.8vw, 2.15rem);
    font-weight: 800;
    letter-spacing: -.022em;
    line-height: 1.15;
    color: var(--ink);
  }

  /* ── Contrast Grid ── */
  .inf-contrast {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
  }
  .inf-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.35rem 1.4rem;
  }
  .inf-card--accent {
    border-left: 3px solid var(--ochre);
    background: color-mix(in srgb, var(--ochre) 6%, var(--card));
  }
  .inf-card__tag {
    display: block;
    font-size: .8125rem;
    font-weight: 700;
    color: var(--ink-faint);
    margin-bottom: .4rem;
  }
  .inf-card--accent .inf-card__tag {
    color: var(--ochre);
  }
  .inf-card h3 {
    margin: 0 0 .55rem;
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.25;
  }
  .inf-card p {
    margin: 0;
    font-size: .9375rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* ── Interactive 7-Track Explorer ── */
  .inf-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: 1.25rem;
  }
  .inf-tab {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 44px;
    padding: .5rem .9rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--ink-soft);
    font-family: var(--font);
    font-size: .875rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .inf-tab:hover {
    color: var(--ink);
    border-color: var(--tab-accent);
    transform: translateY(-1px);
  }
  .inf-tab.is-active {
    color: var(--ink);
    border-color: var(--tab-accent);
    background: color-mix(in srgb, var(--tab-accent) 13%, var(--card));
  }
  .inf-tab__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tab-accent);
    flex-shrink: 0;
  }
  .inf-tab__count {
    font-size: .8125rem;
    color: var(--ink-faint);
    font-weight: 500;
  }

  .inf-panel.is-hidden {
    display: none;
  }
  .inf-panel__banner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 1.5rem;
    padding: 1.2rem 1.35rem;
    margin-bottom: 1.15rem;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--panel-accent) 32%, var(--border));
    background: color-mix(in srgb, var(--panel-accent) 6%, var(--card));
  }
  .inf-panel__banner-copy {
    flex: 1 1 28rem;
  }
  .inf-panel__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .45rem;
    font-size: .8125rem;
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: .45rem;
  }
  .inf-panel__eyebrow strong {
    color: var(--ink);
    font-weight: 800;
  }
  .inf-panel__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--panel-accent);
  }
  .inf-panel__sep {
    color: var(--ink-faint);
  }
  .inf-panel__summary {
    margin: 0;
    font-size: .96875rem;
    line-height: 1.58;
    color: var(--ink-soft);
    max-width: 50rem;
  }
  .inf-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    align-items: center;
  }
  .inf-unitlist {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: .9rem;
  }
  .inf-unit {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--panel-accent, var(--border));
    border-radius: 14px;
    padding: 1.15rem 1.25rem;
    transition: transform var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .inf-unit:hover {
    transform: translateY(-2px);
    border-color: var(--panel-accent, var(--border));
  }
  .inf-unit--free {
    background: color-mix(in srgb, var(--panel-accent) 7%, var(--card));
  }
  .inf-unit__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    margin-bottom: .5rem;
  }
  .inf-unit__num {
    font-size: .8125rem;
    font-weight: 700;
    color: var(--ink-faint);
  }
  .inf-badge {
    display: inline-flex;
    align-items: center;
    padding: .18rem .55rem;
    border-radius: 999px;
    font-size: .75rem;
    font-weight: 700;
  }
  .inf-badge--free {
    background: color-mix(in srgb, var(--moss) 18%, transparent);
    color: var(--moss);
    border: 1px solid color-mix(in srgb, var(--moss) 45%, transparent);
  }
  .inf-badge--paid {
    background: var(--paper-2);
    color: var(--ink-faint);
    border: 1px solid var(--border);
  }
  .inf-unit__title {
    margin: 0 0 .45rem;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
  }
  .inf-unit__deck {
    margin: 0 0 .85rem;
    font-size: .875rem;
    line-height: 1.55;
    color: var(--ink-soft);
    flex: 1;
  }
  .inf-unit__prompt {
    margin: 0 0 .85rem;
    padding: .6rem .75rem;
    border-radius: 8px;
    background: var(--paper-2);
    border: 1px solid var(--border-soft);
    font-size: .8125rem;
    line-height: 1.48;
    color: var(--ink-soft);
  }
  .inf-unit__prompt span {
    font-weight: 700;
    color: var(--ink);
  }
  .inf-unit__cta {
    font-size: .875rem;
    font-weight: 600;
  }

  /* ── Inside the Compendium Interactive Sample Peek ── */
  .inf-peek-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .65rem;
    margin-bottom: 1.15rem;
  }
  @media (max-width: 52rem) {
    .inf-peek-tabs {
      grid-template-columns: 1fr;
    }
  }
  .inf-peek-tab {
    appearance: none;
    display: flex;
    align-items: center;
    gap: .7rem;
    text-align: left;
    min-height: 52px;
    padding: .75rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--ink-soft);
    font-family: var(--font);
    font-size: .9rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .inf-peek-tab:hover {
    color: var(--ink);
    border-color: var(--ochre);
  }
  .inf-peek-tab.is-active {
    color: var(--ink);
    border-color: var(--ochre);
    background: color-mix(in srgb, var(--ochre) 11%, var(--card));
  }
  .inf-peek-tab__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 8px;
    background: var(--paper-2);
    border: 1px solid var(--border);
    font-size: .75rem;
    font-weight: 800;
    color: var(--ochre);
    flex-shrink: 0;
  }
  .inf-peek-tab.is-active .inf-peek-tab__num {
    background: var(--ochre);
    color: var(--tldr-bg);
    border-color: var(--ochre);
  }

  .inf-peek-stage {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: clamp(1.25rem, 2.5vw, 1.85rem);
  }
  .inf-peek-panel.is-hidden {
    display: none;
  }
  .inf-peek-panel__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .inf-peek-kicker {
    display: block;
    font-size: .75rem;
    font-weight: 700;
    color: var(--ochre);
    margin-bottom: .3rem;
  }
  .inf-peek-panel__head h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--ink);
  }
  .inf-peek-diagram {
    margin: 0 0 1.25rem;
  }
  .inf-econ-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
    gap: .9rem;
  }
  .inf-econ-card {
    background: var(--paper-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.1rem;
  }
  .inf-econ-card__k {
    display: block;
    font-size: .75rem;
    font-weight: 700;
    color: var(--mizu);
    margin-bottom: .25rem;
  }
  .inf-econ-card strong {
    display: block;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    margin-bottom: .4rem;
  }
  .inf-econ-card p {
    margin: 0;
    font-size: .875rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .inf-matrix-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--paper-2);
  }
  .inf-matrix {
    width: 100%;
    border-collapse: collapse;
    font-size: .875rem;
    line-height: 1.5;
    min-width: 42rem;
  }
  .inf-matrix th,
  .inf-matrix td {
    text-align: left;
    padding: .85rem 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .inf-matrix th {
    font-size: .75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--ink);
    background: var(--stone);
  }
  .inf-matrix td {
    color: var(--ink-soft);
  }
  .inf-matrix td strong {
    color: var(--ink);
  }
  .inf-matrix tr:last-child td {
    border-bottom: 0;
  }

  .inf-rubric-grid {
    display: grid;
    gap: .75rem;
  }
  .inf-rubric-row {
    display: grid;
    grid-template-columns: minmax(10rem, 0.72fr) minmax(0, 1fr) minmax(0, 1.15fr);
    gap: .85rem;
    padding: 1rem 1.1rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--paper-2);
    align-items: start;
  }
  @media (max-width: 52rem) {
    .inf-rubric-row {
      grid-template-columns: 1fr;
    }
  }
  .inf-rubric-wt {
    display: inline-block;
    font-size: .72rem;
    font-weight: 800;
    color: var(--ochre);
    margin-bottom: .25rem;
  }
  .inf-rubric-axis h4 {
    margin: 0;
    font-size: .95rem;
    font-weight: 800;
    color: var(--ink);
  }
  .inf-rubric-label {
    display: block;
