---
import Base from '../../layouts/Base.astro';
import { plateEdge, EDGE_DEPTH } from '../../lib/bowl';
import {
  INFERENCE_STATS,
  INFERENCE_TRACK_GROUPS,
  INFERENCE_UNITS,
  INFERENCE_SKUS,
  INFERENCE_DOMAIN_OPTIONS,
  INFERENCE_AUTHORS,
  INFERENCE_FAQS,
  getCheckoutHref,
} from '../../data/inference';

const edge = plateEdge('inference');
const clip = `polygon(0 0,100% 0,${[...edge].reverse().map(([x, d]) => `${x.toFixed(1)}% calc(100% - ${d.toFixed(1)}px)`).join(',')})`;
const line = edge.map(([x, d]) => `${(x * 10).toFixed(0)},${(EDGE_DEPTH - d).toFixed(1)}`).join(' ');

const unitsByTrack = Object.fromEntries(
  INFERENCE_TRACK_GROUPS.map((g) => [g.id, INFERENCE_UNITS.filter((u) => u.trackId === g.id)])
);

const TRACK_WORD_DEPTH: Record<string, string> = {
  foundations: '33,400 words', consulting: '27,800 words', finance: '18,600 words',
  product: '17,900 words', marketing: '16,800 words', operations: '17,400 words',
  hr: '13,200 words', inserts: '4,933 words',
};

const FALLBACK_CELLS = [
  [0, 0, 'ochre'], [0, 28, 'mizu'], [28, 28, 'ochre'], [0, 56, 'mizu'], [28, 56, 'plum'],
  [56, 56, 'ochre'], [0, 84, 'mizu'], [28, 84, 'moss'], [56, 84, 'hanko'], [84, 84, 'ochre'],
  [0, 112, 'indigo'], [28, 112, 'mizu'], [56, 112, 'plum'], [84, 112, 'moss'], [112, 112, 'ochre'],
] as const;

const EXHIBIT_CARDS = [
  { x: 12, stroke: 'ochre', title: 'Written rules', sub: 'Fixed statutory logic', lines: ['Output: yes / no gate', 'Data: policy thresholds', 'Audit: line-by-line rule'], foot: 'Ch 01 · Zero API cost' },
  { x: 249, stroke: 'mizu', title: 'Predictive ML', sub: 'Structured rows & labels', lines: ['Output: score or forecast', 'Data: bureau, POS, churn', 'Audit: holdout error & SHAP'], foot: 'Ch 01 & Ch 22 · Deterministic' },
  { x: 486, stroke: 'plum', title: 'Generative AI', sub: 'Unstructured text & PDFs', lines: ['Output: summary, tag, code', 'Data: contracts, calls, logs', 'Audit: eval suite + human QA'], foot: 'Ch 02–07 · Token metered' },
];

const HERO_DOMAINS = INFERENCE_TRACK_GROUPS.filter((g) => g.id !== 'inserts');

const SKU_SAVINGS: Record<string, { inr: string; usd: string }> = {
  'domain-track': { inr: '100% 14-day upgrade credit', usd: '100% 14-day upgrade credit' },
  'full-edition': { inr: 'Save 33% vs buying 6 tracks', usd: 'Save 57% vs buying 6 tracks' },
  'placement-accelerator': { inr: 'Full Edition + 25 drills and audio', usd: 'Full Edition + 25 drills and audio' },
  'campus-bulk': { inr: 'Save 55% · ₹900 per seat', usd: 'Save 49% · $25 per seat' },
};

const ECON_METRICS = [
  {
    k: 'Indic tokenizer tax', val: '2.4× – 3.1×',
    note: 'Hindi and regional scripts fragment into far more subword tokens than English, tripling API spend at identical ticket volumes.',
  },
  {
    k: 'KV cache & prefix reuse', val: 'Up to 90% off',
    note: 'Causal self-attention lets prefixes stay cached across calls. Structuring stable system prompts first cuts marginal input cost sharply.',
  },
  {
    k: 'Multi-step compounding', val: '0.95¹² = 54.0%',
    note: 'An unattended 12-step agent with 95% per-step reliability fails almost half the time without deterministic tool gates and eval checkpoints.',
  },
];

const INDIA_MATRIX = [
  [
    'DPDP Act 2023 & Rules',
    'Personal data ingestion into RAG pipelines, fine-tuning, or third-party LLM APIs.',
    'Explicit purpose-bound notice, PII redaction gateway, zero-retention vendor DPA, erasure pipeline.',
    'Data-flow lineage map and Data Fiduciary consent ledger (up to ₹250 crore penalty exposure).',
  ],
  [
    'RBI FREE-AI Framework',
    'Credit underwriting, UPI mule-account detection, collections, and banking copilots.',
    '7 Sutras governance: board-approved AI policy, explainability (SHAP/reason codes), bias testing, kill switch.',
    'Model inventory register and human-in-the-loop override logs for adverse credit actions.',
  ],
  [
    'SEBI Algo & Advisory Guardrails',
    'Brokerage copilots, automated research summaries, and algorithmic execution.',
    'Deterministic calculation sandboxes, citation traceability, strict separation of execution vs narrative LLM.',
    'Hallucination benchmark log and pre-trade deterministic validation trace.',
  ],
  [
    'ASCI & IT Rules (Synthetic Media)',
    'AI-generated ad creatives, influencer avatars, and localized Indic video campaigns.',
    'Clear synthetic disclosure labels, trademark clearance, brand-safety negative-prompt filters.',
    'Creative provenance ledger and legal sign-off on likeness and IP indemnification.',
  ],
] as const;

const RUBRIC_ROWS = [
  {
    axis: 'Deflection claim audit',
    weak: "Accepts the founder's 80% ticket deflection deck at face value and projects linear gross margin expansion.",
    strong: 'Separates containment from true resolution: audits reopen rates within 72 hours, silent escalations, and QA sampling overhead.',
  },
  {
    axis: 'Inference margin math',
    weak: 'Assumes SaaS-like 85% gross margins because API prices are falling every quarter.',
    strong: 'Models blended cost per resolved ticket: multi-turn context growth, Indic token multiplier, retrieval latency, and human fallback minutes.',
  },
  {
    axis: 'Moat & switching cost',
    weak: 'Claims proprietary prompt engineering or a fine-tuned open model creates durable defensibility.',
    strong: 'Checks deep ERP/CRM write-back integration, domain eval suites, and regulated audit logs versus thin wrapper commoditization.',
  },
  {
    axis: 'Liability & valuation call',
    weak: 'Recommends investing because AI support is a fast-growing market without structuring downside protection.',
    strong: 'Links valuation multiple to verified net-dollar retention, DPDP indemnity clauses, and a milestone earn-out tied to audited gross margin.',
  },
];

const productSchema = {
  sku: 'INFERENCE-2027-V1',
  category: 'Educational Book / Digital Compendium',
  brand: { '@type': 'Brand', name: 'wAIbi-sabi' },
  author: [
    { '@type': 'Person', name: 'Janmejai Singh Minhas', url: 'https://janmejai2002.github.io/about/' },
    { '@type': 'Person', name: 'Chaitanya Sharma' },
  ],
  offers: INFERENCE_SKUS.filter((s) => s.id !== 'campus-bulk').flatMap((s) => [
    {
      '@type': 'Offer', name: `${s.name} (INR)`, price: String(s.priceInr), priceCurrency: 'INR',
      availability: 'https://schema.org/InStock', url: 'https://janmejai2002.github.io/inference/#pricing',
    },
    {
      '@type': 'Offer', name: `${s.name} (USD)`, price: String(s.priceUsd), priceCurrency: 'USD',
      availability: 'https://schema.org/InStock', url: 'https://janmejai2002.github.io/inference/#pricing',
    },
  ]),
};
---

<Base
  card="inference"
  title="INFERENCE (2027 Edition) — Applied AI Compendium for Business & Placements"
  description="150,033 words across 36 units and 7 business domains, backed by 178 verified primary sources. Read 5 units free or get the complete 2027 Edition."
  section="INFERENCE"
  pageType="Product"
  keywords={[
    'INFERENCE AI Compendium', 'AI consulting casebook', 'MBA AI placement prep India',
    'applied AI economics', 'RBI FREE-AI DPDP AI guide', 'AI product management frameworks',
  ]}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'INFERENCE' }]}
  schema={productSchema}
  faq={INFERENCE_FAQS}
  immersive
  wide
  grain
>
  <section class="plate inf-hero" style={`clip-path:${clip}`} aria-labelledby="inf-hero-title">
    <div class="wrap plate__in inf-hero__grid">
      <div class="inf-hero__copy">
        <p class="inf-hero__byline">
          <span class="inf-hero__edition">{INFERENCE_STATS.edition}</span>
          <span aria-hidden="true"> · </span>
          <span>Janmejai Singh Minhas &amp; Chaitanya Sharma</span>
        </p>

        <p class="inf-hero__angle" id="inf-angle-kicker">
          Built for B-school placements, consulting case rounds, and applied-AI operators.
        </p>

        <h1 id="inf-hero-title">
          The applied AI compendium for people who sit in business, product, and placement rooms.
        </h1>

        <p class="inf-hero__desc">
          From token unit economics and causal attention to six full domain casebooks across
          consulting, finance, product, marketing, operations, and HR. Every claim traces to a
          verified primary source.
        </p>

        <div class="inf-hero__actions">
          <a class="inf-btn inf-btn--gold" href="#pricing" data-umami-sku="hero-edition">Get the 2027 Edition</a>
          <a class="inf-btn inf-btn--plate" href="/inference/read/">Read 5 free units</a>
          <a class="inf-plate-link" href="/inference/glossary/">Browse {INFERENCE_STATS.glossaryTerms}-term glossary →</a>
        </div>

        <dl class="inf-specs" aria-label="Compendium specifications">
          <div><dt>Words</dt><dd>{INFERENCE_STATS.words}</dd></div>
          <div><dt>Units</dt><dd>{INFERENCE_STATS.unitsTotal} complete</dd></div>
          <div><dt>Primary sources</dt><dd>{INFERENCE_STATS.sources} verified</dd></div>
          <div><dt>Vector figures</dt><dd>{INFERENCE_STATS.diagrams} SVGs</dd></div>
        </dl>
      </div>

      <div class="inf-hero__vessel">
        <div class="inf-monolith" id="inf-3d-shell">
          <canvas
            class="inf-monolith__canvas"
            data-inference-3d
            aria-label="Interactive 3D INFERENCE compendium hardcover with etched causal self-attention matrix and seven ceramic domain nodes"
          ></canvas>

          <div class="inf-monolith__fallback" aria-hidden="true">
            <svg viewBox="0 0 260 350" class="inf-fallback-svg">
              <rect x="24" y="16" width="212" height="318" rx="8" fill="var(--tldr-bg)" stroke="var(--ochre)" stroke-width="1.5" />
              <rect x="38" y="30" width="184" height="290" rx="4" fill="none" stroke="var(--tldr-hair)" stroke-width="1" />
              <text x="52" y="60" fill="var(--ochre)" font-family="var(--font)" font-size="13" font-weight="800">INFERENCE · 2027</text>
              <g transform="translate(54, 96)">
                <rect x="0" y="0" width="22" height="22" fill="var(--ochre)" />
                <rect x="0" y="28" width="22" height="22" fill="var(--mizu)" />
                <rect x="28" y="28" width="22" height="22" fill="var(--ochre)" />
                <rect x="0" y="56" width="22" height="22" fill="var(--mizu)" />
                <rect x="28" y="56" width="22" height="22" fill="var(--plum)" />
                <rect x="56" y="56" width="22" height="22" fill="var(--ochre)" />
                <rect x="0" y="84" width="22" height="22" fill="var(--mizu)" />
                <rect x="28" y="84" width="22" height="22" fill="var(--moss)" />
                <rect x="56" y="84" width="22" height="22" fill="var(--hanko)" />
                <rect x="84" y="84" width="22" height="22" fill="var(--ochre)" />
                <rect x="0" y="112" width="22" height="22" fill="var(--indigo)" />
                <rect x="28" y="112" width="22" height="22" fill="var(--mizu)" />
                <rect x="56" y="112" width="22" height="22" fill="var(--plum)" />
                <rect x="84" y="112" width="22" height="22" fill="var(--moss)" />
                <rect x="112" y="112" width="22" height="22" fill="var(--ochre)" />
              </g>
              <text x="52" y="294" fill="var(--tldr-dim)" font-family="var(--font)" font-size="13">36 units · 7 domains</text>
            </svg>
          </div>
        </div>

        <p class="inf-monolith__note" id="inf-stage-note" aria-live="polite">
          Foundations · 8 units, 2 free. Drag to turn, or choose a domain below.
        </p>

        <div class="cues" role="group" aria-label="Focus 3D monolith on a domain">
          {HERO_DOMAINS.map((g, idx) => (
            <button
              type="button"
              class:list={['cue', idx === 0 && 'cue--on']}
              data-hero-domain={g.id}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              style={`--accent:var(--${g.accent})`}
            >
              <span class="cue__dot" aria-hidden="true"></span>{g.label.split(' ')[0]}
              <span class="cue__bar" aria-hidden="true"></span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <svg class="plate-edge" viewBox={`0 0 1000 ${EDGE_DEPTH}`} preserveAspectRatio="none" aria-hidden="true">
    <polyline points={line} vector-effect="non-scaling-stroke" />
  </svg>

  <div class="wrap inf-body">
    <section class="inf-sec" aria-labelledby="contrast-heading">
      <div class="inf-sec__head">
        <p class="inf-kicker">The gap</p>
        <h2 id="contrast-heading">Why generic AI reading fails when the room pushes back</h2>
      </div>
      <div class="inf-contrast">
        <article class="inf-col">
          <p class="inf-col__tag">AI newsletters and threads</p>
          <h3>Model-release noise without P&amp;L math</h3>
          <p>
            Weekly summaries celebrate benchmark leaderboards while skipping inference cost per
            query, human QA overhead, and why 95% of enterprise pilots stall before hitting EBIT.
          </p>
        </article>
        <article class="inf-col">
          <p class="inf-col__tag">Engineering textbooks</p>
          <h3>CUDA and gradient math built for model trainers</h3>
          <p>
            You do not need backpropagation derivations to evaluate a ₹400 crore due-diligence
            target, audit RBI FREE-AI explainability, or price outcome-based consulting pods.
          </p>
        </article>
        <article class="inf-col inf-col--mark">
          <p class="inf-col__tag"><span class="inf-diamond" aria-hidden="true"></span>INFERENCE · 2027 Edition</p>
          <h3>Mechanism to margin math to interview rubric</h3>
          <p>
            Each unit moves in order: how the machinery works, where it fails quantitatively, what
            statutory rules apply (DPDP, RBI FREE-AI, EU AI Act), and how to defend a decision.
          </p>
        </article>
      </div>
    </section>

    <section class="inf-sec" id="tracks" aria-labelledby="explorer-heading">
      <div class="inf-sec__head inf-sec__head--row">
        <div>
          <p class="inf-kicker">Curriculum · 36 of 36 units complete</p>
          <h2 id="explorer-heading">Explore all 7 domains and quarterly inserts</h2>
        </div>
        <div class="inf-sec__links">
          <a class="linkish" href="/inference/read/">Open Free Edition hub →</a>
          <a class="linkish" href="/inference/glossary/">Search {INFERENCE_STATS.glossaryTerms}-term glossary →</a>
        </div>
      </div>

      <div class="doors" role="tablist" aria-label="INFERENCE domain tracks">
        {INFERENCE_TRACK_GROUPS.map((g, idx) => {
          const trackUnits = unitsByTrack[g.id] ?? [];
          const freeCount = trackUnits.filter((u) => u.isFree).length;
          return (
            <button
              type="button"
              role="tab"
              class="door"
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`panel-${g.id}`}
              data-track-tab={g.id}
              style={`--accent:var(--${g.accent});--tint:var(--wash-${g.accent})`}
            >
              <span class="door__label">
                <span class="door__dot" aria-hidden="true"></span>
                {g.label}
                <span class="door__n">{trackUnits.length}</span>
              </span>
              <span class="door__ask">
                {TRACK_WORD_DEPTH[g.id] ?? '15,000+ words'}{freeCount > 0 ? ` · ${freeCount} free` : ''}
              </span>
            </button>
          );
        })}
      </div>

      <div class="inf-panels">
        {INFERENCE_TRACK_GROUPS.map((g, idx) => {
          const trackUnits = unitsByTrack[g.id] ?? [];
          const freeUnits = trackUnits.filter((u) => u.isFree);
          const lockedCount = trackUnits.length - freeUnits.length;
          const firstFree = freeUnits[0];
          const wordDepth = TRACK_WORD_DEPTH[g.id] ?? '15,000+ words';
          const isDomainOption = INFERENCE_DOMAIN_OPTIONS.some((o) => o.id === g.id);

          return (
            <div
              id={`panel-${g.id}`}
              role="tabpanel"
              class:list={['inf-panel', idx !== 0 && 'is-hidden']}
              data-track-panel={g.id}
              style={`--accent:var(--${g.accent})`}
            >
              <div class="status">
                <p class="status__text">
                  <strong>{g.label}.</strong> {g.summary} ({wordDepth} · {freeUnits.length} free, {lockedCount} in edition.)
                </p>
                <div class="status__links">
                  <a class="linkish" href={firstFree?.freeSlug ? `/inference/read/${firstFree.freeSlug}/` : '/inference/read/'}>
                    {firstFree?.freeSlug ? 'Read free unit →' : 'Read 5 free units →'}
                  </a>
                  <a class="linkish" href="#pricing" data-unlock-track={isDomainOption ? g.id : 'full'}>
                    {isDomainOption ? `Get ${g.label.split(' ')[0]} track →` : 'Get Full Edition →'}
                  </a>
                </div>
              </div>

              <ol class="qs">
                {trackUnits.map((u) => (
                  <li class="q">
                    {u.isFree && u.freeSlug ? (
                      <a href={`/inference/read/${u.freeSlug}/`} class="q__row">
                        <span class="q__ask">{u.title}</span>
                        <span class="q__deck">{u.deck}</span>
                        {u.questions.length > 0 && <span class="q__prompt">Room test: “{u.questions[0]}”</span>}
                        <span class="q__meta">
                          <span class="q__dot" aria-hidden="true"></span>
                          {u.unitNumber} · {g.label}
                          <span class="q__flag">{u.freeScope ?? 'Free unit'}</span>
                        </span>
                      </a>
                    ) : (
                      <div class="q__row">
                        <span class="q__ask">{u.title}</span>
                        <span class="q__deck">{u.deck}</span>
                        {u.questions.length > 0 && <span class="q__prompt">Room test: “{u.questions[0]}”</span>}
                        <span class="q__meta">
                          <span class="q__dot" aria-hidden="true"></span>
                          {u.unitNumber} · {g.label} · Full Edition &amp; Track ·{' '}
                          <a class="linkish q__link" href="#pricing" data-unlock-track={isDomainOption ? g.id : 'full'}>
                            View pricing →
                          </a>
                        </span>
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          );
        })}
      </div>
    </section>

    <section class="inf-sec" id="inside" aria-labelledby="inside-heading">
      <div class="inf-sec__head inf-sec__head--row">
        <div>
          <p class="inf-kicker">Inside the compendium · 3 exhibits</p>
          <h2 id="inside-heading">Inspect three real exhibits before opening a chapter</h2>
        </div>
        <a class="linkish" href="/inference/read/">Read all 5 free units in full →</a>
      </div>

      <div class="inf-exhibit-tabs" role="tablist" aria-label="Sample exhibits inside INFERENCE">
        <button type="button" role="tab" class="inf-exhibit-tab is-active" aria-selected="true" aria-controls="peek-panel-economics" data-peek-tab="economics">
          01 · Causal attention &amp; inference economics
        </button>
        <button type="button" role="tab" class="inf-exhibit-tab" aria-selected="false" aria-controls="peek-panel-india" data-peek-tab="india">
          02 · India DPDP + RBI FREE-AI matrix
        </button>
        <button type="button" role="tab" class="inf-exhibit-tab" aria-selected="false" aria-controls="peek-panel-rubric" data-peek-tab="rubric">
          03 · Consulting casebook recruiter rubric
        </button>
      </div>

      <div class="inf-exhibit-stage">
        <article id="peek-panel-economics" role="tabpanel" class="inf-exhibit" data-peek-panel="economics">
          <div class="inf-exhibit__head">
            <div>
              <p class="inf-exhibit__kicker">Ch 01, Ch 02 &amp; Ch 19 · Architecture to unit economics</p>
              <h3>Matching the right model class and pricing every token before deployment</h3>
            </div>
            <a class="linkish" href="/inference/read/ai-in-one-sitting/">Read Ch 00 free →</a>
          </div>

          <figure class="diagram inf-diagram">
            <svg viewBox="0 0 720 230" role="img" aria-label="Sample diagram from INFERENCE comparing written rules, predictive ML, and generative AI">
              <rect x="12" y="14" width="222" height="198" rx="4" fill="var(--paper-2)" stroke="var(--ochre)" stroke-width="1.5" />
              <text x="28" y="44" fill="var(--ochre)" font-family="var(--font)" font-size="14" font-weight="700">Written rules</text>
              <text x="28" y="72" fill="var(--ink)" font-family="var(--font)" font-size="13" font-weight="600">Fixed statutory logic</text>
              <text x="28" y="98" fill="var(--ink-soft)" font-family="var(--font)" font-size="13">Output: yes / no gate</text>
              <text x="28" y="120" fill="var(--ink-soft)" font-family="var(--font)" font-size="13">Data: policy thresholds</text>
              <text x="28" y="142" fill="var(--ink-soft)" font-family="var(--font)" font-size="13">Audit: line-by-line rule</text>
              <text x="28" y="188" fill="var(--ink-faint)" font-family="var(--font)" font-size="13">Ch 01 · Zero API cost</text>

              <rect x="249" y="14" width="222" height="198" rx="4" fill="var(--paper-2)" stroke="var(--mizu)" stroke-width="1.5" />
              <text x="265" y="44" fill="var(--mizu)" font-family="var(--font)" font-size="14" font-weight="700">Predictive ML</text>
              <text x="265" y="72" fill="var(--ink)" font-family="var(--font)" font-size="13" font-weight="600">Structured rows &amp; labels</text>
              <text x="265" y="98" fill="var(--ink-soft)" font-family="var(--font)" font-size="13">Output: score or forecast</text>
              <text x="265" y="120" fill="var(--ink-soft)" font-family="var(--font)" font-size="13">Data: bureau, POS, churn</text>
              <text x="265" y="142" fill="var(--ink-soft)" font-family="var(--font)" font-size="13">Audit: holdout error &amp; SHAP</text>
              <text x="265" y="188" fill="var(--ink-faint)" font-family="var(--font)" font-size="13">Ch 01 &amp; Ch 22 · Deterministic</text>

              <rect x="486" y="14" width="222" height="198" rx="4" fill="var(--paper-2)" stroke="var(--plum)" stroke-width="1.5" />
              <text x="502" y="44" fill="var(--plum)" font-family="var(--font)" font-size="14" font-weight="700">Generative AI</text>
              <text x="502" y="72" fill="var(--ink)" font-family="var(--font)" font-size="13" font-weight="600">Unstructured text &amp; PDFs</text>
              <text x="502" y="98" fill="var(--ink-soft)" font-family="var(--font)" font-size="13">Output: summary, tag, code</text>
              <text x="502" y="120" fill="var(--ink-soft)" font-family="var(--font)" font-size="13">Data: contracts, calls, logs</text>
              <text x="502" y="142" fill="var(--ink-soft)" font-family="var(--font)" font-size="13">Audit: eval suite + human QA</text>
              <text x="502" y="188" fill="var(--ink-faint)" font-family="var(--font)" font-size="13">Ch 02–07 · Token metered</text>
            </svg>
            <figcaption>
              Exhibit 01 · Tokenised vector figure from INFERENCE (re-skinned automatically for light and dark themes across all 34 figures).
            </figcaption>
          </figure>

          <dl class="inf-econ">
            {ECON_METRICS.map((m) => (
              <div>
                <dt>{m.k}</dt>
                <dd class="inf-econ__val">{m.val}</dd>
                <dd class="inf-econ__note">{m.note}</dd>
              </div>
            ))}
          </dl>
        </article>

        <article id="peek-panel-india" role="tabpanel" class="inf-exhibit is-hidden" data-peek-panel="india">
          <div class="inf-exhibit__head">
            <div>
