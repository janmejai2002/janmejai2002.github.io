<script>
  import {
    getCheckoutHref,
    INFERENCE_TRACK_GROUPS,
    INFERENCE_UNITS,
    type Currency,
    type InferenceSku,
  } from '../../data/inference';
  import { createInference3DStage, type Inference3DStage } from '../../scripts/inference-3d';

  const params = new URLSearchParams(location.search);

  const angle = params.get('angle');
  const kicker = document.getElementById('inf-angle-kicker');
  if (kicker && angle === 'mba') {
    kicker.textContent = 'Built for 2026-27 B-school SIP, Finals, and AI case interviews across consulting, finance, and product.';
  } else if (kicker && angle === 'exec') {
    kicker.textContent = 'Built for operators, product managers, and consultants auditing AI margins, governance, and deployment failures.';
  }

  const stageShell = document.getElementById('inf-3d-shell');
  const stageCanvas = document.querySelector<HTMLCanvasElement>('[data-inference-3d]');
  const stageNote = document.getElementById('inf-stage-note');
  const heroCues = [...document.querySelectorAll<HTMLButtonElement>('[data-hero-domain]')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-track-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-track-panel]')];

  const trackLookup = new Map(
    INFERENCE_TRACK_GROUPS.map((g) => {
      const units = INFERENCE_UNITS.filter((u) => u.trackId === g.id);
      return [g.id, { ...g, total: units.length, free: units.filter((u) => u.isFree).length }];
    })
  );

  let stage3d: Inference3DStage | null = null;
  let activeTrackId = 'foundations';

  const updateNote = (trackId: string) => {
    const info = trackLookup.get(trackId);
    if (!info || !stageNote) return;
    const scope = info.free > 0 ? `${info.total} units, ${info.free} free` : `${info.total} units`;
    stageNote.textContent = `${info.label} · ${scope}. Drag to turn, or choose a domain below.`;
  };

  const activateTrack = (trackId: string, sync3d = true) => {
    if (!trackLookup.has(trackId)) return;
    activeTrackId = trackId;
    for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.trackTab === trackId));
    for (const p of panels) p.classList.toggle('is-hidden', p.dataset.trackPanel !== trackId);
    for (const cue of heroCues) {
      const active = cue.dataset.heroDomain === trackId;
      cue.classList.toggle('cue--on', active);
      cue.setAttribute('aria-pressed', String(active));
    }
    updateNote(trackId);
    if (sync3d) stage3d?.setTrack(trackId);
  };

  if (stageCanvas) {
    stage3d = createInference3DStage(stageCanvas, {
      initialTrack: activeTrackId,
      onSelectTrack: (trackId) => activateTrack(trackId, false),
      onHoverTrack: (trackId) => updateNote(trackId ?? activeTrackId),
    });
    if (stage3d && stageShell) stageShell.classList.add('is-gl-ready');
  }

  for (const cue of heroCues) {
    cue.addEventListener('click', () => cue.dataset.heroDomain && activateTrack(cue.dataset.heroDomain));
  }
  for (const t of tabs) {
    t.addEventListener('click', () => t.dataset.trackTab && activateTrack(t.dataset.trackTab));
  }

  const initialTrack = params.get('track');
  if (initialTrack && trackLookup.has(initialTrack)) activateTrack(initialTrack);
  else updateNote(activeTrackId);

  const peekTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-peek-tab]')];
  const peekPanels = [...document.querySelectorAll<HTMLElement>('[data-peek-panel]')];
  for (const pt of peekTabs) {
    pt.addEventListener('click', () => {
      const id = pt.dataset.peekTab;
      if (!id) return;
      for (const t of peekTabs) {
        const on = t.dataset.peekTab === id;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      }
      for (const p of peekPanels) p.classList.toggle('is-hidden', p.dataset.peekPanel !== id);
    });
  }

  const currencyBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-currency-btn]')];
  const domainSelect = document.getElementById('domain-track-select') as HTMLSelectElement | null;
  let activeCurrency: Currency = 'INR';
  try {
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    if (tz && !/Kolkata|Calcutta|Asia\/Dhaka|Asia\/Colombo/i.test(tz)) activeCurrency = 'USD';
  } catch {}

  const applyCurrency = (curr: Currency) => {
    activeCurrency = curr;
    for (const b of currencyBtns) {
      const on = b.dataset.currencyBtn === curr;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', String(on));
    }
    for (const el of document.querySelectorAll<HTMLElement>('.inf-sku__amount')) {
      el.textContent = curr === 'INR' ? el.dataset.priceInr || '' : el.dataset.priceUsd || '';
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-saving-inr]')) {
      el.textContent = curr === 'INR' ? el.dataset.savingInr || '' : el.dataset.savingUsd || '';
    }
    const selectedDomain = domainSelect?.value || 'consulting';
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-checkout-cta]')) {
      const sku = link.dataset.checkoutCta as InferenceSku['id'];
      link.href = getCheckoutHref(sku, curr, sku === 'domain-track' ? selectedDomain : undefined);
    }
  };

  for (const b of currencyBtns) {
    b.addEventListener('click', () => b.dataset.currencyBtn && applyCurrency(b.dataset.currencyBtn as Currency));
  }
  domainSelect?.addEventListener('change', () => applyCurrency(activeCurrency));
  applyCurrency(activeCurrency);

  for (const trigger of document.querySelectorAll<HTMLAnchorElement>('[data-unlock-track]')) {
    trigger.addEventListener('click', () => {
      const track = trigger.dataset.unlockTrack;
      if (domainSelect && track && track !== 'full' && [...domainSelect.options].some((o) => o.value === track)) {
        domainSelect.value = track;
        applyCurrency(activeCurrency);
      }
    });
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-umami-sku], [data-checkout-cta]')) {
    link.addEventListener('click', () => {
      const sku = link.dataset.checkoutCta || link.dataset.umamiSku || 'unknown';
      const w = window as unknown as { umami?: { track?: (name: string, data: Record<string, string>) => void } };
      w.umami?.track?.('inference_cta', { sku, currency: activeCurrency });
    });
  }

  window.addEventListener('pagehide', () => stage3d?.destroy());
</script>

