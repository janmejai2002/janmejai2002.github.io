<script>
  import {
    getCheckoutHref,
    INFERENCE_TRACK_GROUPS,
    INFERENCE_UNITS,
    type Currency,
    type InferenceSku,
  } from '../../data/inference';
  import { createInference3DStage, type Inference3DStage } from '../../scripts/inference-3d';

  const params = new URLSearchParams(location.search);
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 1. Query param ?angle=mba | exec message match
  const angle = params.get('angle');
  const kicker = document.getElementById('inf-angle-kicker');
  if (kicker && angle === 'mba') {
    kicker.textContent =
      'Built for 2026-27 B-school SIP, Finals, and AI case interviews across consulting, finance, and product.';
  } else if (kicker && angle === 'exec') {
    kicker.textContent =
      'Built for operators, product managers, and consultants auditing AI margins, governance, and deployment failures.';
  }

  // 2. Animated KPI Counter Strip (SSR displays exact numbers; animates gently on capable browsers)
  if (!reducedMotion) {
    const kpis = [...document.querySelectorAll<HTMLElement>('[data-kpi-target]')];
    const duration = 950;
    const start = performance.now();
    const tickKpi = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      for (const el of kpis) {
        const target = Number(el.dataset.kpiTarget || '0');
        const val = Math.round(target * eased);
        el.textContent = target >= 1000 ? val.toLocaleString('en-US') : String(val);
      }
      if (t < 1) requestAnimationFrame(tickKpi);
    };
    requestAnimationFrame(tickKpi);
  }

  // 3. Synchronised 3D Monolith + Hero Domain Pills + 7-Track Explorer
  const stageShell = document.getElementById('inf-3d-shell');
  const stageCanvas = document.querySelector<HTMLCanvasElement>('[data-inference-3d]');
  const hudName = document.getElementById('inf-stage-domain-name');
  const hudMeta = document.getElementById('inf-stage-domain-meta');
  const heroPills = [...document.querySelectorAll<HTMLButtonElement>('[data-hero-domain]')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-track-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-track-panel]')];

  const trackLookup = new Map(
    INFERENCE_TRACK_GROUPS.map((g) => {
      const units = INFERENCE_UNITS.filter((u) => u.trackId === g.id);
      const freeCount = units.filter((u) => u.isFree).length;
      return [g.id, { ...g, total: units.length, free: freeCount }];
    })
  );

  let stage3d: Inference3DStage | null = null;
  let activeTrackId = 'foundations';

  const updateHud = (trackId: string) => {
    const info = trackLookup.get(trackId);
    if (!info) return;
    if (hudName) hudName.textContent = info.label;
    if (hudMeta) {
      hudMeta.textContent = `${info.total} units${info.free > 0 ? ` · ${info.free} free` : ' · Full & Track'}`;
    }
    if (stageShell) {
      stageShell.dataset.activeAccent = info.accent;
    }
  };

  const activateTrack = (trackId: string, sync3d = true) => {
    if (!trackLookup.has(trackId)) return;
    activeTrackId = trackId;

    for (const t of tabs) {
      const active = t.dataset.trackTab === trackId;
      t.classList.toggle('is-active', active);
      t.setAttribute('aria-selected', active ? 'true' : 'false');
    }
    for (const p of panels) {
      p.classList.toggle('is-hidden', p.dataset.trackPanel !== trackId);
    }
    for (const pill of heroPills) {
      const active = pill.dataset.heroDomain === trackId;
      pill.classList.toggle('is-active', active);
      pill.setAttribute('aria-pressed', active ? 'true' : 'false');
    }

    updateHud(trackId);
    if (sync3d) stage3d?.setTrack(trackId);
  };

  // Mount WebGL2 Compendium Monolith
  if (stageCanvas) {
    stage3d = createInference3DStage(stageCanvas, {
      initialTrack: activeTrackId,
      onSelectTrack: (trackId) => activateTrack(trackId, false),
      onHoverTrack: (trackId) => {
        if (trackId) updateHud(trackId);
        else updateHud(activeTrackId);
      },
    });
    if (stage3d && stageShell) {
      stageShell.classList.add('is-gl-ready');
    }
  }

  let hoverTimer = 0;
  const scheduleHoverTrack = (trackId: string) => {
    window.clearTimeout(hoverTimer);
    hoverTimer = window.setTimeout(() => activateTrack(trackId), 65);
  };

  for (const pill of heroPills) {
    const id = pill.dataset.heroDomain;
    if (!id) continue;
    pill.addEventListener('click', () => activateTrack(id));
    pill.addEventListener('pointerenter', () => scheduleHoverTrack(id));
    pill.addEventListener('focus', () => activateTrack(id));
  }

  for (const t of tabs) {
    const id = t.dataset.trackTab;
    if (!id) continue;
    t.addEventListener('click', () => activateTrack(id));
    t.addEventListener('pointerenter', () => scheduleHoverTrack(id));
    t.addEventListener('focus', () => activateTrack(id));
  }

  const initialTrack = params.get('track');
  if (initialTrack && trackLookup.has(initialTrack)) {
    activateTrack(initialTrack);
  } else {
    updateHud(activeTrackId);
  }

  // 4. Interactive Sample Peek ("Inside the Compendium") Tabs
  const peekTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-peek-tab]')];
  const peekPanels = [...document.querySelectorAll<HTMLElement>('[data-peek-panel]')];
  const activatePeek = (peekId: string) => {
    for (const pt of peekTabs) {
      const on = pt.dataset.peekTab === peekId;
      pt.classList.toggle('is-active', on);
      pt.setAttribute('aria-selected', on ? 'true' : 'false');
    }
    for (const pp of peekPanels) {
      pp.classList.toggle('is-hidden', pp.dataset.peekPanel !== peekId);
    }
  };
  for (const pt of peekTabs) {
    pt.addEventListener('click', () => {
      if (pt.dataset.peekTab) activatePeek(pt.dataset.peekTab);
    });
  }

  // 5. INR / USD Currency Toggle + Domain Selector + Pre-select from Explorer + Umami CTA tracking
  const currencyBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-currency-btn]')];
  const domainSelect = document.getElementById('domain-track-select') as HTMLSelectElement | null;
  let activeCurrency: Currency = 'INR';

  try {
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    if (tz && !/Kolkata|Calcutta|Asia\/Dhaka|Asia\/Colombo/i.test(tz)) {
      activeCurrency = 'USD';
    }
  } catch {}

  const applyCurrency = (curr: Currency) => {
    activeCurrency = curr;
    for (const b of currencyBtns) {
      const on = b.dataset.currencyBtn === curr;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    }
    for (const el of document.querySelectorAll<HTMLElement>('.inf-sku__amount')) {
      el.textContent = curr === 'INR' ? el.dataset.priceInr || '' : el.dataset.priceUsd || '';
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-saving-inr]')) {
      el.textContent = curr === 'INR' ? el.dataset.savingInr || '' : el.dataset.savingUsd || '';
    }
    const selectedDomain = domainSelect?.value || 'consulting';
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-checkout-cta]')) {
      const sku = link.dataset.checkoutCta as InferenceSku['id'];
      link.href = getCheckoutHref(sku, curr, sku === 'domain-track' ? selectedDomain : undefined);
    }
  };

  for (const b of currencyBtns) {
    b.addEventListener('click', () => {
      const next = b.dataset.currencyBtn as Currency;
      if (next) applyCurrency(next);
    });
  }
  domainSelect?.addEventListener('change', () => applyCurrency(activeCurrency));
  applyCurrency(activeCurrency);

  // Clicking "Unlock <Track>" inside the Track Explorer pre-selects that domain in Pricing
  for (const trigger of document.querySelectorAll<HTMLAnchorElement>('[data-unlock-track]')) {
    trigger.addEventListener('click', () => {
      const track = trigger.dataset.unlockTrack;
      if (domainSelect && track && track !== 'full') {
        const hasOpt = [...domainSelect.options].some((o) => o.value === track);
        if (hasOpt) {
          domainSelect.value = track;
          applyCurrency(activeCurrency);
        }
      }
    });
  }

  // 6. Cursor-Spotlight Magnetic Illumination on Pricing Cards
  const spotlightCards = [...document.querySelectorAll<HTMLElement>('[data-spotlight-card]')];
  for (const card of spotlightCards) {
    card.addEventListener('pointermove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / Math.max(1, rect.width)) * 100;
      const y = ((e.clientY - rect.top) / Math.max(1, rect.height)) * 100;
      card.style.setProperty('--mx', `${x.toFixed(1)}%`);
      card.style.setProperty('--my', `${y.toFixed(1)}%`);
    });
  }

  // 7. Umami Conversion Tracking
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-umami-sku], [data-checkout-cta]')) {
    link.addEventListener('click', () => {
      const sku = link.dataset.checkoutCta || link.dataset.umamiSku || 'unknown';
      const w = window as unknown as { umami?: { track?: (name: string, data: Record<string, string>) => void } };
      w.umami?.track?.('inference_cta', { sku, currency: activeCurrency });
    });
  }

  window.addEventListener('pagehide', () => stage3d?.destroy());
</script>

