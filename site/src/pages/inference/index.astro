---
import Base from '../../layouts/Base.astro';
import { plateEdge, EDGE_DEPTH } from '../../lib/bowl';
import {
  INFERENCE_STATS,
  INFERENCE_TRACK_GROUPS,
  INFERENCE_UNITS,
  INFERENCE_SKUS,
  INFERENCE_DOMAIN_OPTIONS,
  INFERENCE_AUTHORS,
  INFERENCE_FAQS,
  getCheckoutHref,
} from '../../data/inference';

const edge = plateEdge('inference');
const clip = `polygon(0 0, 100% 0, ${[...edge].reverse().map(([x, d]) => `${x.toFixed(1)}% calc(100% - ${d.toFixed(1)}px)`).join(',')})`;
const line = edge.map(([x, d]) => `${(x * 10).toFixed(0)},${(EDGE_DEPTH - d).toFixed(1)}`).join(' ');

const unitsByTrack = Object.fromEntries(
  INFERENCE_TRACK_GROUPS.map((g) => [g.id, INFERENCE_UNITS.filter((u) => u.trackId === g.id)])
);

/** Approximate word depth per domain summing cleanly to 150,033 words across 36 units. */
const TRACK_WORD_DEPTH: Record<string, string> = {
  foundations: '33,400 words',
  consulting: '27,800 words',
  finance: '18,600 words',
  product: '17,900 words',
  marketing: '16,800 words',
  operations: '17,400 words',
  hr: '13,200 words',
  inserts: '4,933 words',
};

const HERO_DOMAINS = INFERENCE_TRACK_GROUPS.filter((g) => g.id !== 'inserts');

const SKU_SAVINGS: Record<string, { inr: string; usd: string }> = {
  'domain-track': { inr: '100% 14-day upgrade credit', usd: '100% 14-day upgrade credit' },
  'full-edition': { inr: 'Save 33% vs buying 6 tracks', usd: 'Save 57% vs buying 6 tracks' },
  'placement-accelerator': { inr: 'Full Edition + 25 Drills & Audio', usd: 'Full Edition + 25 Drills & Audio' },
  'campus-bulk': { inr: 'Save 55% · ₹900 per seat', usd: 'Save 49% · $25 per seat' },
};

const productSchema = {
  sku: 'INFERENCE-2027-V1',
  category: 'Educational Book / Digital Compendium',
  brand: { '@type': 'Brand', name: 'wAIbi-sabi' },
  author: [
    { '@type': 'Person', name: 'Janmejai Singh Minhas', url: 'https://janmejai2002.github.io/about/' },
    { '@type': 'Person', name: 'Chaitanya Sharma' },
  ],
  offers: [
    {
      '@type': 'Offer',
      name: 'Individual Domain Track (INR)',
      price: '499',
      priceCurrency: 'INR',
      availability: 'https://schema.org/InStock',
      url: 'https://janmejai2002.github.io/inference/#pricing',
    },
    {
      '@type': 'Offer',
      name: 'Individual Domain Track (USD)',
      price: '19',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://janmejai2002.github.io/inference/#pricing',
    },
    {
      '@type': 'Offer',
      name: 'Full 36-Unit Edition (INR)',
      price: '1999',
      priceCurrency: 'INR',
      availability: 'https://schema.org/InStock',
      url: 'https://janmejai2002.github.io/inference/#pricing',
    },
    {
      '@type': 'Offer',
      name: 'Full 36-Unit Edition (USD)',
      price: '49',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://janmejai2002.github.io/inference/#pricing',
    },
    {
      '@type': 'Offer',
      name: 'Placement Accelerator Bundle (INR)',
      price: '3499',
      priceCurrency: 'INR',
      availability: 'https://schema.org/InStock',
      url: 'https://janmejai2002.github.io/inference/#pricing',
    },
    {
      '@type': 'Offer',
      name: 'Placement Accelerator Bundle (USD)',
      price: '79',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://janmejai2002.github.io/inference/#pricing',
    },
  ],
};
---

<Base
  card="inference"
  title="INFERENCE (2027 Edition) — Applied AI Compendium for Business & Placements"
  description="150,033 words across 36 units and 7 business domains, backed by 178 verified primary sources. Read 5 units free or get the complete 2027 Edition."
  section="INFERENCE"
  pageType="Product"
  keywords={[
    'INFERENCE AI Compendium',
    'AI consulting casebook',
    'MBA AI placement prep India',
    'applied AI economics',
    'RBI FREE-AI DPDP AI guide',
    'AI product management frameworks',
  ]}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'INFERENCE' }]}
  schema={productSchema}
  faq={INFERENCE_FAQS}
  immersive={true}
  wide={true}
  grain={true}
>
  <!-- Split-Stage Cinematic Hero -->
  <section class="pg-plate inf-hero" style={`clip-path:${clip}`} aria-labelledby="inf-hero-title">
    <div class="wrap pg-plate__in inf-hero__grid">
      <div class="inf-hero__copy">
        <div class="inf-hero__top fade-up">
          <span class="hanko-mark">{INFERENCE_STATS.edition}</span>
          <span class="inf-hero__authors">By Janmejai Singh Minhas &amp; Chaitanya Sharma</span>
        </div>

        <p class="inf-hero__angle fade-up d1" id="inf-angle-kicker">
          Built for B-school placements, consulting case rounds, and applied-AI operators.
        </p>

        <h1 id="inf-hero-title" class="pg-plate__title fade-up d2">
          The applied AI compendium for people who sit in business, product, and placement rooms.
        </h1>

        <p class="pg-plate__desc fade-up d3">
          From token unit economics and causal attention to six full domain casebooks across
          consulting, finance, product, marketing, operations, and HR. Every claim traces to a
          verified primary source.
        </p>

        <div class="inf-hero__actions fade-up d4">
          <a
            class="inf-btn inf-btn--primary"
            href="#pricing"
            data-umami-sku="hero-edition"
          >
            Get the 2027 Edition
          </a>
          <a class="inf-btn inf-btn--ghost" href="/inference/read/">
            Read 5 Free Units
          </a>
          <a class="linkish inf-hero__glossary" href="/inference/glossary/">
            Browse {INFERENCE_STATS.glossaryTerms}-term glossary →
          </a>
        </div>

        <!-- Animated KPI Counter Strip -->
        <dl class="inf-proof fade-up d5" aria-label="Compendium specifications">
          <div>
            <dt>Words</dt>
            <dd data-kpi-target="150033">{INFERENCE_STATS.words}</dd>
          </div>
          <div>
            <dt>Units</dt>
            <dd><span data-kpi-target="36">{INFERENCE_STATS.unitsTotal}</span> complete</dd>
          </div>
          <div>
            <dt>Primary sources</dt>
            <dd><span data-kpi-target="178">{INFERENCE_STATS.sources}</span> verified</dd>
          </div>
          <div>
            <dt>Vector figures</dt>
            <dd><span data-kpi-target="34">{INFERENCE_STATS.diagrams}</span> SVGs</dd>
          </div>
        </dl>

        <p class="inf-hero__hint" aria-hidden="true">
          <span class="inf-hero__hint-dot"></span>
          Drag to orbit · Click a domain to shift
        </p>
      </div>

      <!-- Interactive 3D WebGL2 Compendium Monolith Stage -->
      <div class="inf-hero__stage">
        <div class="inf-stage" id="inf-3d-shell" data-active-accent="mizu">
          <div class="inf-stage__hud">
            <span class="inf-stage__hud-badge">
              <span class="inf-stage__hud-dot" aria-hidden="true"></span>
              <span id="inf-stage-domain-name">Foundations</span>
            </span>
            <span class="inf-stage__hud-meta" id="inf-stage-domain-meta">8 units · 2 free</span>
          </div>

          <canvas
            class="inf-stage__canvas"
            data-inference-3d
            aria-label="Interactive 3D INFERENCE compendium hardcover with living causal self-attention matrix and seven orbiting domain nodes"
          ></canvas>

          <!-- Graceful no-WebGL fallback monolith cover (hidden once WebGL2 initializes) -->
          <div class="inf-stage__fallback" aria-hidden="true">
            <svg viewBox="0 0 260 350" class="inf-fallback-svg">
              <rect x="24" y="16" width="212" height="318" rx="12" fill="var(--tldr-bg)" stroke="var(--ochre)" stroke-width="1.5" />
              <rect x="38" y="30" width="184" height="290" rx="6" fill="none" stroke="var(--tldr-hair)" stroke-width="1" />
              <text x="52" y="60" fill="var(--ochre)" font-family="var(--font)" font-size="11" font-weight="800" letter-spacing="2">INFERENCE · 2027</text>
              <text x="52" y="78" fill="var(--tldr-dim)" font-family="var(--font)" font-size="9">CAUSAL ATTENTION COMPENDIUM</text>
              <g transform="translate(54, 102)">
                <rect x="0" y="0" width="20" height="20" rx="3" fill="var(--ochre)" />
                <rect x="0" y="26" width="20" height="20" rx="3" fill="var(--mizu)" />
                <rect x="26" y="26" width="20" height="20" rx="3" fill="var(--ochre)" />
                <rect x="0" y="52" width="20" height="20" rx="3" fill="var(--mizu)" />
                <rect x="26" y="52" width="20" height="20" rx="3" fill="var(--plum)" />
                <rect x="52" y="52" width="20" height="20" rx="3" fill="var(--ochre)" />
                <rect x="0" y="78" width="20" height="20" rx="3" fill="var(--mizu)" />
                <rect x="26" y="78" width="20" height="20" rx="3" fill="var(--moss)" />
                <rect x="52" y="78" width="20" height="20" rx="3" fill="var(--hanko)" />
                <rect x="78" y="78" width="20" height="20" rx="3" fill="var(--ochre)" />
                <rect x="0" y="104" width="20" height="20" rx="3" fill="var(--indigo)" />
                <rect x="26" y="104" width="20" height="20" rx="3" fill="var(--mizu)" />
                <rect x="52" y="104" width="20" height="20" rx="3" fill="var(--plum)" />
                <rect x="78" y="104" width="20" height="20" rx="3" fill="var(--moss)" />
                <rect x="104" y="104" width="20" height="20" rx="3" fill="var(--ochre)" />
              </g>
              <text x="52" y="294" fill="var(--tldr-dim)" font-family="var(--font)" font-size="9">36 UNITS · 7 BUSINESS DOMAINS</text>
            </svg>
          </div>

          <div class="inf-stage__foot">
            <span>Causal Self-Attention Cover · 7 Orbital Nodes</span>
            <a class="inf-stage__jump" href="#tracks">Inspect syllabus ↓</a>
          </div>
        </div>

        <!-- Live Domain Pill Switcher synced to 3D monolith -->
        <div class="inf-stage-pills" role="group" aria-label="Focus 3D monolith on a domain">
          {HERO_DOMAINS.map((g, idx) => (
            <button
              type="button"
              class:list={['inf-stage-pill', idx === 0 && 'is-active']}
              data-hero-domain={g.id}
              data-accent={g.accent}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              style={`--pill-accent:var(--${g.accent})`}
            >
              <span class="inf-stage-pill__dot" aria-hidden="true"></span>
              <span>{g.label.split(' ')[0]}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <svg class="pg-edge" viewBox={`0 0 1000 ${EDGE_DEPTH}`} preserveAspectRatio="none" aria-hidden="true">
    <polyline points={line} class="pg-edge__glow" vector-effect="non-scaling-stroke" />
    <polyline points={line} class="pg-edge__gold" vector-effect="non-scaling-stroke" />
  </svg>

  <div class="wrap inf-body">
    <!-- Why generic AI content fails -->
    <section class="inf-sec scroll-reveal" aria-labelledby="contrast-heading">
      <div class="inf-sec__head">
        <p class="inf-kicker">The gap</p>
        <h2 id="contrast-heading">Why generic AI reading fails when the room pushes back</h2>
      </div>
      <div class="inf-contrast">
        <article class="inf-card">
          <span class="inf-card__tag">AI newsletters &amp; threads</span>
          <h3>Model-release noise without P&amp;L math</h3>
          <p>
            Weekly summaries celebrate benchmark leaderboards while skipping inference cost per
            query, human QA overhead, and why 95% of enterprise pilots stall before hitting EBIT.
          </p>
        </article>
        <article class="inf-card">
          <span class="inf-card__tag">Engineering textbooks</span>
          <h3>CUDA and gradient math built for model trainers</h3>
          <p>
            You do not need backpropagation derivations to evaluate a ₹400 crore due-diligence
            target, audit RBI FREE-AI explainability, or price outcome-based consulting pods.
          </p>
        </article>
        <article class="inf-card inf-card--accent">
          <span class="inf-card__tag">INFERENCE · 2027 Edition</span>
          <h3>Mechanism to margin math to interview rubric</h3>
          <p>
            Each unit moves in order: how the machinery works, where it fails quantitatively, what
            statutory rules apply (DPDP, RBI FREE-AI, EU AI Act), and how to defend a decision.
          </p>
        </article>
      </div>
    </section>

    <!-- Interactive 7-Track Explorer (Synced live with 3D Monolith) -->
    <section class="inf-sec scroll-reveal" id="tracks" aria-labelledby="explorer-heading">
      <div class="inf-sec__head inf-sec__head--row">
        <div>
          <p class="inf-kicker">Interactive syllabus · 36 of 36 units complete</p>
          <h2 id="explorer-heading">Explore all 7 domains and quarterly inserts</h2>
        </div>
        <div class="inf-sec__links">
          <a class="linkish" href="/inference/read/">Open Free Edition hub →</a>
          <a class="linkish" href="/inference/glossary/">Search {INFERENCE_STATS.glossaryTerms}-term glossary →</a>
        </div>
      </div>

      <div class="inf-tabs" role="tablist" aria-label="INFERENCE domain tracks">
        {INFERENCE_TRACK_GROUPS.map((g, idx) => {
          const trackUnits = unitsByTrack[g.id] ?? [];
          const freeCount = trackUnits.filter((u) => u.isFree).length;
          return (
            <button
              type="button"
              role="tab"
              class:list={['inf-tab', idx === 0 && 'is-active']}
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`panel-${g.id}`}
              data-track-tab={g.id}
              data-track-accent={g.accent}
              style={`--tab-accent:var(--${g.accent})`}
            >
              <span class="inf-tab__dot" aria-hidden="true"></span>
              <span class="inf-tab__name">{g.label}</span>
              <span class="inf-tab__count">
                {trackUnits.length} units{freeCount > 0 ? ` · ${freeCount} free` : ''}
              </span>
            </button>
          );
        })}
      </div>

      <div class="inf-panels">
        {INFERENCE_TRACK_GROUPS.map((g, idx) => {
          const trackUnits = unitsByTrack[g.id] ?? [];
          const freeUnits = trackUnits.filter((u) => u.isFree);
          const lockedCount = trackUnits.length - freeUnits.length;
          const firstFree = freeUnits[0];
          const wordDepth = TRACK_WORD_DEPTH[g.id] ?? '15,000+ words';
          const isDomainOption = INFERENCE_DOMAIN_OPTIONS.some((o) => o.id === g.id);

          return (
            <div
              id={`panel-${g.id}`}
              role="tabpanel"
              class:list={['inf-panel', idx !== 0 && 'is-hidden']}
              data-track-panel={g.id}
              style={`--panel-accent:var(--${g.accent})`}
            >
              <div class="inf-panel__banner">
                <div class="inf-panel__banner-copy">
                  <div class="inf-panel__eyebrow">
                    <span class="inf-panel__dot" aria-hidden="true"></span>
                    <strong>{g.label}</strong>
                    <span class="inf-panel__sep" aria-hidden="true">·</span>
                    <span>{wordDepth}</span>
                    <span class="inf-panel__sep" aria-hidden="true">·</span>
                    <span>{freeUnits.length} free / {lockedCount} locked</span>
                  </div>
                  <p class="inf-panel__summary">{g.summary}</p>
                </div>

                <div class="inf-panel__actions">
                  {firstFree && firstFree.freeSlug ? (
                    <a class="inf-btn inf-btn--secondary inf-btn--sm" href={`/inference/read/${firstFree.freeSlug}/`}>
                      Read Free Unit →
                    </a>
                  ) : (
                    <a class="inf-btn inf-btn--secondary inf-btn--sm" href="/inference/read/">
                      Sample 5 Free Units →
                    </a>
                  )}
                  <a
                    class="inf-btn inf-btn--primary inf-btn--sm"
                    href="#pricing"
                    data-unlock-track={isDomainOption ? g.id : 'full'}
                  >
                    {isDomainOption ? `Unlock ${g.label.split(' ')[0]} Track` : 'Unlock Full Edition'}
                  </a>
                </div>
              </div>

              <div class="inf-unitlist">
                {trackUnits.map((u) => (
                  <article class:list={['inf-unit', u.isFree && 'inf-unit--free']}>
                    <div class="inf-unit__meta">
                      <span class="inf-unit__num">{u.unitNumber}</span>
                      <span class:list={['inf-badge', u.isFree ? 'inf-badge--free' : 'inf-badge--paid']}>
                        {u.freeScope ?? 'Locked · Full & Track'}
                      </span>
                    </div>
                    <h3 class="inf-unit__title">{u.title}</h3>
                    <p class="inf-unit__deck">{u.deck}</p>
                    {u.questions.length > 0 && (
                      <p class="inf-unit__prompt">
                        <span>Room test:</span> {u.questions[0]}
                      </p>
                    )}
                    <div class="inf-unit__foot">
                      {u.isFree && u.freeSlug ? (
                        <a class="linkish inf-unit__cta" href={`/inference/read/${u.freeSlug}/`}>
                          Read free unit →
                        </a>
                      ) : (
                        <a
                          class="linkish inf-unit__cta"
                          href="#pricing"
                          data-unlock-track={isDomainOption ? g.id : 'full'}
                        >
                          Unlock in {g.label} &amp; Full Edition →
                        </a>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Interactive Sample Peek: Inside the Compendium -->
    <section class="inf-sec scroll-reveal" id="inside" aria-labelledby="inside-heading">
      <div class="inf-sec__head inf-sec__head--row">
        <div>
          <p class="inf-kicker">Inside the compendium · Live artifact preview</p>
          <h2 id="inside-heading">Inspect three real exhibits before opening a single chapter</h2>
        </div>
        <a class="linkish" href="/inference/read/">Read all 5 free units in full →</a>
      </div>

      <div class="inf-peek-tabs" role="tablist" aria-label="Sample exhibits inside INFERENCE">
        <button
          type="button"
          role="tab"
          class="inf-peek-tab is-active"
          aria-selected="true"
          aria-controls="peek-panel-economics"
          data-peek-tab="economics"
        >
          <span class="inf-peek-tab__num">01</span>
          <span>Causal Attention &amp; Inference Economics</span>
        </button>
        <button
          type="button"
          role="tab"
          class="inf-peek-tab"
          aria-selected="false"
          aria-controls="peek-panel-india"
          data-peek-tab="india"
        >
          <span class="inf-peek-tab__num">02</span>
          <span>India DPDP + RBI FREE-AI Matrix</span>
        </button>
        <button
          type="button"
          role="tab"
          class="inf-peek-tab"
          aria-selected="false"
          aria-controls="peek-panel-rubric"
          data-peek-tab="rubric"
        >
          <span class="inf-peek-tab__num">03</span>
          <span>Consulting Casebook Recruiter Rubric</span>
        </button>
      </div>

      <div class="inf-peek-stage">
        <!-- Artifact 1: Causal Attention & Inference Economics -->
        <article
          id="peek-panel-economics"
          role="tabpanel"
          class="inf-peek-panel"
          data-peek-panel="economics"
        >
          <div class="inf-peek-panel__head">
            <div>
              <span class="inf-peek-kicker">Ch 01, Ch 02 &amp; Ch 19 · Architecture to Unit Economics</span>
              <h3>Matching the right model class and pricing every token before deployment</h3>
            </div>
            <a class="inf-btn inf-btn--secondary inf-btn--sm" href="/inference/read/ai-in-one-sitting/">
              Read Ch 00 Free →
            </a>
          </div>

          <figure class="diagram inf-peek-diagram">
            <svg viewBox="0 0 720 220" role="img" aria-label="Sample diagram from INFERENCE comparing rules, predictive ML, and generative AI">
              <rect x="16" y="18" width="218" height="184" rx="10" fill="var(--paper-2)" stroke="var(--ochre)" stroke-width="1.5" />
              <text x="32" y="46" fill="var(--ochre)" font-family="var(--font)" font-size="13" font-weight="700">Written Rules</text>
              <text x="32" y="72" fill="var(--ink)" font-family="var(--font)" font-size="12" font-weight="600">Fixed statutory logic</text>
              <text x="32" y="94" fill="var(--ink-soft)" font-family="var(--font)" font-size="11">Output: yes / no gate</text>
              <text x="32" y="114" fill="var(--ink-soft)" font-family="var(--font)" font-size="11">Data: policy thresholds</text>
              <text x="32" y="134" fill="var(--ink-soft)" font-family="var(--font)" font-size="11">Audit: line-by-line rule</text>
              <text x="32" y="176" fill="var(--ink-faint)" font-family="var(--font)" font-size="11">Ch 01 · Zero API cost</text>

              <rect x="251" y="18" width="218" height="184" rx="10" fill="var(--paper-2)" stroke="var(--mizu)" stroke-width="1.5" />
              <text x="267" y="46" fill="var(--mizu)" font-family="var(--font)" font-size="13" font-weight="700">Predictive ML</text>
              <text x="267" y="72" fill="var(--ink)" font-family="var(--font)" font-size="12" font-weight="600">Structured rows &amp; labels</text>
              <text x="267" y="94" fill="var(--ink-soft)" font-family="var(--font)" font-size="11">Output: score or forecast</text>
              <text x="267" y="114" fill="var(--ink-soft)" font-family="var(--font)" font-size="11">Data: bureau, POS, churn</text>
              <text x="267" y="134" fill="var(--ink-soft)" font-family="var(--font)" font-size="11">Audit: holdout error &amp; SHAP</text>
              <text x="267" y="176" fill="var(--ink-faint)" font-family="var(--font)" font-size="11">Ch 01 &amp; Ch 22 · Deterministic</text>

              <rect x="486" y="18" width="218" height="184" rx="10" fill="var(--paper-2)" stroke="var(--plum)" stroke-width="1.5" />
              <text x="502" y="46" fill="var(--plum)" font-family="var(--font)" font-size="13" font-weight="700">Generative AI</text>
              <text x="502" y="72" fill="var(--ink)" font-family="var(--font)" font-size="12" font-weight="600">Unstructured text &amp; PDFs</text>
              <text x="502" y="94" fill="var(--ink-soft)" font-family="var(--font)" font-size="11">Output: summary, tag, code</text>
              <text x="502" y="114" fill="var(--ink-soft)" font-family="var(--font)" font-size="11">Data: contracts, calls, logs</text>
              <text x="502" y="134" fill="var(--ink-soft)" font-family="var(--font)" font-size="11">Audit: eval suite + human QA</text>
              <text x="502" y="176" fill="var(--ink-faint)" font-family="var(--font)" font-size="11">Ch 02–07 · Token metered</text>
            </svg>
            <figcaption>
              Exhibit 01 · Tokenised vector figure from INFERENCE (re-skinned automatically for light and dark themes across all 34 figures).
            </figcaption>
          </figure>

          <div class="inf-econ-grid">
            <div class="inf-econ-card">
              <span class="inf-econ-card__k">Indic Tokenizer Tax</span>
              <strong>2.4× – 3.1×</strong>
