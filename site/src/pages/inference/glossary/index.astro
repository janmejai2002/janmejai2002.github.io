---
import Base from '../../../layouts/Base.astro';
import { plateEdge, EDGE_DEPTH } from '../../../lib/bowl';
import { INFERENCE_GLOSSARY, INFERENCE_TRACK_GROUPS } from '../../../data/inference';

const edge = plateEdge('inference-glossary');
const clip = `polygon(0 0, 100% 0, ${[...edge].reverse().map(([x, d]) => `${x.toFixed(1)}% calc(100% - ${d.toFixed(1)}px)`).join(',')})`;
const line = edge.map(([x, d]) => `${(x * 10).toFixed(0)},${(EDGE_DEPTH - d).toFixed(1)}`).join(' ');

const sortedGlossary = [...INFERENCE_GLOSSARY].sort((a, b) => a.term.localeCompare(b.term));

const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const letterCounts = Object.fromEntries(
  ALPHABET.map((letter) => [
    letter,
    sortedGlossary.filter((item) => item.term.trim().charAt(0).toUpperCase() === letter).length,
  ])
);

const trackCounts = Object.fromEntries(
  INFERENCE_TRACK_GROUPS.map((g) => [
    g.id,
    sortedGlossary.filter((item) => item.trackId === g.id).length,
  ])
);

const seenLetters = new Set<string>();
const glossaryEntries = sortedGlossary.map((item) => {
  const letter = item.term.trim().charAt(0).toUpperCase();
  const isFirstOfLetter = !seenLetters.has(letter);
  if (isFirstOfLetter) seenLetters.add(letter);
  return { ...item, letter, isFirstOfLetter };
});
---

<Base
  card="inference-glossary"
  title="AI & Business Glossary (116 Terms) — INFERENCE"
  description="Searchable 116-term glossary of applied AI, inference economics, credit risk, product evals, operations, and Indian AI governance (DPDP, RBI FREE-AI)."
  section="INFERENCE"
  pageType="DefinedTermSet"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'INFERENCE', path: '/inference/' },
    { name: 'Glossary' },
  ]}
  schema={{
    hasDefinedTerm: sortedGlossary.slice(0, 30).map((g) => ({
      '@type': 'DefinedTerm',
      name: g.term,
      description: g.def,
      url: `https://janmejai2002.github.io/inference/glossary/#term-${g.id}`,
    })),
  }}
  immersive={true}
  wide={true}
  grain={true}
>
  <section class="pg-plate" style={`clip-path:${clip}`} aria-labelledby="glossary-title">
    <div class="wrap pg-plate__in">
      <div class="gl-top">
        <span class="hanko-mark">Reference · {sortedGlossary.length} Defined Terms</span>
        <a class="linkish gl-back" href="/inference/">← Back to INFERENCE</a>
      </div>

      <h1 id="glossary-title" class="pg-plate__title">
        The 116-term AI and business glossary.
      </h1>

      <p class="pg-plate__desc">
        Plain-language definitions across inference economics, consulting due diligence, RBI
        FREE-AI, DPDP compliance, product evaluation harnesses, and industrial operations. Every
        term links to its parent INFERENCE unit and carries a direct citation anchor.
      </p>
    </div>
  </section>

  <svg class="pg-edge" viewBox={`0 0 1000 ${EDGE_DEPTH}`} preserveAspectRatio="none" aria-hidden="true">
    <polyline points={line} class="pg-edge__glow" vector-effect="non-scaling-stroke" />
    <polyline points={line} class="pg-edge__gold" vector-effect="non-scaling-stroke" />
  </svg>

  <div class="wrap gl-body">
    <div class="gl-controls">
      <div class="gl-search-wrap">
        <div class="gl-search-box">
          <label for="glossary-search" class="sr">Search glossary terms and definitions</label>
          <svg class="gl-search-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <input
            id="glossary-search"
            class="gl-search"
            type="search"
            placeholder="Search 116 terms (e.g. KV cache, FREE-AI, DPDP, base rate, MMM, Weibull)..."
            autocomplete="off"
          />
          <button type="button" class="gl-clear is-hidden" id="glossary-clear" aria-label="Clear search query">
            Clear
          </button>
          <kbd class="gl-kbd" aria-hidden="true" title="Press / to focus search">/</kbd>
        </div>

        <span class="gl-count" id="glossary-count" aria-live="polite">
          Showing {sortedGlossary.length} of {sortedGlossary.length} terms
        </span>
      </div>

      <div class="gl-az" role="navigation" aria-label="Jump to glossary letter">
        <span class="gl-az__label">Jump A–Z</span>
        <div class="gl-az__list">
          {ALPHABET.map((letter) => {
            const count = letterCounts[letter] ?? 0;
            return (
              <button
                type="button"
                class="gl-az__btn"
                data-az-jump={letter}
                disabled={count === 0}
                aria-label={count > 0 ? `Jump to ${letter} (${count} terms)` : `No terms starting with ${letter}`}
              >
                {letter}
              </button>
            );
          })}
        </div>
      </div>

      <div class="gl-filters" role="group" aria-label="Filter terms by INFERENCE track">
        <button type="button" class="gl-pill is-active" data-track-filter="all" aria-pressed="true">
          All ({sortedGlossary.length})
        </button>
        {INFERENCE_TRACK_GROUPS.filter((g) => (trackCounts[g.id] ?? 0) > 0).map((g) => (
          <button
            type="button"
            class="gl-pill"
            data-track-filter={g.id}
            aria-pressed="false"
            style={`--pill-accent:var(--${g.accent})`}
          >
            <span class="gl-pill__dot" aria-hidden="true"></span>
            {g.label} ({trackCounts[g.id]})
          </button>
        ))}
      </div>
    </div>

    <div class="gl-grid" id="glossary-grid">
      {glossaryEntries.map((item) => (
        <article
          id={item.id}
          class="gl-card"
          data-term={item.term.toLowerCase()}
          data-def={item.def.toLowerCase()}
          data-track={item.trackId}
          data-unit={item.unitTitle.toLowerCase()}
          data-letter={item.letter}
          data-slug={item.id}
          style={`--term-accent:var(--${item.accent})`}
        >
          <span id={`term-${item.id}`} class="gl-card__anchor" aria-hidden="true"></span>
          <div class="gl-card__top">
            <span class="gl-card__track">{item.trackLabel}</span>
            <div class="gl-card__badges">
              <span class="gl-card__unit">{item.unitNumber}</span>
            </div>
          </div>
          <h2>{item.term}</h2>
          <p class="gl-card__def">{item.def}</p>
          <div class="gl-card__foot">
            <div class="gl-card__links">
              {item.isFreeUnit && item.freeSlug ? (
                <a class="linkish" href={`/inference/read/${item.freeSlug}/`}>
                  Free unit: {item.unitTitle} →
                </a>
              ) : (
                <a class="linkish" href={`/inference/?track=${item.trackId}#pricing`}>
                  {item.unitNumber}: {item.unitTitle} →
                </a>
              )}
              {item.blogSlug && (
                <a class="gl-card__blog" href={`/blog/${item.blogSlug}/`}>
                  wAIbi-sabi deep dive
                </a>
              )}
            </div>
            <button
              type="button"
              class="gl-copy"
              data-copy-term={item.id}
              aria-label={`Copy citation link for ${item.term}`}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
              </svg>
              <span class="gl-copy__text">Copy link</span>
            </button>
          </div>
        </article>
      ))}
    </div>

    <div class="gl-empty is-hidden" id="glossary-empty">
      <p>No glossary terms match that query in the selected track.</p>
      <button type="button" class="gl-reset-btn" id="glossary-reset">
        Show all {sortedGlossary.length} terms
      </button>
    </div>
  </div>
</Base>

<script>
  const input = document.getElementById('glossary-search') as HTMLInputElement | null;
  const clearBtn = document.getElementById('glossary-clear') as HTMLButtonElement | null;
  const resetBtn = document.getElementById('glossary-reset') as HTMLButtonElement | null;
  const countEl = document.getElementById('glossary-count');
  const emptyEl = document.getElementById('glossary-empty');
  const grid = document.getElementById('glossary-grid');
  const cards = [...document.querySelectorAll<HTMLElement>('.gl-card')];
  const pills = [...document.querySelectorAll<HTMLButtonElement>('[data-track-filter]')];
  const azButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-az-jump]')];
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let activeTrack = 'all';

  function updateAzAvailability() {
    const visibleLetters = new Set<string>();
    for (const c of cards) {
      if (!c.classList.contains('is-hidden') && c.dataset.letter) {
        visibleLetters.add(c.dataset.letter);
      }
    }
    for (const btn of azButtons) {
      const letter = btn.dataset.azJump || '';
      const hasMatch = visibleLetters.has(letter);
      btn.disabled = !hasMatch;
      btn.classList.remove('is-current');
    }
  }

  function applyFilter() {
    const q = (input?.value || '').trim().toLowerCase();
    clearBtn?.classList.toggle('is-hidden', q.length === 0);

    let visible = 0;
    for (const c of cards) {
      const matchTrack = activeTrack === 'all' || c.dataset.track === activeTrack;
      const matchQuery =
        !q ||
        (c.dataset.term || '').includes(q) ||
        (c.dataset.def || '').includes(q) ||
        (c.dataset.unit || '').includes(q);
      const show = matchTrack && matchQuery;
      c.classList.toggle('is-hidden', !show);
      if (show) visible += 1;
    }

    if (countEl) {
      countEl.textContent =
        visible === cards.length
          ? `Showing ${visible} of ${cards.length} terms`
          : `Showing ${visible} of ${cards.length} matching terms`;
    }
    emptyEl?.classList.toggle('is-hidden', visible > 0);
    updateAzAvailability();
  }

  function setTrack(trackId: string) {
    activeTrack = trackId;
    for (const b of pills) {
      const on = (b.dataset.trackFilter || 'all') === trackId;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    }
    applyFilter();
  }

  input?.addEventListener('input', applyFilter);

  clearBtn?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    applyFilter();
    input.focus();
  });

  resetBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    setTrack('all');
    input?.focus();
  });

  for (const p of pills) {
    p.addEventListener('click', () => {
      setTrack(p.dataset.trackFilter || 'all');
    });
  }

  // Keyboard `/` shortcut to focus search, `Escape` to clear/blur
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !e.ctrlKey && !e.metaKey && !e.altKey) {
      const active = document.activeElement as HTMLElement | null;
      const tag = active?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || active?.isContentEditable) {
        return;
      }
      e.preventDefault();
      input?.focus();
      input?.select();
    } else if (e.key === 'Escape' && document.activeElement === input && input) {
      if (input.value) {
        input.value = '';
        applyFilter();
      } else {
        input.blur();
      }
    }
  });

  // A–Z quick-jump ribbon
  function highlightCard(card: HTMLElement) {
    for (const c of cards) c.classList.remove('is-targeted');
    card.classList.add('is-targeted');
    window.setTimeout(() => card.classList.remove('is-targeted'), 2200);
  }

  for (const btn of azButtons) {
    btn.addEventListener('click', () => {
      const letter = btn.dataset.azJump || '';
      const target = cards.find(
        (c) => !c.classList.contains('is-hidden') && c.dataset.letter === letter
      );
      if (!target) return;
      for (const b of azButtons) b.classList.toggle('is-current', b === btn);
      target.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
      highlightCard(target);
    });
  }

  // Pointer-spotlight hover borders via single delegated listener
  if (
    grid &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !prefersReduced
  ) {
    grid.addEventListener('pointermove', (e) => {
      const card = (e.target as HTMLElement | null)?.closest<HTMLElement>('.gl-card');
      if (!card) return;
      const rect = card.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty('--mx', `${x.toFixed(1)}%`);
      card.style.setProperty('--my', `${y.toFixed(1)}%`);
    });
  }

  // 1-click Copy link per glossary term (#term-<slug>)
  async function copyText(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {}
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    } catch {
      return false;
    }
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-term]')) {
    btn.addEventListener('click', async () => {
      const slug = btn.dataset.copyTerm || '';
      if (!slug) return;
      const hash = `#term-${slug}`;
      const shareUrl = `${location.origin}${location.pathname}${hash}`;
      const ok = await copyText(shareUrl);

      if (ok) {
        try {
          history.replaceState(null, '', hash);
        } catch {}
        const label = btn.querySelector('.gl-copy__text');
        if (label) label.textContent = 'Copied';
        btn.classList.add('is-copied');
        window.setTimeout(() => {
          if (label) label.textContent = 'Copy link';
          btn.classList.remove('is-copied');
        }, 1800);
      }

      const w = window as unknown as {
        umami?: { track?: (name: string, data: Record<string, string>) => void };
      };
      w.umami?.track?.('inference_glossary_copy', { term: slug });
    });
  }

  // Handle direct deep links to #term-<slug> or #<slug>
  function syncTargetFromHash() {
    const raw = location.hash.replace(/^#/, '');
    if (!raw) return;
    const slug = raw.startsWith('term-') ? raw.slice(5) : raw;
    const card = cards.find((c) => c.dataset.slug === slug);
    if (!card) return;
    if (card.classList.contains('is-hidden')) {
      if (input) input.value = '';
      setTrack('all');
    }
    card.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
    highlightCard(card);
  }

  syncTargetFromHash();
  window.addEventListener('hashchange', syncTargetFromHash);
</script>

<style>
  .pg-plate {
    position: relative;
    color: var(--tldr-ink);
    background:
      radial-gradient(50rem 26rem at 88% 10%, color-mix(in srgb, var(--indigo) 16%, transparent), transparent 70%),
      radial-gradient(42rem 22rem at 6% 110%, color-mix(in srgb, var(--ochre) 14%, transparent), transparent 70%),
      var(--tldr-bg);
    overflow: hidden;
  }
  .pg-plate::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--paper-noise);
    opacity: 0.7;
    pointer-events: none;
  }
  .pg-plate__in {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.25rem, 4vw, 3.5rem) calc(22px + clamp(2rem, 3vw, 2.75rem));
  }
  .gl-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: .75rem 1.25rem;
    margin-bottom: 1.15rem;
  }
  .hanko-mark {
    display: inline-flex;
    align-items: center;
    font-family: var(--font);
    font-size: .6875rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--hanko);
    background: color-mix(in srgb, var(--hanko) 14%, transparent);
    border: 1.25px solid color-mix(in srgb, var(--hanko) 65%, transparent);
    padding: .24rem .65rem;
    border-radius: 4px;
  }
  .gl-back {
    color: var(--tldr-dim);
    font-size: .9375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .gl-back:hover {
    color: var(--tldr-ink);
  }
  .pg-plate__title {
    margin: 0;
    max-width: 52rem;
    font-family: var(--font);
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.07;
    letter-spacing: -.03em;
    color: var(--tldr-ink);
  }
  .pg-plate__desc {
    margin: 1rem 0 0;
    max-width: 46rem;
    font-size: 1.0625rem;
    line-height: 1.62;
    color: var(--tldr-dim);
  }

  .pg-edge {
    display: block;
    position: relative;
    width: 100%;
    height: 22px;
    margin-top: -22px;
    overflow: visible;
    pointer-events: none;
  }
  .pg-edge__glow {
    fill: none;
    stroke: color-mix(in srgb, var(--ochre) 40%, transparent);
    stroke-width: 4;
    filter: blur(1.5px);
  }
  .pg-edge__gold {
    fill: none;
    stroke: var(--ochre);
    stroke-width: 1.75;
    stroke-linejoin: miter;
  }

  .gl-body {
    padding-top: clamp(2rem, 3.8vw, 3rem);
    padding-bottom: 4.5rem;
  }
  .gl-controls {
    display: grid;
    gap: .95rem;
    margin-bottom: 1.75rem;
    padding: 1.1rem 1.2rem;
    background: var(--paper-2);
    border: 1px solid var(--border);
    border-radius: 16px;
  }
  .gl-search-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .75rem 1.25rem;
  }
  .gl-search-box {
    position: relative;
    flex: 1 1 20rem;
    display: flex;
    align-items: center;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding-inline: .85rem;
    min-height: 46px;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .gl-search-box:focus-within {
    border-color: var(--mizu);
  }
  .gl-search-icon {
    color: var(--ink-faint);
    flex-shrink: 0;
  }
  .gl-search {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: .6rem .65rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font);
    font-size: .9375rem;
  }
  .gl-search:focus {
    outline: none;
  }
  .gl-clear {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--paper);
    color: var(--ink-soft);
    font-family: var(--font);
    font-size: .8125rem;
    font-weight: 600;
    min-height: 32px;
    padding: .2rem .55rem;
    border-radius: 6px;
    cursor: pointer;
    margin-right: .4rem;
  }
  .gl-clear.is-hidden {
    display: none;
  }
  .gl-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.65rem;
    height: 1.65rem;
    padding: 0 .35rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--paper);
    color: var(--ink-faint);
    font-family: monospace;
    font-size: .8125rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .gl-count {
    font-size: .875rem;
    font-weight: 700;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* A-Z quick-jump ribbon */
  .gl-az {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem .8rem;
    padding-block: .25rem;
  }
  .gl-az__label {
    font-size: .8125rem;
    font-weight: 700;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .gl-az__list {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem;
    max-width: 100%;
  }
  .gl-az__btn {
    appearance: none;
    min-width: 2rem;
    min-height: 34px;
    padding: .2rem .42rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--ink);
    font-family: var(--font);
    font-size: .8125rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .gl-az__btn:hover:not(:disabled) {
    border-color: var(--ochre);
    color: var(--ochre);
  }
  .gl-az__btn.is-current {
    background: var(--solid);
    color: var(--on-solid);
    border-color: var(--solid);
  }
  .gl-az__btn:disabled {
    opacity: .35;
    cursor: default;
  }
  @media (pointer: coarse) {
    .gl-az__btn {
      min-width: 44px;
      min-height: 44px;
    }
  }

  .gl-filters {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
  }
  .gl-pill {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-height: 44px;
    padding: .4rem .85rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--ink-soft);
    font-family: var(--font);
    font-size: .8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .gl-pill:hover {
    color: var(--ink);
    border-color: var(--pill-accent, var(--ochre));
  }
  .gl-pill.is-active {
    background: var(--solid);
    color: var(--on-solid);
    border-color: var(--solid);
  }
  .gl-pill__dot {
    width: 7px;
    height: 7px;
