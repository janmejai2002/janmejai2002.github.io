---
import Base from '../../../layouts/Base.astro';
import { plateEdge, EDGE_DEPTH } from '../../../lib/bowl';
import {
  INFERENCE_CAMPUS_TIERS,
  INFERENCE_TRACK_GROUPS,
  INFERENCE_UNITS,
  INFERENCE_CHECKOUT,
} from '../../../data/inference';

const edge = plateEdge('inference-campus');
const clip = `polygon(0 0, 100% 0, ${[...edge].reverse().map(([x, d]) => `${x.toFixed(1)}% calc(100% - ${d.toFixed(1)}px)`).join(',')})`;
const line = edge.map(([x, d]) => `${(x * 10).toFixed(0)},${(EDGE_DEPTH - d).toFixed(1)}`).join(' ');
---

<Base
  card="inference-campus"
  title="INFERENCE Campus & PlaceCom Bulk Licensing — wAIbi-sabi"
  description="Institutional and club bulk seat licensing for B-school placement committees, consulting clubs, and product cohorts. 50-seat and 200-seat packs."
  section="INFERENCE"
  pageType="WebPage"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'INFERENCE', path: '/inference/' },
    { name: 'Campus licensing' },
  ]}
  immersive={true}
  wide={true}
  grain={true}
>
  <section class="pg-plate" style={`clip-path:${clip}`} aria-labelledby="campus-title">
    <div class="wrap pg-plate__in">
      <div class="campus-top">
        <span class="hanko-mark">Campus &amp; PlaceCom Licensing</span>
        <a class="linkish campus-back" href="/inference/">← Back to INFERENCE Edition</a>
      </div>

      <h1 id="campus-title" class="pg-plate__title">
        Equip your entire placement cohort with one institutional license.
      </h1>

      <p class="pg-plate__desc">
        Built for Indian and global B-school placement committees, Consulting &amp; ProdMan clubs,
        and corporate analyst cohorts. Single invoice, coordinator seat distribution, custom club
        stamp, and optional live case workshop.
      </p>

      <div class="campus-actions">
        <a
          class="inf-btn inf-btn--primary"
          href="#cohort-calculator"
        >
          Configure cohort &amp; ROI
        </a>
        <a
          class="inf-btn inf-btn--ghost"
          href={INFERENCE_CHECKOUT.campusInquiry.fiftySeats}
          data-campus-sku="campus-50"
        >
          Request 50-seat pack (₹45,000)
        </a>
        <a
          class="inf-btn inf-btn--ghost"
          href={INFERENCE_CHECKOUT.campusInquiry.twoHundredSeats}
          data-campus-sku="campus-200"
        >
          Request 200-seat batch (₹1,40,000)
        </a>
      </div>
    </div>
  </section>

  <svg class="pg-edge" viewBox={`0 0 1000 ${EDGE_DEPTH}`} preserveAspectRatio="none" aria-hidden="true">
    <polyline points={line} class="pg-edge__glow" vector-effect="non-scaling-stroke" />
    <polyline points={line} class="pg-edge__gold" vector-effect="non-scaling-stroke" />
  </svg>

  <div class="wrap campus-body">
    <!-- Interactive Live Campus Cohort & ROI Calculator -->
    <section class="campus-sec" id="cohort-calculator" aria-labelledby="calc-heading">
      <p class="campus-kicker">Interactive cohort configurator</p>
      <h2 id="calc-heading">Live Campus Cohort &amp; ROI Calculator</h2>

      <div class="calc-shell">
        <div class="calc-controls">
          <div class="calc-head">
            <div>
              <label for="campus-seats-slider" class="calc-label">Cohort size (seats)</label>
              <p class="calc-sub">Slide from 30 to 600 seats to compute volume rate, B2C savings, and founder AMA eligibility.</p>
            </div>
            <div class="calc-seat-readout">
              <strong id="calc-seats-value">200</strong>
              <span>seats</span>
            </div>
          </div>

          <div class="calc-slider-wrap">
            <input
              id="campus-seats-slider"
              class="calc-slider"
              type="range"
              min="30"
              max="600"
              step="5"
              value="200"
              aria-describedby="calc-tier-note"
            />
            <div class="calc-ticks" aria-hidden="true">
              <span>30</span>
              <span>150 (AMA threshold)</span>
              <span>300</span>
              <span>600</span>
            </div>
          </div>

          <div class="calc-presets" role="group" aria-label="Preset cohort sizes">
            <button type="button" class="calc-preset" data-preset-seats="50">50 · Club Pack</button>
            <button type="button" class="calc-preset" data-preset-seats="150">150 · Full Batch + AMA</button>
            <button type="button" class="calc-preset is-active" data-preset-seats="200">200 · Standard Batch</button>
            <button type="button" class="calc-preset" data-preset-seats="400">400 · Full PGP</button>
          </div>

          <div class="calc-org-row">
            <label for="calc-org-input" class="calc-org-label">Club or PlaceCom name (optional, customises proposal)</label>
            <input
              id="calc-org-input"
              class="calc-org-input"
              type="text"
              placeholder="e.g. Consulting Club / Academic Committee"
              maxlength="80"
              autocomplete="organization"
            />
          </div>

          <div class="calc-compare" aria-label="Institutional price versus individual B2C comparison">
            <div class="calc-compare__head">
              <span>Institutional cohort cost vs individual B2C (₹1,999/student)</span>
              <strong id="calc-discount-pct">65% lower</strong>
            </div>
            <div class="calc-bar-track">
              <div class="calc-bar-fill" id="calc-bar-fill" style="--fill-pct:35%"></div>
            </div>
            <div class="calc-compare__foot">
              <span>Institutional total: <strong id="calc-compare-inst">₹1,40,000</strong></span>
              <span>B2C equivalent: <strong id="calc-compare-b2c">₹3,99,800</strong></span>
            </div>
          </div>
        </div>

        <div class="calc-summary">
          <div class="calc-tier-banner">
            <span class="calc-tier-pill" id="calc-tier-badge">Full Batch</span>
            <span class="calc-tier-note" id="calc-tier-note">Volume batch licensing for PlaceCom cohorts</span>
          </div>

          <dl class="calc-metrics">
            <div class="calc-metric">
              <dt>Per-seat rate</dt>
              <dd id="calc-per-seat">₹700</dd>
            </div>
            <div class="calc-metric">
              <dt>Total investment</dt>
              <dd id="calc-total">₹1,40,000</dd>
            </div>
            <div class="calc-metric calc-metric--accent">
              <dt>Savings vs B2C (₹1,999/seat)</dt>
              <dd id="calc-savings">₹2,59,800</dd>
            </div>
            <div class="calc-metric">
              <dt>Live 90-min Founder AI/Case AMA</dt>
              <dd id="calc-ama-status" class="is-included">Included (150+ seats)</dd>
            </div>
          </dl>

          <div class="calc-actions">
            <button type="button" class="inf-btn inf-btn--primary calc-copy-btn" id="calc-copy-proposal">
              Copy PlaceCom Proposal Summary
            </button>
            <a
              class="inf-btn inf-btn--secondary calc-mail-btn"
              id="calc-mail-cta"
              href={INFERENCE_CHECKOUT.campusInquiry.twoHundredSeats}
            >
              Email invoice request →
            </a>
          </div>

          <p class="calc-copy-status" id="calc-copy-status" aria-live="polite">
            Copies a clean, ready-to-paste WhatsApp or email brief for your Placement Committee.
          </p>

          <details class="calc-preview-details">
            <summary>Inspect generated proposal text</summary>
            <pre class="calc-preview-pre" id="calc-proposal-preview"></pre>
          </details>
        </div>
      </div>
    </section>

    <section class="campus-sec" aria-labelledby="campus-tiers-heading">
      <p class="campus-kicker">Cohort pricing</p>
      <h2 id="campus-tiers-heading">Institutional &amp; student club packs</h2>

      <div class="campus-grid">
        {INFERENCE_CAMPUS_TIERS.map((tier) => (
          <article class:list={['campus-card', tier.highlighted && 'campus-card--hero']}>
            <span class="campus-card__badge">{tier.badge}</span>
            <h3>{tier.name}</h3>
            <div class="campus-card__price">
              <strong>{tier.priceInr}</strong>
              <span>{tier.perSeatInr} · Global: {tier.priceUsd}</span>
            </div>
            <ul>
              {tier.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <a
              href={tier.ctaHref}
              class:list={['inf-btn', tier.highlighted ? 'inf-btn--primary' : 'inf-btn--secondary', 'campus-card__cta']}
              data-campus-sku={tier.id}
            >
              {tier.ctaLabel}
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="campus-sec" aria-labelledby="campus-syllabus-heading">
      <p class="campus-kicker">Included syllabus packet</p>
      <h2 id="campus-syllabus-heading">All 36 units across 7 placement domains</h2>
      <p class="campus-lead">
        Every seat receives all 36 units (150,033 words, 34 vector diagrams, 178 primary sources)
        plus both quarterly India and Global model inserts. Preview five full units immediately in
        the <a class="linkish" href="/inference/read/">Free Edition hub</a>.
      </p>

      <div class="campus-tracks">
        {INFERENCE_TRACK_GROUPS.map((g) => {
          const list = INFERENCE_UNITS.filter((u) => u.trackId === g.id);
          return (
            <article class="campus-track" style={`--track-accent:var(--${g.accent})`}>
              <div class="campus-track__head">
                <h3>{g.label}</h3>
                <span>{list.length} units</span>
              </div>
              <p>{g.summary}</p>
            </article>
          );
        })}
      </div>
    </section>

    <section class="campus-sec campus-contact" aria-labelledby="campus-contact-heading">
      <h2 id="campus-contact-heading">Direct coordinator rollout</h2>
      <p>
        Send your club name, batch size, and preferred delivery date to{' '}
        <a href={`mailto:${INFERENCE_CHECKOUT.contactEmail}`}>{INFERENCE_CHECKOUT.contactEmail}</a>.
        We issue a consolidated invoice, a single PlaceCom license-key sheet, and watermarked A4
        copies within 24 hours of confirmation.
      </p>
    </section>
  </div>
</Base>

<script>
  const slider = document.getElementById('campus-seats-slider') as HTMLInputElement | null;
  const orgInput = document.getElementById('calc-org-input') as HTMLInputElement | null;
  const seatsValEl = document.getElementById('calc-seats-value');
  const tierBadgeEl = document.getElementById('calc-tier-badge');
  const tierNoteEl = document.getElementById('calc-tier-note');
  const perSeatEl = document.getElementById('calc-per-seat');
  const totalEl = document.getElementById('calc-total');
  const savingsEl = document.getElementById('calc-savings');
  const amaEl = document.getElementById('calc-ama-status');
  const discountPctEl = document.getElementById('calc-discount-pct');
  const barFillEl = document.getElementById('calc-bar-fill');
  const compareInstEl = document.getElementById('calc-compare-inst');
  const compareB2cEl = document.getElementById('calc-compare-b2c');
  const copyBtn = document.getElementById('calc-copy-proposal') as HTMLButtonElement | null;
  const copyStatusEl = document.getElementById('calc-copy-status');
  const mailCtaEl = document.getElementById('calc-mail-cta') as HTMLAnchorElement | null;
  const previewEl = document.getElementById('calc-proposal-preview');
  const presetBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-preset-seats]')];

  const B2C_PRICE = 1999;
  const fmtInr = new Intl.NumberFormat('en-IN');
  const money = (n: number) => `₹${fmtInr.format(n)}`;

  interface CohortQuote {
    seats: number;
    tier: 'Club Pack' | 'Full Batch';
    tierNote: string;
    perSeat: number;
    total: number;
    b2cTotal: number;
    savings: number;
    discountPct: number;
    amaIncluded: boolean;
  }

  function calculateQuote(seats: number): CohortQuote {
    const clamped = Math.min(600, Math.max(30, Math.round(seats)));
    const isFullBatch = clamped >= 150;
    const tier: CohortQuote['tier'] = isFullBatch ? 'Full Batch' : 'Club Pack';

    let perSeat = 900;
    let tierNote = 'Section and club licensing (30–149 seats)';
    if (clamped >= 250) {
      perSeat = 650;
      tierNote = 'Volume Full Batch rate (250–600 seats)';
    } else if (clamped >= 150) {
      perSeat = 700;
      tierNote = 'Full Batch licensing with live founder AMA';
    } else if (clamped >= 100) {
      perSeat = 800;
      tierNote = 'Multi-section Club Pack (100–149 seats)';
    }

    const total = clamped * perSeat;
    const b2cTotal = clamped * B2C_PRICE;
    const savings = b2cTotal - total;
    const discountPct = Math.round(((B2C_PRICE - perSeat) / B2C_PRICE) * 100);
    const amaIncluded = clamped >= 150;

    return {
      seats: clamped,
      tier,
      tierNote,
      perSeat,
      total,
      b2cTotal,
      savings,
      discountPct,
      amaIncluded,
    };
  }

  function buildProposalText(q: CohortQuote, orgName: string): string {
    const org = orgName.trim() || 'our campus cohort';
    const amaLine = q.amaIncluded
      ? 'Included — Live 90-min Founder AI & Case AMA workshop (included at 150+ seats)'
      : 'Optional add-on below 150 seats (included at no extra fee from 150 seats upward)';

    return [
      `INFERENCE (2027 Edition) — Campus Cohort Proposal for ${org}`,
      '',
      `Cohort Size: ${q.seats} student seats`,
      `Licensing Tier: ${q.tier}`,
      `Institutional Rate: ${money(q.perSeat)} per seat (vs ${money(B2C_PRICE)} individual B2C)`,
      `Total Investment: ${money(q.total)} (consolidated institutional invoice)`,
      `Total Cohort Savings: ${money(q.savings)} (${q.discountPct}% below individual pricing)`,
      `Live 90-min Founder AI/Case AMA: ${amaLine}`,
      '',
      'Included per seat:',
      '- All 36 units (150,033 words across Foundations, Consulting, Finance, Product, Marketing, Ops, HR)',
      '- 116-term AI & business glossary + 34 vector diagrams + 178 verified primary sources',
      '- 1 year of quarterly Insert A (Model Landscape) & Insert B (India Policy) updates',
      '- Custom club/PlaceCom cover stamp + coordinator redemption sheet within 24 hours',
      '',
      'Next step: Confirm batch size at janmejai2002@gmail.com or inspect details at https://janmejai2002.github.io/inference/campus/',
    ].join('\n');
  }

  let latestQuote = calculateQuote(Number(slider?.value || 200));

  function renderQuote() {
    const seats = Number(slider?.value || 200);
    const q = calculateQuote(seats);
    latestQuote = q;

    if (seatsValEl) seatsValEl.textContent = String(q.seats);
    if (tierBadgeEl) {
      tierBadgeEl.textContent = q.tier;
      tierBadgeEl.classList.toggle('is-batch', q.tier === 'Full Batch');
    }
    if (tierNoteEl) tierNoteEl.textContent = q.tierNote;
    if (perSeatEl) perSeatEl.textContent = money(q.perSeat);
    if (totalEl) totalEl.textContent = money(q.total);
    if (savingsEl) savingsEl.textContent = money(q.savings);

    if (amaEl) {
      amaEl.textContent = q.amaIncluded
        ? 'Included (90-min live AMA)'
        : 'Not included (150+ seats)';
      amaEl.classList.toggle('is-included', q.amaIncluded);
    }

    if (discountPctEl) discountPctEl.textContent = `${q.discountPct}% lower`;
    if (compareInstEl) compareInstEl.textContent = money(q.total);
    if (compareB2cEl) compareB2cEl.textContent = money(q.b2cTotal);
    if (barFillEl) {
      const pct = Math.round((q.total / q.b2cTotal) * 100);
      barFillEl.style.setProperty('--fill-pct', `${pct}%`);
    }

    for (const btn of presetBtns) {
      const active = Number(btn.dataset.presetSeats) === q.seats;
      btn.classList.toggle('is-active', active);
    }

    const org = orgInput?.value || '';
    const proposal = buildProposalText(q, org);
    if (previewEl) previewEl.textContent = proposal;

    if (mailCtaEl) {
      const subject = `INFERENCE Campus ${q.tier} — ${q.seats} Seats (${money(q.total)})`;
      mailCtaEl.href = `mailto:janmejai2002@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(proposal)}`;
    }
  }

  slider?.addEventListener('input', renderQuote);
  orgInput?.addEventListener('input', renderQuote);

  for (const btn of presetBtns) {
    btn.addEventListener('click', () => {
      if (!slider) return;
      slider.value = btn.dataset.presetSeats || '200';
      renderQuote();
    });
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {}
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    } catch {
      return false;
    }
  }

  copyBtn?.addEventListener('click', async () => {
    const proposal = buildProposalText(latestQuote, orgInput?.value || '');
    const ok = await copyText(proposal);
    if (ok && copyBtn) {
      const original = 'Copy PlaceCom Proposal Summary';
      copyBtn.textContent = 'Copied PlaceCom Proposal';
      copyBtn.classList.add('is-copied');
      if (copyStatusEl) {
        copyStatusEl.textContent = `Copied ${latestQuote.seats}-seat ${latestQuote.tier} proposal (${money(latestQuote.total)}) to clipboard.`;
      }
      window.setTimeout(() => {
        copyBtn.textContent = original;
        copyBtn.classList.remove('is-copied');
      }, 2200);
    }
    const w = window as unknown as {
      umami?: { track?: (name: string, data: Record<string, string>) => void };
    };
    w.umami?.track?.('inference_campus_calc_copy', {
      seats: String(latestQuote.seats),
      tier: latestQuote.tier,
    });
  });

  renderQuote();

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-campus-sku]')) {
    link.addEventListener('click', () => {
      const sku = link.dataset.campusSku || 'campus-bulk';
      const w = window as unknown as { umami?: { track?: (name: string, data: Record<string, string>) => void } };
      w.umami?.track?.('inference_cta', { sku, currency: 'INR' });
    });
  }
</script>

<style>
  .pg-plate {
    position: relative;
    color: var(--tldr-ink);
    background:
      radial-gradient(50rem 26rem at 88% 10%, color-mix(in srgb, var(--ochre) 16%, transparent), transparent 70%),
      radial-gradient(42rem 22rem at 6% 110%, color-mix(in srgb, var(--moss) 14%, transparent), transparent 70%),
      var(--tldr-bg);
    overflow: hidden;
  }
  .pg-plate::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--paper-noise);
    opacity: 0.7;
    pointer-events: none;
  }
  .pg-plate__in {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.25rem, 4vw, 3.5rem) calc(22px + clamp(2rem, 3vw, 2.75rem));
  }
  .campus-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: .75rem 1.25rem;
    margin-bottom: 1.15rem;
  }
  .hanko-mark {
    display: inline-flex;
    align-items: center;
    font-family: var(--font);
    font-size: .6875rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--hanko);
    background: color-mix(in srgb, var(--hanko) 14%, transparent);
    border: 1.25px solid color-mix(in srgb, var(--hanko) 65%, transparent);
    padding: .24rem .65rem;
    border-radius: 4px;
  }
  .campus-back {
    color: var(--tldr-dim);
    font-size: .9375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .campus-back:hover {
    color: var(--tldr-ink);
  }
  .pg-plate__title {
    margin: 0;
    max-width: 54rem;
    font-family: var(--font);
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.07;
    letter-spacing: -.03em;
    color: var(--tldr-ink);
  }
  .pg-plate__desc {
    margin: 1rem 0 0;
    max-width: 44rem;
    font-size: 1.0625rem;
    line-height: 1.62;
    color: var(--tldr-dim);
  }
  .campus-actions {
    margin-top: 1.65rem;
    display: flex;
    flex-wrap: wrap;
    gap: .85rem;
  }
  .inf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: .7rem 1.35rem;
    border-radius: 10px;
    font-family: var(--font);
    font-size: .9375rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
    transition: transform var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .inf-btn:hover {
    transform: translateY(-1px);
  }
  .inf-btn--primary {
    background: var(--ochre);
    color: var(--tldr-bg);
    border-color: var(--ochre);
  }
  .inf-btn--ghost {
    background: transparent;
    color: var(--tldr-ink);
    border-color: var(--tldr-hair);
  }
  .inf-btn--ghost:hover {
    border-color: var(--tldr-ink);
  }
  .inf-btn--secondary {
    background: var(--solid);
    color: var(--on-solid);
    border-color: var(--border);
  }

  .pg-edge {
    display: block;
    position: relative;
    width: 100%;
    height: 22px;
    margin-top: -22px;
    overflow: visible;
    pointer-events: none;
  }
  .pg-edge__glow {
    fill: none;
    stroke: color-mix(in srgb, var(--ochre) 40%, transparent);
    stroke-width: 4;
    filter: blur(1.5px);
  }
  .pg-edge__gold {
    fill: none;
    stroke: var(--ochre);
    stroke-width: 1.75;
    stroke-linejoin: miter;
  }

  .campus-body {
    padding-top: clamp(2.25rem, 4vw, 3.5rem);
    padding-bottom: 4.5rem;
  }
  .campus-sec {
    margin-top: 3.5rem;
  }
  .campus-sec:first-child {
    margin-top: 0;
  }
  .campus-kicker {
    margin: 0 0 .35rem;
    font-size: .8125rem;
    font-weight: 700;
    color: var(--ochre);
  }
  .campus-sec h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -.02em;
  }
  .campus-lead {
    margin: 0 0 1.5rem;
    max-width: 48rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* Live Cohort & ROI Calculator */
  .calc-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 1.25rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-top: 3px solid var(--ochre);
    border-radius: 18px;
    padding: clamp(1.2rem, 2.5vw, 1.8rem);
  }
  .calc-controls {
    display: grid;
    gap: 1.15rem;
    align-content: start;
  }
