---
import Base from '../../layouts/Base.astro';
import news from '../../data/news.json';

type Item = {
  headline: string;
  date: string;
  category: string;
  summary: string;
  angle: string;
  source: string | null;
};

const items = (news as Item[]).slice().sort((a, b) => b.date.localeCompare(a.date));
const categories = [...new Set(items.map((i) => i.category))].sort();
const counts = Object.fromEntries(
  categories.map((c) => [c, items.filter((i) => i.category === c).length])
);

// Each function gets one of the six earths.
const accentOf: Record<string, string> = {
  Finance: 'moss',
  Marketing: 'indigo',
  Operations: 'ochre',
  'Product Management': 'plum',
  Consulting: 'hanko',
};
const accent = (c: string) => accentOf[c] ?? 'mizu';

const latest = items[0]?.date;
const oldest = items.at(-1)?.date;

const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });

const fmtLong = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('en-IN', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

const host = (url: string | null) => {
  if (!url) return null;
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return null;
  }
};

const byDate = items.reduce<Record<string, Item[]>>((acc, i) => {
  (acc[i.date] ??= []).push(i);
  return acc;
}, {});
const dates = Object.keys(byDate).sort((a, b) => b.localeCompare(a));
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Base
  title="Interview News Archive — Wabi Sabi"
  description={`A daily business-news digest for Indian B-school interview prep. ${items.length} stories across Finance, Marketing, Operations, Product Management and Consulting, each with the angle an interviewer would push on.`}
  section="Archive"
  keywords={[
    'MBA interview preparation',
    'business news for B-school interviews',
    'current affairs for MBA placements',
    'WAT GD PI topics India',
  ]}
>
  <section class="hero fade-up d1" style="padding-bottom:1.75rem">
    <span class="hanko">Archive</span>
    <h1>Interview <span class="hl hl--ochre">News Archive</span></h1>
    <p>
      A daily business-news digest for Indian B-school placement prep. Every card carries the
      story — and, more usefully, the angle an interviewer is likely to push on.
    </p>
    <p class="meta" style="margin-top:1.25rem">
      {items.length} entries · {oldest && fmtLong(oldest).split(',')[1]} — {latest && fmtLong(latest).split(',')[1]}
    </p>
  </section>

  <div class="controls fade-up d2" role="region" aria-label="Filter and sort">
    <div class="chips" role="group" aria-label="Filter by function">
      <button class="chip is-on" data-cat="all" aria-pressed="true">
        All <span class="chip__n">{items.length}</span>
      </button>
      {
        categories.map((c) => (
          <button
            class="chip"
            data-cat={c}
            aria-pressed="false"
            style={`--accent:var(--${accent(c)});--tint:var(--wash-${accent(c)})`}
          >
            {c} <span class="chip__n">{counts[c]}</span>
          </button>
        ))
      }
    </div>

    <div class="controls__row">
      <label class="field">
        <span class="sr-only">Search headlines, summaries and angles</span>
        <svg class="field__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" />
        </svg>
        <input type="search" id="q" placeholder="Search the archive…" autocomplete="off" />
      </label>

      <label class="field field--sort">
        <span class="sr-only">Sort by</span>
        <select id="sort">
          <option value="new">Newest first</option>
          <option value="old">Oldest first</option>
          <option value="cat">Group by function</option>
          <option value="az">Headline A–Z</option>
        </select>
      </label>
    </div>

    <p class="tally" id="tally" aria-live="polite"></p>
  </div>

  <div id="archive">
    {
      dates.map((d) => (
        <section class="day" data-date={d} style={`--n:${byDate[d].length}`}>
          <h2 class="day__label">
            <span class="day__dot" aria-hidden="true" />
            <time datetime={d}>{fmtLong(d)}</time>
            <span class="day__rule" aria-hidden="true" />
            <span class="day__n">{byDate[d].length}</span>
          </h2>

          <div class="cards">
            {byDate[d].map((i) => (
              <article
                class="card"
                data-cat={i.category}
                data-date={i.date}
                data-headline={i.headline.toLowerCase()}
                data-text={`${i.headline} ${i.summary} ${i.angle}`.toLowerCase()}
                style={`--accent:var(--${accent(i.category)});--tint:var(--wash-${accent(i.category)})`}
              >
                <div class="card__top">
                  <span class="tag">
                    <span class="tag__dot" aria-hidden="true" />
                    {i.category}
                  </span>
                  <time class="card__date" datetime={i.date}>{fmt(i.date)}</time>
                </div>

                <h3 class="card__h">{i.headline}</h3>
                <p class="card__sum">{i.summary}</p>

                <div class="card__angle">
                  <span class="card__angle-k">Interview angle</span>
                  <p>{i.angle}</p>
                </div>

                {i.source && (
                  <a class="card__src" href={i.source} target="_blank" rel="noopener noreferrer">
                    <span>{host(i.source)}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17L17 7M17 7H8M17 7v9" />
                    </svg>
                  </a>
                )}
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <p class="noresults" id="noresults" hidden>
    Nothing matches that. <button type="button" id="reset">Clear filters</button>
  </p>
</Base>

<style>
  /* ---------- Controls ---------- */
  .controls {
    position: sticky; top: var(--nav-h, 3.35rem); z-index: 30;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: .9rem 0 .8rem; margin-bottom: 2.5rem;
  }

  .chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .8rem; }

  .chip {
    font: inherit; font-size: .625rem; font-weight: 800; letter-spacing: .09em;
    text-transform: uppercase; padding: .38rem .75rem; border-radius: 999px;
    border: 1.5px solid var(--border); background: transparent; color: var(--ink-soft);
    cursor: pointer;
    /* Was `all`, which animated layout properties too and made a 221-chip
       filter feel mushy. Name the three that actually change. */
    transition: color var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease),
                background var(--dur-fast) var(--ease);
    display: inline-flex; align-items: center; gap: .4rem;
  }
  .chip:hover {
    border-color: var(--accent, var(--ink)); color: var(--ink);
    background: color-mix(in srgb, var(--accent, var(--ink)) 8%, transparent);
  }
  .chip__n { font-variant-numeric: tabular-nums; opacity: .5; }
  .chip.is-on {
    background: var(--accent, var(--ink)); border-color: var(--accent, var(--ink));
    color: var(--paper);
  }
  .chip.is-on .chip__n { opacity: .7; }
  .chip[data-cat='all'].is-on { background: var(--ink); border-color: var(--ink); }

  .controls__row { display: flex; gap: .5rem; flex-wrap: wrap; }
  .field { flex: 1 1 12rem; display: block; position: relative; }
  .field--sort { flex: 0 0 auto; }
  .field__icon {
    position: absolute; left: .7rem; top: 50%; transform: translateY(-50%);
    width: 14px; height: 14px; color: var(--ink-faint); pointer-events: none;
  }
  .field input, .field select {
    font: inherit; font-size: .875rem; width: 100%;
    padding: .55rem .8rem; border: 1px solid var(--border); border-radius: 10px;
    background: var(--card); color: var(--ink);
    transition: border-color var(--dur-fast) var(--ease),
                box-shadow var(--dur-fast) var(--ease);
  }
  .field input { padding-left: 2rem; }
  .field input:hover, .field select:hover { border-color: var(--ink-faint); }
  .field input:focus-visible, .field select:focus-visible {
    outline: none; border-color: var(--mizu);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--mizu) 18%, transparent);
  }

  .tally {
    margin: .65rem 0 0; font-size: .625rem; font-weight: 700;
    letter-spacing: .15em; text-transform: uppercase; color: var(--ink-faint);
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ---------- Day groups ---------- */
  .day {
    margin-bottom: 2.75rem;
    /* 33 groups / 221 cards — skip layout+paint for offscreen days.
       The placeholder MUST scale with the card count: a flat estimate made a
       21-card day claim the same height as a 2-card day, so the scroll position
       lurched every time a group actually rendered. --n is the card count;
       --card-h is the per-card height at this breakpoint. */
    --card-h: 16.5rem;
    content-visibility: auto;
    contain-intrinsic-size: auto calc(var(--n, 4) * var(--card-h) + 3.5rem);
  }
  @media (min-width: 768px) { .day { --card-h: 9rem; } }
  @media (min-width: 1100px) { .day { --card-h: 6.5rem; } }
  .day__label {
    display: flex; align-items: center; gap: .75rem;
    font-size: .625rem; font-weight: 800; letter-spacing: .15em;
    text-transform: uppercase; color: var(--ink-faint); margin: 0 0 1.1rem;
  }
  .day__dot { width: 5px; height: 5px; border-radius: 999px; background: var(--mizu); flex-shrink: 0; }
  .day__rule { flex: 1; height: 1px; background: var(--border); }
  .day__n { font-variant-numeric: tabular-nums; opacity: .7; }

  /* The UA's `[hidden]{display:none}` loses to any author `display` rule of
     equal specificity, so every element we hide via the hidden attribute has
     to opt out explicitly. Without this the filter sets hidden and nothing
     visibly changes. */
  .card[hidden],
  .day[hidden],
  .day__label[hidden] { display: none !important; }

  /* ---------- Cards ---------- */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: .9rem;
  }

  .card {
    position: relative; display: flex; flex-direction: column; overflow: hidden;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 16px; padding: 1.2rem 1.3rem 1.1rem;
    transition: transform var(--dur-fast) var(--ease),
                box-shadow var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease);
  }
  /* the tint bleeds in from the top-left corner, like ink on paper */
  .card::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(120% 90% at 0% 0%, var(--tint), transparent 62%);
    opacity: .85; pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease);
  }
  /* accent spine, grows on hover */
  .card::after {
    content: ''; position: absolute; left: 0; top: 1.2rem; bottom: 1.2rem;
    width: 3px; border-radius: 0 3px 3px 0; background: var(--accent);
    transform: scaleY(.32); transform-origin: top;
    transition: transform .55s var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 34px var(--shadow);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  .card:hover::after { transform: scaleY(1); }
  .card:hover::before { opacity: 1; }
  .card > * { position: relative; z-index: 1; }

  .card__top {
    display: flex; align-items: center; justify-content: space-between;
    gap: .75rem; margin-bottom: .75rem;
  }
  .tag {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .5625rem; font-weight: 800; letter-spacing: .12em;
    text-transform: uppercase; color: var(--accent);
  }
  .tag__dot { width: 5px; height: 5px; border-radius: 999px; background: var(--accent); }
  .card__date {
    font-size: .5625rem; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .card__h {
    font-size: 1.02rem; font-weight: 800; line-height: 1.32;
    letter-spacing: -.012em; margin: 0 0 .55rem; color: var(--ink);
    text-wrap: balance;
  }
  .card__sum {
    font-size: .8125rem; line-height: 1.62; color: var(--ink-soft); margin: 0 0 1rem;
  }

  /* the angle is the product — give it a seal-stamp treatment */
  .card__angle {
    margin-top: auto; padding: .75rem .85rem;
    background: color-mix(in srgb, var(--paper) 62%, transparent);
    border: 1px solid var(--border-soft);
    border-left: 2px solid var(--accent);
    border-radius: 0 10px 10px 0;
  }
  .card__angle-k {
    display: block; font-size: .5rem; font-weight: 800; letter-spacing: .18em;
    text-transform: uppercase; color: var(--accent); margin-bottom: .35rem;
  }
  .card__angle p {
    margin: 0; font-size: .8125rem; line-height: 1.55;
    font-weight: 500; color: var(--ink);
  }

  .card__src {
    display: inline-flex; align-items: center; gap: .3rem; margin-top: .85rem;
    font-size: .5625rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink-faint); text-decoration: none; align-self: flex-start;
    transition: color .25s; max-width: 100%;
  }
  .card__src span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .card__src svg { width: 10px; height: 10px; flex-shrink: 0; transition: transform .25s; }
  .card__src:hover { color: var(--accent); }
  .card__src:hover svg { transform: translate(2px, -2px); }

  .noresults { padding: 3rem 0; color: var(--ink-soft); font-size: .9375rem; }
  .noresults button {
    font: inherit; background: none; border: 0;
    border-bottom: 1.5px solid var(--mizu); color: var(--ink); cursor: pointer; padding: 0;
  }

  @media (max-width: 640px) {
    .controls { top: var(--nav-h, 3.2rem); padding-top: .75rem; }
    .cards { grid-template-columns: 1fr; }
    .day__label { gap: .5rem; }
    .field--sort { flex: 1 1 100%; }

    /* touch targets: 25px chips fail the 44px minimum on a phone */
    .chips {
      gap: .4rem;
      display: flex; flex-wrap: nowrap; overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter);
      /* The scrollbar is hidden, so nothing signalled that six categories
         continue past the edge. Fade the trailing edge instead — and let the
         mask fall away once you reach the end, so it reads as an affordance
         rather than as decoration. */
      -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
      mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
      transition: -webkit-mask-image var(--dur-fast) var(--ease),
                  mask-image var(--dur-fast) var(--ease);
    }
    .chips[data-scroll-end] {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .chips::-webkit-scrollbar { display: none; }
    .chip {
      min-height: 44px; padding: .5rem .9rem;
      flex: 0 0 auto; scroll-snap-align: start;
    }
    .field input, .field select { min-height: 44px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .card::after { transform: scaleY(1); }
  }
</style>

<script>
  const archive = document.getElementById('archive')!;
  const q = document.getElementById('q') as HTMLInputElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const tally = document.getElementById('tally')!;
  const noresults = document.getElementById('noresults')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const days = [...archive.querySelectorAll<HTMLElement>('.day')];
  const cards = [...archive.querySelectorAll<HTMLElement>('.card')];

  // Drop the trailing fade on the chip strip once it is scrolled to the end,
  // so the hint disappears when there is nothing left to hint at. Mobile only —
  // above 640px the strip wraps and never scrolls.
  const chipStrip = document.querySelector<HTMLElement>('.chips');
  if (chipStrip) {
    const syncFade = () => {
      const atEnd = chipStrip.scrollLeft + chipStrip.clientWidth >= chipStrip.scrollWidth - 2;
      chipStrip.toggleAttribute('data-scroll-end', atEnd);
    };
    chipStrip.addEventListener('scroll', syncFade, { passive: true });
    window.addEventListener('resize', syncFade);
    syncFade();
  }

  let cat = 'all';

  const apply = () => {
    const term = q.value.trim().toLowerCase();
    let shown = 0;

    for (const card of cards) {
      const okCat = cat === 'all' || card.dataset.cat === cat;
      const okTerm = !term || (card.dataset.text ?? '').includes(term);
      const show = okCat && okTerm;
      card.hidden = !show;
      if (show) shown++;
    }

    for (const day of days) {
      const any = [...day.querySelectorAll<HTMLElement>('.card')].some((c) => !c.hidden);
      day.hidden = !any;
    }

    const grouped = sort.value === 'cat' || sort.value === 'az';
    for (const day of days) {
      day.querySelector('.day__label')!.toggleAttribute('hidden', grouped);
    }

    tally.textContent = `Showing ${shown} of ${cards.length}`;
    noresults.hidden = shown > 0;
  };

  const reorder = () => {
    const mode = sort.value;

    if (mode === 'new' || mode === 'old') {
      // put every card back in its own day, then order the days
      for (const day of days) {
        const grid = day.querySelector('.cards')!;
        cards
          .filter((c) => c.dataset.date === day.dataset.date)
          .forEach((c) => grid.appendChild(c));
      }
      [...days]
        .sort((a, b) =>
          mode === 'new'
            ? b.dataset.date!.localeCompare(a.dataset.date!)
            : a.dataset.date!.localeCompare(b.dataset.date!)
        )
        .forEach((d) => archive.appendChild(d));
      return;
    }

    // flatten into the first day's grid for a continuous sorted run
    const first = days[0];
    const grid = first.querySelector('.cards')!;
    [...cards]
      .sort((a, b) =>
        mode === 'cat'
          ? a.dataset.cat!.localeCompare(b.dataset.cat!) ||
            b.dataset.date!.localeCompare(a.dataset.date!)
          : a.dataset.headline!.localeCompare(b.dataset.headline!)
      )
      .forEach((c) => grid.appendChild(c));
    archive.prepend(first);
  };

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      cat = chip.dataset.cat!;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-pressed', String(on));
      });
      apply();
    })
  );

  q.addEventListener('input', apply);
  sort.addEventListener('change', () => {
    reorder();
    apply();
  });
  document.getElementById('reset')!.addEventListener('click', () => {
    q.value = '';
    chips[0].click();
  });

  apply();
</script>
